# Copiar este archivo a `.env` y llenar con valores reales.
# Ver docs/DEPLOYMENT.md para el detalle de cada variable.

# ─── Supabase ─────────────────────────────────────────────────────
# Requeridas por los tres clientes de Supabase (browser + server).
# El proyecto del club es `hzewxtimkbxljozyrafk` — reemplaza si usas otro.
PUBLIC_SUPABASE_URL=https://hzewxtimkbxljozyrafk.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Solo servidor. Bypasa RLS. Se usa en /api/cron/*.
# NUNCA la expongas al cliente ni la commitees.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Resend ───────────────────────────────────────────────────────
# Correos transaccionales (rechazo de evidencia, notificaciones).
# Requerida en producción; en dev puede quedar vacía si no vas a probar
# el envío real.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Vercel Cron ──────────────────────────────────────────────────
# Autoriza /api/cron/*. Genera un secreto largo random (openssl rand -hex 32)
# y ponlo en Vercel → Settings → Environment Variables.
# Se envía como `Authorization: Bearer <token>` o `?token=<token>`.
CRON_SECRET=cambia-esto-por-un-secreto-largo-random
