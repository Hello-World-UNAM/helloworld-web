---
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Directorio de Miembros | Admin" activeNav="miembros">

  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-title">
        <span class="admin-title-icon"><i class="bi bi-people-fill"></i></span>
        Directorio de miembros
      </h1>
      <p class="admin-page-subtitle">Gestiona la información de todos los miembros activos del club.</p>
    </div>
    <div class="admin-page-actions">
      <button id="btn-add-member" class="admin-btn admin-btn-purple">
        <i class="bi bi-person-plus-fill"></i> Añadir miembro
      </button>
    </div>
  </div>

  <!-- Search -->
  <div class="admin-search-wrap" style="margin-bottom: 24px;">
    <i class="bi bi-search admin-search-icon"></i>
    <input type="text" id="search-input" class="admin-search" placeholder="Buscar por nombre, correo o cuenta..." autocomplete="off">
  </div>

  <!-- Table Container -->
  <div class="admin-table-wrap">
    <table class="admin-table admin-table-cards">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>No. Cuenta</th>
          <th>Correo</th>
          <th>Cargo</th>
          <th>Semestre</th>
          <th class="admin-th-actions"></th>
        </tr>
      </thead>
      <tbody id="members-tbody">
        <tr><td colspan="6" class="admin-empty"><i class="bi bi-arrow-clockwise admin-redirect-spin" style="font-size: 1.6rem;"></i></td></tr>
      </tbody>
    </table>
  </div>

  <!-- Modal/Form for Add/Edit -->
  <div id="member-modal" class="admin-modal">
    <div class="admin-modal-card" style="max-width: 600px;">
      <button id="btn-close-modal" class="admin-modal-close" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
      <h2 id="modal-title" class="admin-modal-title" style="margin-bottom: 1.4rem;">Añadir Miembro</h2>

      <form id="member-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
        <input type="hidden" id="member-id">

        <div class="admin-modal-field">
          <label for="input-nombre">Nombre completo <span class="sel-req">*</span></label>
          <input type="text" id="input-nombre" class="admin-text-input" required>
        </div>

        <div class="sel-form-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem;">
          <div class="admin-modal-field">
            <label for="input-cuenta">No. de cuenta <span class="sel-req">*</span></label>
            <input type="text" id="input-cuenta" class="admin-text-input" required>
          </div>
          <div class="admin-modal-field">
            <label for="input-semestre">Semestre</label>
            <input type="number" id="input-semestre" class="admin-text-input" min="1" max="15" value="7">
          </div>
        </div>

        <div class="admin-modal-field">
          <label for="input-correo">Correo institucional <span class="sel-req">*</span></label>
          <input type="email" id="input-correo" class="admin-text-input" required>
        </div>

        <div class="sel-form-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem;">
          <div class="admin-modal-field">
            <label for="input-telefono">Teléfono</label>
            <input type="text" id="input-telefono" class="admin-text-input">
          </div>
          <div class="admin-modal-field">
            <label for="input-cargo">Cargo / Rol</label>
            <select id="input-cargo" class="admin-select admin-select-block">
              <option value="member">Miembro</option>
              <option value="admin">Mesa directiva</option>
            </select>
          </div>
        </div>

        <button type="submit" id="btn-save" class="admin-btn admin-btn-purple" style="margin-top: 0.6rem; width: 100%; padding: 14px; font-size: 1rem;">
          Guardar Miembro
        </button>
      </form>
    </div>
  </div>

</AdminLayout>

<script>
  import { supabase } from '@lib/supabase';

  let allMembers: any[] = [];

  const tbody = document.getElementById('members-tbody')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;

  // Modal Elements
  const modal = document.getElementById('member-modal')!;
  const btnAdd = document.getElementById('btn-add-member')!;
  const btnClose = document.getElementById('btn-close-modal')!;
  const form = document.getElementById('member-form') as HTMLFormElement;
  const modalTitle = document.getElementById('modal-title')!;

  // Inputs
  const inputId = document.getElementById('member-id') as HTMLInputElement;
  const inputNombre = document.getElementById('input-nombre') as HTMLInputElement;
  const inputCuenta = document.getElementById('input-cuenta') as HTMLInputElement;
  const inputSemestre = document.getElementById('input-semestre') as HTMLInputElement;
  const inputCorreo = document.getElementById('input-correo') as HTMLInputElement;
  const inputTelefono = document.getElementById('input-telefono') as HTMLInputElement;
  const inputCargo = document.getElementById('input-cargo') as HTMLInputElement;
  const btnSave = document.getElementById('btn-save') as HTMLButtonElement;

  async function loadMembers() {
    const { data, error } = await supabase
      .from('miembros_activos')
      .select('*')
      .order('nombre', { ascending: true });

    if (error) {
      console.error(error);
      alert('Error cargando miembros');
      return;
    }

    allMembers = data || [];
    renderTable(allMembers);
  }

  function renderTable(members: any[]) {
    if (members.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="admin-empty">No hay miembros registrados.</td></tr>`;
      return;
    }

    const admins = members.filter(m => m.rol === 'admin' || m.cargo === 'Mesa directiva');
    const regulars = members.filter(m => m.rol !== 'admin' && m.cargo !== 'Mesa directiva');

    const renderRow = (m: any) => {
      const isAdmin = m.rol === 'admin';
      return `
        <tr>
          <td data-label="Nombre">
            <div class="admin-row-name">${m.nombre}</div>
          </td>
          <td data-label="Cuenta" class="admin-cell-mono">${m.numero_cuenta || 'N/A'}</td>
          <td data-label="Correo" style="word-break: break-word;">${m.correo}</td>
          <td data-label="Cargo">
            <span class="admin-role-pill ${isAdmin ? 'admin-role-pill-admin' : ''}">${isAdmin ? 'Mesa directiva' : 'Miembro'}</span>
          </td>
          <td data-label="Semestre">${m.semestre ? m.semestre + 'mo' : 'N/A'}</td>
          <td class="admin-th-actions admin-td-actions" style="text-align: right; white-space: nowrap;">
            <button class="btn-edit admin-icon-btn" data-id="${m.id}" title="Editar" aria-label="Editar a ${m.nombre}"><i class="bi bi-pencil-square"></i></button>
            <button class="btn-delete admin-icon-btn admin-icon-btn-danger" data-id="${m.id}" data-name="${m.nombre}" title="Eliminar" aria-label="Eliminar a ${m.nombre}"><i class="bi bi-trash-fill"></i></button>
          </td>
        </tr>
      `;
    };

    let html = '';

    if (admins.length > 0) {
      html += `<tr class="admin-table-group"><td colspan="6"><i class="bi bi-star-fill"></i> Mesa Directiva</td></tr>`;
      html += admins.map(renderRow).join('');
    }

    if (regulars.length > 0) {
      html += `<tr class="admin-table-group"><td colspan="6"><i class="bi bi-people-fill"></i> Miembros Generales</td></tr>`;
      html += regulars.map(renderRow).join('');
    }

    tbody.innerHTML = html;

    // Attach Edit Listeners
    document.querySelectorAll('.btn-edit').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        openEditModal(id!);
      });
    });

    // Attach Delete Listeners
    document.querySelectorAll('.btn-delete').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
        const name = (e.currentTarget as HTMLElement).getAttribute('data-name')!;
        if (confirm(`¿Estás SEGURO de querer eliminar a "${name}"?\n\nESTO BORRARÁ TODO SU HISTORIAL DE PUNTOS PERMANENTEMENTE.`)) {
          await deleteMember(id);
        }
      });
    });
  }

  // Search filter
  searchInput.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase();
    const filtered = allMembers.filter(m =>
      m.nombre?.toLowerCase().includes(q) ||
      m.correo?.toLowerCase().includes(q) ||
      m.numero_cuenta?.includes(q)
    );
    renderTable(filtered);
  });

  // Modal Logic
  function openAddModal() {
    form.reset();
    inputId.value = '';
    modalTitle.textContent = 'Añadir Miembro';
    inputSemestre.value = '7'; // default
    inputCargo.value = 'member';
    modal.style.display = 'flex';
  }

  function openEditModal(id: string) {
    const m = allMembers.find(x => x.id === id);
    if (!m) return;

    form.reset();
    inputId.value = m.id;
    inputNombre.value = m.nombre || '';
    inputCuenta.value = m.numero_cuenta || '';
    inputCorreo.value = m.correo || '';
    inputTelefono.value = m.telefono || '';
    inputSemestre.value = m.semestre || '7';

    if (m.rol === 'admin' || m.cargo === 'Mesa directiva') {
      inputCargo.value = 'admin';
    } else {
      inputCargo.value = 'member';
    }

    modalTitle.textContent = 'Editar Miembro';
    modal.style.display = 'flex';
  }

  function closeModal() {
    modal.style.display = 'none';
  }

  inputCargo.addEventListener('change', (e) => {
    if ((e.target as HTMLSelectElement).value === 'admin') {
      const confirmed = confirm('ATENCIÓN: Al darle permisos de Mesa Directiva, este usuario obtendrá acceso total al panel de administración del club y formará parte de la whitelist automáticamente. \n\n¿Deseas continuar?');
      if (!confirmed) {
        inputCargo.value = 'member';
      }
    }
  });

  btnAdd.addEventListener('click', openAddModal);
  btnClose.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btnSave.disabled = true;
    btnSave.textContent = 'Guardando...';

    const payload = {
      nombre: inputNombre.value.trim(),
      numero_cuenta: inputCuenta.value.trim(),
      correo: inputCorreo.value.trim(),
      telefono: inputTelefono.value.trim(),
      semestre: parseInt(inputSemestre.value) || 7,
      rol: inputCargo.value.trim()
    };

    const id = inputId.value;

    let error;
    if (id) {
      // Update
      const { error: updErr } = await supabase.from('miembros_activos').update(payload).eq('id', id);
      error = updErr;
    } else {
      // Insert
      const { error: insErr } = await supabase.from('miembros_activos').insert(payload);
      error = insErr;
    }

    if (error) {
      console.error(error);
      alert('Error al guardar: ' + error.message);
    } else {
      closeModal();
      await loadMembers();
      searchInput.value = ''; // clear search on save
    }

    btnSave.disabled = false;
    btnSave.textContent = 'Guardar Miembro';
  });

  async function deleteMember(id: string) {
    // Delete from DB. CASCADE handles puntos_registros.
    const { error } = await supabase.from('miembros_activos').delete().eq('id', id);
    if (error) {
      alert('Error eliminando miembro: ' + error.message);
    } else {
      await loadMembers();
    }
  }

  document.addEventListener('DOMContentLoaded', loadMembers);
</script>

<style>
  @media (max-width: 600px) {
    .sel-form-grid-2 {
      grid-template-columns: 1fr !important;
    }
  }
</style>
