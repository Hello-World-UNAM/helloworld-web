---
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Entrevistas · Panel Hello World" activeNav="entrevistas">
  <section class="admin-interviews">

    <div id="entrevistas-loading" class="admin-redirect">
      <i class="bi bi-arrow-clockwise admin-redirect-spin"></i>
      <p>Cargando…</p>
    </div>

    <div id="entrevistas-content" style="display:none;">

      <div class="admin-list-header">
        <div>
          <h1>Entrevistas</h1>
          <p class="admin-list-subtitle">Temporada <strong id="active-season">—</strong></p>
        </div>
        <div class="admin-list-header-actions">
          <a href="/admin/solicitudes?view=1" class="admin-action-btn">
            <i class="bi bi-list-ul"></i> Ver solicitudes
          </a>
          <a href="/admin/seleccion-config" class="admin-action-btn">
            <i class="bi bi-gear-fill"></i> Configurar
          </a>
          <button id="final-select-all" type="button" class="admin-action-btn admin-select-all-btn" style="display:none;" aria-pressed="false" disabled>
            <i class="bi bi-check2-square"></i> Seleccionar todos
          </button>
          <button id="btn-bulk-final" type="button" class="admin-action-btn admin-action-btn-primary" disabled>
            <i class="bi bi-send-fill"></i> Comunicar listos
          </button>
        </div>
      </div>

      <div class="selection-filter-bar">
      <!-- Stats: estado entrevistas + decisión final -->
      <div id="entrevistas-stats" class="admin-stats admin-stats-extended selection-summary-stats">
        <button type="button" class="admin-stat admin-stat-active" data-evaluation="all" aria-pressed="true">
          <span class="admin-stat-num" id="stat-total">0</span>
          <span class="admin-stat-label">Total</span>
        </button>
        <button type="button" class="admin-stat" data-evaluation="evaluated" aria-pressed="false">
          <span class="admin-stat-num" id="stat-evaluated">0</span>
          <span class="admin-stat-label">Evaluados</span>
        </button>
        <button type="button" class="admin-stat" data-evaluation="accepted" aria-pressed="false">
          <span class="admin-stat-num" id="stat-accepted-final">0</span>
          <span class="admin-stat-label">Aceptados</span>
        </button>
        <button type="button" class="admin-stat" data-evaluation="rejected" aria-pressed="false">
          <span class="admin-stat-num" id="stat-rejected-final">0</span>
          <span class="admin-stat-label">Rechazados</span>
        </button>
        <button type="button" class="admin-stat" data-evaluation="pending" aria-pressed="false">
          <span class="admin-stat-num" id="stat-pending">0</span>
          <span class="admin-stat-label">Sin evaluar</span>
        </button>
      </div>

      <section id="final-comms-summary" class="selection-comms-summary" style="display:none;" aria-label="Estado del correo de resultado final">
        <label for="final-comms-filter">Correo final:</label>
        <select id="final-comms-filter" class="admin-select">
          <option id="final-comms-count-all" value="all">Todos</option>
          <option id="final-comms-count-free" value="free">Sin enviar</option>
          <option id="final-comms-count-queued" value="queued">En cola / en proceso</option>
          <option id="final-comms-count-sent" value="sent">Enviados</option>
          <option id="final-comms-count-problem" value="problem">Revisar envío</option>
        </select>
        <p id="final-comms-hint" class="selection-comms-hint" aria-live="polite" hidden></p>
      </section>
      </div>

      <div class="admin-search-wrap">
        <i class="bi bi-search admin-search-icon" aria-hidden="true"></i>
        <input
          type="search"
          id="admin-search"
          class="admin-search"
          placeholder="Buscar por nombre, correo o carrera…"
          aria-label="Buscar por nombre, correo o carrera"
          aria-describedby="interview-search-summary"
          autocomplete="off"
        >
      </div>
      <p id="interview-search-summary" class="admin-table-foot" role="status" hidden></p>

      <div id="final-selection-guide" class="admin-final-selection-guide" style="display:none;" aria-live="polite">
        <i class="bi bi-check2-square"></i>
        <span id="final-selection-guide-text"></span>
        <strong id="final-selection-count">0 seleccionados</strong>
      </div>
      <div id="member-provisioning-alert" class="admin-final-selection-guide" style="display:none;" role="status"></div>
      <div id="interview-search-empty" class="admin-empty" hidden>
        No hay coincidencias. Prueba con otro nombre, correo o carrera.
      </div>

      <!-- Periodo de agendado (antes del deadline) -->
      <div id="booking-phase-section" style="display:none;">
        <div id="booking-phase-banner"></div>
        <div id="booking-with-interview"></div>
        <div id="booking-without-interview"></div>
      </div>

      <!-- Agenda por día (post-deadline) -->
      <div id="agenda-by-day" class="admin-agenda-days"></div>

      <!-- Solicitudes accepted sin entrevista -->
      <section id="no-interview-section" style="display:none;" class="admin-agenda-day">
        <h2 class="admin-agenda-day-header admin-agenda-day-header-warning">
          <i class="bi bi-exclamation-circle"></i> Sin entrevista agendada
          <span class="admin-agenda-day-count" id="no-interview-count">0</span>
        </h2>
        <p class="admin-no-interview-hint">
          Estos candidatos ya fueron invitados pero no han agendado entrevista. Requieren decisión manual.
        </p>
        <div class="admin-agenda-list" id="no-interview-list"></div>
      </section>

    </div>

  </section>
</AdminLayout>

<style>
  .admin-interviews :global([hidden]) {
    display: none !important;
  }
</style>

<script>
  import { supabase } from '@lib/supabase';
  import { formatDayLong } from '@lib/interview-slots';
  import { isSelectionLab } from '@lib/selection-lab';
  import {
    commsOccupancyLabel,
    confirmSelectionCommunication,
    getSelectionFeatureMode,
    getSelectionState,
    previewSelectionCommunication,
    selectionAdmin,
    selectionErrorMessage,
    selectionLabCompleteInterview,
    stageCommsOccupancy,
    type SelectionRoom,
    type SelectionMessage,
    type SelectionSolicitud,
  } from '@lib/selection-client';

  type SolicitudWithEval = {
    id: string;
    nombre: string;
    correo: string;
    email_notification_sent: boolean;
    carrera: string;
    semestre: number;
    final_decision: 'accepted' | 'rejected' | null;
    final_email_sent: boolean;
    evaluated_at: string | null;
    selection_revision: number;
    decision_exception_reason: string | null;
  };

  type InterviewRow = {
    id: string;
    solicitud_id: string;
    room_id?: string | null;
    calendar_status?: string;
    slot_datetime: string;
    duration_minutes: number;
    meet_url: string | null;
    status: 'confirmed' | 'cancelled' | 'completed' | 'no_show';
    notes: string | null;
    solicitudes: SolicitudWithEval | null;
  };

  const STATUS_LABELS: Record<string, string> = {
    confirmed: 'Confirmada',
    completed: 'Completada',
    no_show: 'No show',
    cancelled: 'Cancelada',
  };

  let activeSeason = '';
  let progressiveEnabled = false;
  let stateMessages: SelectionMessage[] = [];
  let interviewRooms = new Map<string, SelectionRoom>();
  type MemberProvisioning = { status: string; detail: string | null; member_id: string | null };
  let memberProvisioning = new Map<string, MemberProvisioning>();
  let memberProvisioningUnavailable = false;
  let visibleSolicitudes: SolicitudWithEval[] = [];
  let finalInterviewStatuses = new Map<string, InterviewRow['status']>();
  const selectedFinalIds = new Set<string>();
  let searchTerms: string[] = [];
  let evaluationFilter: 'all' | 'evaluated' | 'accepted' | 'rejected' | 'pending' = 'all';
  let finalMailFilter: 'all' | 'free' | 'queued' | 'sent' | 'problem' = 'all';

  function normalizeSearch(value: string): string {
    return value.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
  }

  function matchesSearch(row: SolicitudWithEval): boolean {
    const text = normalizeSearch(`${row.nombre} ${row.correo} ${row.carrera}`);
    return searchTerms.every((term) => text.includes(term)) &&
      matchesEvaluation(row) &&
      (finalMailFilter === 'all' || (!!row.final_decision && finalMailBucket(row) === finalMailFilter));
  }

  function matchesEvaluation(row: SolicitudWithEval): boolean {
    if (evaluationFilter === 'all') return true;
    if (evaluationFilter === 'evaluated') return !!row.final_decision;
    if (evaluationFilter === 'pending') return !row.final_decision;
    return row.final_decision === evaluationFilter;
  }

  function applyInterviewSearch() {
    const filtering = searchTerms.length > 0 || finalMailFilter !== 'all' || evaluationFilter !== 'all';
    const matchingIds = new Set(visibleSolicitudes.filter(matchesSearch).map((row) => row.id));
    const shownIds = new Set<string>();
    document.querySelectorAll<HTMLElement>('.admin-interviews .admin-agenda-item').forEach((item) => {
      const id = item.dataset.solicitudId ?? '';
      item.hidden = !matchingIds.has(id);
      if (!item.hidden) shownIds.add(id);
    });
    document.querySelectorAll<HTMLElement>('.admin-interviews .admin-agenda-day').forEach((section) => {
      const count = section.querySelectorAll('.admin-agenda-item:not([hidden])').length;
      section.hidden = filtering && count === 0;
      const badge = section.querySelector('.admin-agenda-day-count');
      if (badge) badge.textContent = String(count);
    });
    const agenda = document.getElementById('agenda-by-day')!;
    agenda.hidden = filtering && !agenda.querySelector('.admin-agenda-item:not([hidden])');
    const summary = document.getElementById('interview-search-summary')!;
    summary.hidden = !filtering;
    summary.textContent = `${shownIds.size} persona${shownIds.size === 1 ? '' : 's'} encontrada${shownIds.size === 1 ? '' : 's'}.`;
    document.getElementById('interview-search-empty')!.hidden = !filtering || shownIds.size > 0;
    if (progressiveEnabled) {
      refreshFinalSelection(visibleSolicitudes, visibleSolicitudes.filter((row) => !row.final_decision).length);
    }
  }

  document.addEventListener('DOMContentLoaded', async () => {
    const search = document.getElementById('admin-search') as HTMLInputElement;
    search.addEventListener('input', () => {
      searchTerms = normalizeSearch(search.value).split(/\s+/).filter(Boolean);
      applyInterviewSearch();
    });
    document.querySelectorAll<HTMLButtonElement>('[data-evaluation]').forEach(button => {
      button.addEventListener('click', () => {
        evaluationFilter = button.dataset.evaluation as typeof evaluationFilter;
        document.querySelectorAll<HTMLButtonElement>('[data-evaluation]').forEach(item => {
          const active = item === button;
          item.classList.toggle('admin-stat-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        applyInterviewSearch();
      });
    });
    document.getElementById('final-comms-filter')!.addEventListener('change', event => {
      finalMailFilter = (event.target as HTMLSelectElement).value as typeof finalMailFilter;
      applyInterviewSearch();
    });
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user?.email) { window.location.replace('/admin/login'); return; }
    const { data: directiva } = await supabase
      .from('directiva').select('email').eq('email', session.user.email.toLowerCase()).maybeSingle();
    if (!directiva) {
      await supabase.auth.signOut();
      window.location.replace('/admin/login');
      return;
    }

    const feature = await getSelectionFeatureMode();
    if (feature.mode === 'unavailable') {
      document.getElementById('entrevistas-loading')!.innerHTML =
        '<p class="admin-empty admin-empty-error">No se pudo verificar el backend de selecciones.</p>';
      return;
    }
    progressiveEnabled = feature.mode === 'progressive';
    if (progressiveEnabled && feature.state) {
      stateMessages = feature.state.messages ?? [];
      activeSeason = String(feature.state.config.active_season ?? '');
      await loadMemberProvisioning(activeSeason);
      document.getElementById('active-season')!.textContent = activeSeason || '—';
      document.getElementById('entrevistas-loading')!.style.display = 'none';
      document.getElementById('entrevistas-content')!.style.display = 'block';
      const accepted = feature.state.solicitudes
        .filter((row) => row.status === 'accepted') as unknown as SolicitudWithEval[];
      const interviewIds = new Set(feature.state.interviews.map((interview) => interview.solicitud_id));
      // Un token se crea al confirmar el lote, pero sólo representa una
      // invitación utilizable después de que el worker lo haya enviado y
      // asentado (`invited_at`). Un aceptado aún no notificado permanece en
      // Solicitudes; una entrevista existente siempre conserva visibilidad.
      const invitedIds = new Set(
        (feature.state.invitations ?? [])
          .filter((invitation) => invitation.revoked_at == null && invitation.invited_at != null)
          .map((invitation) => invitation.solicitud_id),
      );
      const visibleIds = new Set([...invitedIds, ...interviewIds]);
      const sols = accepted.filter((row) => visibleIds.has(row.id));
      visibleSolicitudes = sols;
      const byId = new Map(sols.map((row) => [row.id, row]));
      interviewRooms = new Map((feature.state.rooms ?? []).map(room => [room.id, room]));
      const ivs = feature.state.interviews.map((interview) => ({
        ...interview,
        solicitudes: byId.get(interview.solicitud_id) ?? null,
      })).filter((interview) => interview.solicitudes) as unknown as InterviewRow[];
      renderStats(sols);
      renderAgenda(ivs);
      renderNoInterview(sols, ivs, invitedIds);
      setupBulkBtn(sols);
      applyInterviewSearch();
      return;
    }

    const { data: config } = await supabase
      .from('seleccion_config').select('active_season, interview_deadline_at').eq('id', true).maybeSingle();
    activeSeason = config?.active_season || '';
    document.getElementById('active-season')!.textContent = activeSeason || '—';
    const interviewDeadline = config?.interview_deadline_at ? new Date(config.interview_deadline_at) : null;

    if (!activeSeason) {
      document.getElementById('entrevistas-loading')!.innerHTML =
        '<p>Sin temporada activa. Abre una desde <a href="/admin/seleccion-config">configuración</a>.</p>';
      return;
    }

    // Todas las solicitudes que pasaron forms en esta temporada
    const { data: solicitudes, error: solErr } = await supabase
      .from('solicitudes')
      .select('id, nombre, correo, carrera, semestre, email_notification_sent, final_decision, final_email_sent, evaluated_at')
      .eq('season', activeSeason)
      .eq('status', 'accepted');

    // Entrevistas con join a la solicitud
    const { data: interviews, error: ivErr } = await supabase
      .from('interviews')
      .select(`
        id, solicitud_id, slot_datetime, duration_minutes, meet_url, status, notes,
        solicitudes!inner ( id, nombre, correo, carrera, semestre, final_decision, final_email_sent, evaluated_at, season )
      `)
      .eq('solicitudes.season', activeSeason)
      .order('slot_datetime', { ascending: true });

    document.getElementById('entrevistas-loading')!.style.display = 'none';
    document.getElementById('entrevistas-content')!.style.display = 'block';

    if (solErr || ivErr) {
      document.getElementById('agenda-by-day')!.innerHTML =
        `<div class="admin-empty admin-empty-error">Error: ${solErr?.message || ivErr?.message}</div>`;
      return;
    }

    const sols = (solicitudes || []) as SolicitudWithEval[];
    const ivs = (interviews || []) as unknown as InterviewRow[];
    visibleSolicitudes = sols;

    const deadlinePassed = !interviewDeadline || Date.now() >= interviewDeadline.getTime();

    if (deadlinePassed) {
      renderStats(sols);
      renderAgenda(ivs);
      // En legacy, "invitado" = el bulk ya le envió la decisión inicial.
      renderNoInterview(sols, ivs, new Set(sols.filter((s) => s.email_notification_sent).map((s) => s.id)));
      setupBulkBtn(sols);
    } else {
      renderBookingPhase(sols, ivs, interviewDeadline!);
    }
    applyInterviewSearch();
  });

  async function loadMemberProvisioning(season: string) {
    const alertBox = document.getElementById('member-provisioning-alert')!;
    const { data, error } = await supabase.rpc('selection_member_status', { p_season: season });
    memberProvisioningUnavailable = !!error;
    if (error) {
      alertBox.textContent = 'No se pudo consultar el alta de miembros. Revisa los registros antes de darla por completada.';
      alertBox.style.display = 'flex';
      return;
    }
    memberProvisioning = new Map((data ?? []).map((row) => [row.solicitud_id, row]));
    const pending = (data ?? []).filter((row) => ['conflict', 'error', 'review_required'].includes(row.status));
    if (pending.length) {
      alertBox.textContent = `${pending.length} alta(s) de miembros requieren revisión. Abre el resultado de cada persona y revisa /admin/miembros.`;
      alertBox.style.display = 'flex';
    }
  }

  function renderBookingPhase(sols: SolicitudWithEval[], ivs: InterviewRow[], deadline: Date) {
    // Ocultar stats de evaluación (no aplican aún) y agenda post-deadline
    document.getElementById('entrevistas-stats')!.style.display = 'none';
    document.getElementById('booking-phase-section')!.style.display = '';

    // Bulk btn: no disponible hasta post-deadline
    const btn = document.getElementById('btn-bulk-final') as HTMLButtonElement;
    btn.disabled = true;
    btn.innerHTML = `<i class="bi bi-hourglass-split"></i> Esperando fin de agendado`;
    btn.title = 'Disponible una vez que pase la fecha límite de agendado';

    const scheduledIds = new Set(ivs.filter(i => i.status !== 'cancelled').map(i => i.solicitud_id));
    const withList  = sols.filter(s => scheduledIds.has(s.id));
    // Pendiente = invitado (bulk enviado) pero sin entrevista vigente.
    // Un aceptado aún no notificado no aparece aquí: sigue en Solicitudes.
    const noList    = sols.filter(s => s.email_notification_sent && !scheduledIds.has(s.id));

    const deadlineFormatted = deadline.toLocaleDateString('es-MX', {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
      hour: '2-digit', minute: '2-digit', timeZone: 'America/Mexico_City',
    });

    document.getElementById('booking-phase-banner')!.innerHTML = `
      <div class="admin-booking-banner">
        <div class="admin-booking-banner-text">
          <i class="bi bi-hourglass-split"></i>
          <span>Periodo de agendado activo — los candidatos tienen hasta el <strong>${deadlineFormatted}</strong> para elegir su horario.</span>
        </div>
        <div class="admin-booking-banner-counts">
          <span class="admin-booking-count admin-booking-count-done"><i class="bi bi-check2"></i> ${withList.length} agendados</span>
          <span class="admin-booking-count admin-booking-count-pending"><i class="bi bi-hourglass"></i> ${noList.length} pendientes</span>
        </div>
      </div>`;

    document.getElementById('booking-with-interview')!.innerHTML = `
      <section class="admin-agenda-day" style="margin-top:20px;">
        <h2 class="admin-agenda-day-header">
          <i class="bi bi-check2-circle"></i> Con entrevista agendada
          <span class="admin-agenda-day-count">${withList.length}</span>
        </h2>
        <div class="admin-agenda-list">
          ${withList.length === 0
            ? '<div class="admin-empty">Ningún candidato ha agendado aún.</div>'
            : withList.map(s => {
                const iv = ivs.find(i => i.solicitud_id === s.id && i.status !== 'cancelled');
                const time = iv ? formatTime(iv.slot_datetime) : '—';
                const meet = iv?.meet_url
                  ? `<a href="${escapeAttr(iv.meet_url)}" target="_blank" rel="noopener noreferrer" class="admin-agenda-meet" title="Abrir Meet"><i class="bi bi-camera-video-fill"></i></a>`
                  : '';
                return `<article class="admin-agenda-item" data-solicitud-id="${escapeAttr(s.id)}">
                  <div class="admin-agenda-time">${time}</div>
                  <div class="admin-agenda-info">
                    <div class="admin-agenda-name">${escapeHtml(s.nombre)}</div>
                    <div class="admin-agenda-sub">${escapeHtml(s.carrera)} · ${s.semestre}° sem</div>
                  </div>
                  <div class="admin-agenda-actions">${meet}</div>
                </article>`;
              }).join('')}
        </div>
      </section>`;

    document.getElementById('booking-without-interview')!.innerHTML = `
      <section class="admin-agenda-day" style="margin-top:16px;">
        <h2 class="admin-agenda-day-header">
          <i class="bi bi-hourglass"></i> Pendiente de agendar
          <span class="admin-agenda-day-count">${noList.length}</span>
        </h2>
        ${noList.length === 0
          ? '<p class="admin-no-interview-hint">Todos han agendado su entrevista.</p>'
          : `<p class="admin-no-interview-hint">Aún no han elegido horario. Tienen hasta el deadline para hacerlo.</p>
             <div class="admin-agenda-list">
               ${noList.map(s => `<article class="admin-agenda-item admin-agenda-no-interview" data-solicitud-id="${escapeAttr(s.id)}">
                 <div class="admin-agenda-time">—</div>
                 <div class="admin-agenda-info">
                   <div class="admin-agenda-name">${escapeHtml(s.nombre)}</div>
                   <div class="admin-agenda-sub">${escapeHtml(s.carrera)} · ${s.semestre}° sem</div>
                 </div>
               </article>`).join('')}
             </div>`}
      </section>`;
  }

  function renderStats(sols: SolicitudWithEval[]) {
    const total = sols.length;
    const evaluated = sols.filter(s => s.final_decision).length;
    const acceptedFinal = sols.filter(s => s.final_decision === 'accepted').length;
    const rejectedFinal = sols.filter(s => s.final_decision === 'rejected').length;
    const pending = sols.filter(s => !s.final_decision).length;

    document.getElementById('stat-total')!.textContent = String(total);
    document.getElementById('stat-evaluated')!.textContent = String(evaluated);
    document.getElementById('stat-accepted-final')!.textContent = String(acceptedFinal);
    document.getElementById('stat-rejected-final')!.textContent = String(rejectedFinal);
    document.getElementById('stat-pending')!.textContent = String(pending);
    renderFinalMailSummary(sols);
  }

  function finalMailBucket(row: SolicitudWithEval): typeof finalMailFilter {
    const occupancy = finalCommunicationOccupancy(row);
    return occupancy === 'failed' || occupancy === 'uncertain' ? 'problem' : occupancy;
  }

  function renderFinalMailSummary(sols: SolicitudWithEval[]) {
    document.getElementById('final-comms-summary')!.style.display = progressiveEnabled ? '' : 'none';
    if (!progressiveEnabled) return;
    const counts = { all: sols.length, free: 0, queued: 0, sent: 0, problem: 0 };
    sols.filter(row => row.final_decision).forEach(row => counts[finalMailBucket(row)]++);
    const labels = { all: 'Todos', free: 'Sin enviar', queued: 'En cola / en proceso', sent: 'Enviados', problem: 'Revisar envío' };
    for (const key of Object.keys(counts) as Array<keyof typeof counts>) {
      document.getElementById(`final-comms-count-${key}`)!.textContent = `${labels[key]} (${counts[key]})`;
    }
    const parts: string[] = [];
    if (counts.free) parts.push(`${counts.free} sin enviar`);
    if (counts.queued) parts.push(`${counts.queued} en cola o pendientes de entrega`);
    if (counts.problem) parts.push(`${counts.problem} con problemas de envío`);
    const hint = document.getElementById('final-comms-hint')!;
    hint.textContent = parts.join(' · ');
    hint.hidden = parts.length === 0;
    hint.classList.toggle('selection-comms-hint-warning', counts.problem > 0);
  }

  function renderAgenda(rows: InterviewRow[]) {
    selectedFinalIds.clear();
    finalInterviewStatuses = new Map(rows.map((row) => [row.solicitud_id, row.status]));
    const container = document.getElementById('agenda-by-day')!;
    if (rows.length === 0) {
      container.innerHTML = '<div class="admin-empty">Sin entrevistas agendadas todavía.</div>';
      return;
    }

    const byDay = new Map<string, InterviewRow[]>();
    rows.forEach(r => {
      const day = r.slot_datetime.slice(0, 10);
      if (!byDay.has(day)) byDay.set(day, []);
      byDay.get(day)!.push(r);
    });

    const html = [...byDay.entries()].map(([day, items]) => {
      const dayLabel = formatDayLong(day);
      const itemsHtml = items.map(r => renderInterviewItem(r)).join('');
      return `
        <section class="admin-agenda-day">
          <h2 class="admin-agenda-day-header">${escapeHtml(dayLabel)} <span class="admin-agenda-day-count">${items.length}</span></h2>
          <div class="admin-agenda-list">${itemsHtml}</div>
        </section>
      `;
    }).join('');

    container.innerHTML = html;

    // Sólo estos dos botones cambian el estado de una entrevista. Los
    // controles de selección final viven en otra interacción independiente.
    container.querySelectorAll<HTMLButtonElement>('.admin-agenda-row-actions .admin-mini-btn[data-action]').forEach(btn => {
      btn.addEventListener('click', () => updateStatus(btn.dataset.id!, btn.dataset.action as 'completed' | 'no_show'));
    });
    bindFinalSelectionCheckboxes(container);
  }

  function renderInterviewItem(r: InterviewRow): string {
    const time = formatTime(r.slot_datetime);
    const endTime = formatTime(new Date(new Date(r.slot_datetime).getTime() + r.duration_minutes * 60_000).toISOString());
    const room = r.room_id ? interviewRooms.get(r.room_id) : undefined;
    const sol = r.solicitudes;
    const evalBadge = renderEvalBadge(sol);
    return `
      <article data-solicitud-id="${escapeAttr(r.solicitud_id)}" class="admin-agenda-item admin-interview-room-card ${progressiveEnabled ? 'admin-agenda-item-progressive' : ''} admin-agenda-status-${r.status} ${progressiveEnabled && sol?.final_decision ? `admin-agenda-decision-${sol.final_decision}` : ''}">
        ${progressiveEnabled ? renderFinalSelectionControl(sol, r.status) : ''}
        <div class="admin-agenda-time"><span>${time}</span><span class="interview-end-time">a ${endTime}</span><span class="interview-duration">${r.duration_minutes} min</span></div>
        <div class="admin-agenda-info">
          <div class="admin-agenda-name">${escapeHtml(sol?.nombre || 'Sin nombre')}</div>
          <div class="admin-agenda-sub">${escapeHtml(sol?.carrera || '—')} · ${sol?.semestre || '?'}° sem</div>
        </div>
        <div class="admin-agenda-status-cell">
          <span class="admin-status admin-status-${r.status === 'confirmed' ? 'reviewing' : (r.status === 'completed' ? 'accepted' : (r.status === 'cancelled' ? 'rejected' : 'pending'))}">
            ${STATUS_LABELS[r.status]}
          </span>
          ${evalBadge}
        </div>
        <div class="admin-agenda-actions">
          ${r.meet_url ? `<a href="${escapeAttr(r.meet_url)}" target="_blank" rel="noopener noreferrer" class="admin-agenda-meet" title="Abrir Meet" aria-label="Abrir Meet de ${escapeAttr(room?.name ?? 'esta entrevista')} (nueva pestaña)"><i class="bi bi-camera-video-fill" aria-hidden="true"></i> Abrir Meet</a>` : '<span class="interview-meet-pending">Meet pendiente</span>'}
          <a href="/admin/solicitudes/detalle?id=${r.solicitud_id}#evaluacion" class="admin-agenda-detail admin-agenda-evaluate" title="Evaluar / Ver solicitud">
            <i class="bi bi-clipboard-data" aria-hidden="true"></i> Evaluar
          </a>
        </div>
        <div class="interview-room-summary" aria-label="Sala y responsables de esta entrevista">
          <div class="interview-room-identity"><span class="interview-meta-label"><i class="bi bi-door-open" aria-hidden="true"></i> Sala asignada</span><strong>${escapeHtml(room?.name ?? (r.room_id ? 'Sala sin información' : 'Sin sala registrada'))}</strong></div>
          <div><span class="interview-meta-label">Anfitrión · titular</span><span class="interview-responsible">${escapeHtml(room?.primary_email ?? 'Sin asignar')}</span></div>
          <div><span class="interview-meta-label">Coanfitrión · respaldo</span><span class="interview-responsible">${escapeHtml(room?.backup_email ?? 'Sin asignar')}</span></div>
        </div>
        ${progressiveEnabled && sol ? renderFinalDecisionSummary(sol, r.status) : ''}
        ${r.status === 'confirmed' ? `
          <div class="admin-agenda-row-actions">
            <button type="button" class="admin-mini-btn admin-mini-btn-success" data-id="${r.id}" data-action="completed">
              <i class="bi bi-check2"></i> Marcar completada
            </button>
            <button type="button" class="admin-mini-btn admin-mini-btn-warn" data-id="${r.id}" data-action="no_show">
              <i class="bi bi-person-x"></i> No asistió
            </button>
          </div>
        ` : ''}
      </article>
    `;
  }

  function renderEvalBadge(sol: SolicitudWithEval | null): string {
    if (!sol) return '';
    if (sol.final_decision === 'accepted') {
      return `<span class="admin-eval-pill admin-eval-pill-accept"><i class="bi bi-check-circle-fill"></i> Aceptado</span>`;
    }
    if (sol.final_decision === 'rejected') {
      return `<span class="admin-eval-pill admin-eval-pill-reject"><i class="bi bi-x-circle-fill"></i> Rechazado</span>`;
    }
    return `<span class="admin-eval-pill admin-eval-pill-pending"><i class="bi bi-hourglass-split"></i> Sin evaluar</span>`;
  }

  function renderNoInterview(sols: SolicitudWithEval[], ivs: InterviewRow[], invitedIds: Set<string>) {
    const withIv = new Set(ivs.map(i => i.solicitud_id));
    // Sólo invitados sin entrevista: un aceptado aún no notificado
    // no ha podido agendar y pertenece a Solicitudes, no aquí.
    const without = sols.filter(s => invitedIds.has(s.id) && !withIv.has(s.id));
    if (without.length === 0) return;

    document.getElementById('no-interview-section')!.style.display = '';
    document.getElementById('no-interview-count')!.textContent = String(without.length);
    const list = document.getElementById('no-interview-list')!;
    list.innerHTML = without.map(s => `
      <article data-solicitud-id="${escapeAttr(s.id)}" class="admin-agenda-item ${progressiveEnabled ? 'admin-agenda-item-progressive' : ''} admin-agenda-no-interview ${progressiveEnabled && s.final_decision ? `admin-agenda-decision-${s.final_decision}` : ''}">
        ${progressiveEnabled ? renderFinalSelectionControl(s, null) : ''}
        <div class="admin-agenda-time">—</div>
        <div class="admin-agenda-info">
          <div class="admin-agenda-name">${escapeHtml(s.nombre)}</div>
          <div class="admin-agenda-sub">${escapeHtml(s.carrera)} · ${s.semestre}° sem</div>
        </div>
        <div class="admin-agenda-status-cell">
          ${renderEvalBadge(s)}
        </div>
        <div class="admin-agenda-actions">
          <a href="/admin/solicitudes/detalle?id=${s.id}#evaluacion" class="admin-agenda-detail" title="Evaluar / Ver solicitud">
            <i class="bi bi-clipboard-data"></i>
          </a>
        </div>
        ${progressiveEnabled ? renderFinalDecisionSummary(s, null) : ''}
      </article>
    `).join('');
    bindFinalSelectionCheckboxes(list);
  }

  function setupBulkBtn(sols: SolicitudWithEval[]) {
    const btn = document.getElementById('btn-bulk-final') as HTMLButtonElement;
    const pendingDecision = sols.filter(s => !s.final_decision).length;
    const pendingNotify = sols.filter((row) => row.final_decision && finalCommunicationOccupancy(row) === 'free').length;

    if (progressiveEnabled) {
      const selectAll = document.getElementById('final-select-all') as HTMLButtonElement;
      selectAll.style.display = 'inline-flex';
      selectAll.onclick = toggleFinalSelectAll;
      btn.onclick = null;
      refreshFinalSelection(sols, pendingDecision);
      return;
    }

    if (pendingDecision > 0) {
      btn.disabled = true;
      btn.title = `Faltan ${pendingDecision} decisión(es) finales. Evalúa a todos antes de mandar.`;
      btn.innerHTML = `<i class="bi bi-exclamation-triangle"></i> Faltan ${pendingDecision} por evaluar`;
      return;
    }
    if (pendingNotify === 0) {
      btn.disabled = true;
      btn.title = 'No hay correos finales pendientes de enviar.';
      btn.innerHTML = `<i class="bi bi-check-all"></i> Resultados enviados`;
      return;
    }

    btn.disabled = false;
    btn.title = `Enviar ${pendingNotify} correo(s) finales (bienvenida / agradecimiento)`;
    btn.innerHTML = `<i class="bi bi-send-fill"></i> Enviar resultados finales (${pendingNotify})`;

    btn.addEventListener('click', async () => {
      const ok = confirm(
        `Vas a enviar ${pendingNotify} correo(s) finales de la temporada ${activeSeason}.\n\n` +
        `Aceptados reciben bienvenida + link de WhatsApp.\n` +
        `Rechazados reciben mensaje de agradecimiento.\n\n` +
        `Esto NO se puede deshacer. ¿Confirmar?`
      );
      if (!ok) return;

      btn.disabled = true;
      btn.innerHTML = `<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Enviando…`;

      const { data, error } = await supabase.functions.invoke('send-final-decisions-bulk', {
        body: { season: activeSeason },
      });

      if (error) {
        alert(`Error al enviar: ${error.message}`);
        btn.disabled = false;
        return;
      }
      const sent = data?.sent ?? 0;
      const failed = data?.failed ?? 0;
      if (failed > 0) {
        alert(`Enviados: ${sent}\nFallidos: ${failed}\n\nRevisa la consola.`);
        console.warn('Bulk final errors:', data?.errors);
      } else {
        const goCierre = confirm(
          `✓ ${sent} correo(s) enviado(s).\n\n` +
          `El proceso de selección de la temporada ${activeSeason} ha concluido.\n\n` +
          `¿Ir al panel de configuración para cerrar formalmente el ciclo?`
        );
        if (goCierre) {
          window.location.replace('/admin/seleccion-config');
          return;
        }
      }
      location.reload();
    });
  }

  function refreshFinalSelection(sols: SolicitudWithEval[], pendingDecision: number) {
    const btn = document.getElementById('btn-bulk-final') as HTMLButtonElement;
    const guide = document.getElementById('final-selection-guide')!;
    const guideText = document.getElementById('final-selection-guide-text')!;
    const count = document.getElementById('final-selection-count')!;
    const ready = sols.filter((row) => isFinalSelectable(row));

    // Descarta selecciones que ya no son comunicables después de un cambio
    // en otra pestaña o de una comunicación previa.
    for (const id of selectedFinalIds) {
      if (!ready.some((row) => row.id === id)) selectedFinalIds.delete(id);
    }
    const selected = ready.filter((row) => selectedFinalIds.has(row.id));
    const matchingReady = ready.filter(matchesSearch);
    const allSelected = matchingReady.length > 0 && matchingReady.every((row) => selectedFinalIds.has(row.id));
    const selectAll = document.getElementById('final-select-all') as HTMLButtonElement;

    selectAll.disabled = matchingReady.length === 0;
    selectAll.setAttribute('aria-pressed', String(allSelected));
    selectAll.innerHTML = allSelected
      ? '<i class="bi bi-square"></i> Deseleccionar todos'
      : '<i class="bi bi-check2-square"></i> Seleccionar todos';
    selectAll.title = matchingReady.length === 0
      ? 'No hay resultados finales pendientes de comunicar en esta búsqueda.'
      : `${allSelected ? 'Quitar' : 'Marcar'} los ${matchingReady.length} resultados listos para comunicar${searchTerms.length ? ' en esta búsqueda' : ''}.`;

    guide.style.display = 'flex';
    count.textContent = `${selected.length} seleccionado${selected.length === 1 ? '' : 's'}`;
    const outsideSearch = selected.filter((row) => !matchesSearch(row)).length;
    if (outsideSearch) count.textContent += ` (${outsideSearch} fuera de la búsqueda)`;
    if (ready.length === 0) {
      guideText.textContent = pendingDecision > 0
        ? `Faltan ${pendingDecision} resultado${pendingDecision === 1 ? '' : 's'} finales. Cuando estén guardados aparecerán aquí para comunicar.`
        : 'No hay resultados finales pendientes de comunicar.';
      btn.disabled = true;
      btn.title = pendingDecision > 0
        ? 'Primero guarda el resultado final desde Evaluar / Ver solicitud.'
        : 'No hay resultados finales pendientes de comunicar.';
      btn.innerHTML = '<i class="bi bi-send-fill"></i> Comunicar listos';
      btn.onclick = null;
      return;
    }

    if (selected.length === 0) {
      guideText.textContent = `Hay ${ready.length} resultado${ready.length === 1 ? '' : 's'} listo${ready.length === 1 ? '' : 's'}. Marca las casillas individualmente o usa “Seleccionar todos”.`;
      btn.disabled = true;
      btn.title = 'Selecciona al menos un resultado para comunicar.';
      btn.innerHTML = '<i class="bi bi-send-fill"></i> Comunicar listos';
      btn.onclick = null;
      return;
    }

    guideText.textContent = 'Revisa la selección y comunica sólo estas personas. Cada aceptado ingresará a Miembros cuando se confirme su correo final.';
    btn.disabled = false;
    btn.title = `Previsualizar y comunicar ${selected.length} resultado(s) seleccionado(s)`;
    btn.innerHTML = `<i class="bi bi-send-fill"></i> Comunicar listos (${selected.length})`;
    btn.onclick = () => { void communicateFinalRows(selected, btn, pendingDecision); };
  }

  function toggleFinalSelectAll() {
    if (!progressiveEnabled) return;
    const ready = visibleSolicitudes.filter((row) => isFinalSelectable(row) && matchesSearch(row));
    const allSelected = ready.length > 0 && ready.every((row) => selectedFinalIds.has(row.id));
    for (const row of ready) {
      if (allSelected) selectedFinalIds.delete(row.id);
      else selectedFinalIds.add(row.id);
    }
    document.querySelectorAll<HTMLInputElement>('.admin-final-select').forEach((checkbox) => {
      const id = checkbox.dataset.solicitudId;
      checkbox.checked = !!id && selectedFinalIds.has(id);
    });
    refreshFinalSelection(visibleSolicitudes, visibleSolicitudes.filter((row) => !row.final_decision).length);
  }

  async function updateStatus(id: string, action: 'completed' | 'no_show') {
    const label = action === 'completed' ? 'completada' : 'no show';
    const ok = confirm(`¿Marcar esta entrevista como ${label}?`);
    if (!ok) return;
    if (progressiveEnabled) {
      try {
        if (isSelectionLab && action === 'completed') {
          await selectionLabCompleteInterview(id);
        } else {
          await selectionAdmin('interview', { id, status: action, reason: `Marcada como ${label} desde el panel.` });
        }
      } catch (error) {
        alert(selectionErrorMessage(error));
        return;
      }
    } else {
      const { error } = await supabase.from('interviews').update({ status: action }).eq('id', id);
      if (error) { alert(`Error: ${error.message}`); return; }
    }
    location.reload();
  }

  function finalCommunicationOccupancy(row: SolicitudWithEval): ReturnType<typeof stageCommsOccupancy> {
    return stageCommsOccupancy(stateMessages, row.id, 'final', row.final_email_sent);
  }

  function isFinalSelectable(sol: SolicitudWithEval): boolean {
    const interviewStatus = finalInterviewStatuses.get(sol.id) ?? 'none';
    return progressiveEnabled &&
      !!sol.final_decision &&
      !sol.final_email_sent &&
      interviewStatus !== 'confirmed' &&
      finalCommunicationOccupancy(sol) === 'free';
  }

  function renderFinalSelectionControl(sol: SolicitudWithEval | null, interviewStatus: InterviewRow['status'] | null): string {
    if (!sol || !isFinalSelectable(sol) || ['confirmed', 'cancelled'].includes(interviewStatus ?? 'none')) {
      return '<span class="admin-agenda-select admin-agenda-select-placeholder" aria-hidden="true"></span>';
    }
    const decisionLabel = sol.final_decision === 'accepted' ? 'aceptado' : 'rechazado';
    return `<label class="admin-agenda-select" title="Seleccionar resultado ${decisionLabel} para comunicar">
      <input type="checkbox" class="admin-final-select" data-solicitud-id="${escapeAttr(sol.id)}" aria-label="Seleccionar a ${escapeAttr(sol.nombre)} para comunicar su resultado final">
      <span class="visually-hidden">Seleccionar para comunicar resultado final</span>
    </label>`;
  }

  function renderFinalDecisionSummary(sol: SolicitudWithEval, interviewStatus: InterviewRow['status'] | null): string {
    const status = interviewStatus ?? 'none';
    const statusText = status === 'completed'
      ? (sol.final_decision ? 'Entrevista completada' : 'Falta decidir en Evaluar / Ver solicitud')
      : status === 'no_show'
        ? 'No show: decisión en Evaluar / Ver solicitud'
        : status === 'cancelled'
          ? 'Entrevista cancelada: decisión en Evaluar / Ver solicitud'
          : status === 'confirmed'
            ? 'Entrevista pendiente: todavía no se puede comunicar'
            : 'Decisión en Evaluar / Ver solicitud';
    const finalLabel = sol.final_decision === 'accepted' ? 'Aceptado' : sol.final_decision === 'rejected' ? 'Rechazado' : '';
    const provisioning = memberProvisioning.get(sol.id);
    let memberNote = '';
    if (sol.final_email_sent && (sol.final_decision === 'accepted' || provisioning?.status === 'review_required')) {
      const message = provisioning?.member_id && provisioning.status === 'created' ? 'Alta automática en Miembros completada'
        : provisioning?.member_id && provisioning.status === 'existing' ? 'Miembro existente vinculado; datos y puntos conservados'
        : provisioning?.status === 'review_required' ? 'Rectificación: revisar acceso y puntos manualmente'
        : provisioning?.status === 'conflict' || provisioning?.status === 'error'
          ? `Alta pendiente de revisión: ${provisioning.detail ?? 'conflicto de datos'}`
          : memberProvisioningUnavailable ? 'No se pudo verificar el alta en Miembros'
          : 'Alta en Miembros sin registro: revisar';
      memberNote = `<span class="admin-agenda-final-note"><i class="bi bi-person-badge"></i> ${escapeHtml(message)}</span>`;
    }
    const failedDelivery = stateMessages.some((message) => message.solicitud_id === sol.id && message.kind === 'final'
      && ['bounced', 'failed', 'complained'].includes(message.delivery_status ?? ''));
    if (sol.final_email_sent && failedDelivery) {
      memberNote += '<span class="admin-agenda-final-note"><i class="bi bi-exclamation-triangle"></i> El correo tuvo un problema de entrega: revisar contacto.</span>';
    }

    if (sol.final_email_sent) {
      return `<div class="admin-agenda-final admin-agenda-final-locked">
        <div class="admin-agenda-final-result"><span class="admin-agenda-final-label">Resultado final</span><strong>${finalLabel || 'Comunicado'}</strong></div>
        <span class="admin-agenda-final-note"><i class="bi bi-lock-fill"></i> Resultado comunicado</span>
        ${memberNote}
      </div>`;
    }

    const occupancy = finalCommunicationOccupancy(sol);
    const communicationNote = sol.final_decision && occupancy !== 'free'
      ? `<span class="admin-agenda-final-note admin-agenda-final-note-${occupancy}"><i class="bi bi-envelope"></i> ${commsOccupancyLabel(occupancy)}</span>`
      : sol.final_decision && status !== 'confirmed'
        ? '<span class="admin-agenda-final-note admin-agenda-final-note-ready"><i class="bi bi-check2-circle"></i> Listo: marca la casilla izquierda para comunicar</span>'
        : '';

    return `<div class="admin-agenda-final ${status === 'confirmed' ? 'admin-agenda-final-waiting' : ''}">
      <div class="admin-agenda-final-heading">
        <div class="admin-agenda-final-result"><span class="admin-agenda-final-label">Resultado final</span><strong>${finalLabel || 'Aún sin decidir'}</strong></div>
        <span class="admin-agenda-final-context">${statusText}</span>
      </div>
      ${communicationNote}
    </div>`;
  }

  function bindFinalSelectionCheckboxes(container: HTMLElement) {
    if (!progressiveEnabled) return;
    container.querySelectorAll<HTMLInputElement>('.admin-final-select').forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        const id = checkbox.dataset.solicitudId;
        if (!id) return;
        if (checkbox.checked) selectedFinalIds.add(id);
        else selectedFinalIds.delete(id);
        refreshFinalSelection(visibleSolicitudes, visibleSolicitudes.filter((row) => !row.final_decision).length);
      });
    });
  }

  async function communicateFinalRows(
    candidates: SolicitudWithEval[],
    trigger: HTMLButtonElement,
    pendingDecision?: number,
  ) {
    const original = trigger.innerHTML;
    trigger.disabled = true;
    trigger.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Preparando…';
    try {
      const fresh = await getSelectionState(activeSeason);
      stateMessages = fresh.messages ?? [];
      const freshRows = (fresh.solicitudes ?? [])
        .filter((row) => candidates.some((candidate) => candidate.id === row.id)) as unknown as SolicitudWithEval[];
      const ready = freshRows.filter((row) => row.final_decision && finalCommunicationOccupancy(row) === 'free');
      if (ready.length === 0) {
        alert('No hay resultados finales libres para comunicar; alguien pudo actualizarlos en otra pestaña.');
        location.reload();
        return;
      }
      const draft = await previewSelectionCommunication('final', ready as unknown as SelectionSolicitud[]);
      const summary = draft.preview.items
        .map((item) => `• ${item.nombre} <${item.correo}>\n  ${item.subject}`)
        .join('\n\n');
      const suffix = pendingDecision && pendingDecision > 0
        ? `\n\nQuedarán ${pendingDecision} persona(s) todavía en proceso.`
        : '';
      if (!confirm(`PREVISUALIZACIÓN — RESULTADO(S) FINAL(ES) (${ready.length})\n\n${summary}${suffix}\n\n¿Encolar este envío?`)) return;
      const result = await confirmSelectionCommunication(draft);
      alert(`${result.queued} resultado(s) encolado(s). El dispatcher local procesará el correo.`);
      location.reload();
    } catch (error) {
      alert(selectionErrorMessage(error));
    } finally {
      trigger.disabled = false;
      trigger.innerHTML = original;
    }
  }

  function formatTime(iso: string): string {
    return new Intl.DateTimeFormat('es-MX', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Mexico_City' }).format(new Date(iso));
  }
  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function escapeAttr(s: string): string { return escapeHtml(s); }
</script>


