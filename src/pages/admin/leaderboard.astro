    const step1 = document.getElementById('manual-step-1')!;
    const step2 = document.getElementById('manual-step-2')!;
    const header = document.getElementById('manual-header')!;
    const titleEl = document.getElementById('manual-title')!;
    const subtitleEl = document.getElementById('manual-subtitle')!;
    const select = document.getElementById('manual-miembro-selector') as HTMLSelectElement;
    const puntosInput = document.getElementById('manual-puntos') as HTMLInputElement;
    const notasInput = document.getElementById('manual-notas') as HTMLTextAreaElement;
    const notasHint = document.getElementById('manual-notas-hint')!;
    const continueBtn = document.getElementById('continue-manual-btn') as HTMLButtonElement;
    const backBtn = document.getElementById('back-manual-btn') as HTMLButtonElement;
    const confirmBtn = document.getElementById('confirm-manual-btn') as HTMLButtonElement;
    const confirmWarning = document.getElementById('confirm-warning')!;
    const confirmSummary = document.getElementById('confirm-summary')!;
    const confirmMotivo = document.getElementById('confirm-motivo')!;
    const confirmAdmin = document.getElementById('confirm-admin')!;
    const confirmFecha = document.getElementById('confirm-fecha')!;

    let currentMode: 'suma' | 'resta' = 'suma';
    let miembrosMap: Record<string, { nombre: string; numero_cuenta: string }> = {};

    const { data: miembros } = await supabase
      .from('miembros_activos')
      .select('id, nombre, numero_cuenta')
      .order('nombre');
    if (miembros) {
      select.innerHTML = '<option value="">Selecciona un miembro...</option>' +
        miembros.map(m => `<option value="${m.id}">${m.nombre}${m.numero_cuenta ? ' (' + m.numero_cuenta + ')' : ''}</option>`).join('');
      miembros.forEach(m => { miembrosMap[m.id] = { nombre: m.nombre, numero_cuenta: m.numero_cuenta || '—' }; });
    }

    function applyModeStyles() {
      const isSuma = currentMode === 'suma';
      const color = isSuma ? '#10b981' : '#ef4444';
      const icon = isSuma ? 'bi-plus-circle-fill' : 'bi-dash-circle-fill';
      const verbUpper = isSuma ? 'Sumar' : 'Restar';
      const verbLower = isSuma ? 'sumarán' : 'restarán';
      const prep = isSuma ? 'al' : 'del';

      header.style.background = isSuma ? '#ecfdf5' : '#fef2f2';
      header.style.borderColor = color;
      titleEl.innerHTML = `<i class="bi ${icon}" style="color: ${color};"></i> ${verbUpper.toUpperCase()} PUNTOS MANUALES`;
      subtitleEl.textContent = `Los puntos se ${verbLower} ${prep} balance del miembro seleccionado.`;

      confirmWarning.style.background = isSuma ? '#ecfdf5' : '#fef2f2';
      confirmWarning.style.borderColor = color;
      confirmWarning.style.color = isSuma ? '#065f46' : '#991b1b';

      confirmBtn.style.background = color;
    }

    function resetForm() {
      goToStep(1);
      select.value = '';
      puntosInput.value = '';
      notasInput.value = '';
      updateHint();
    }

    function goToStep(n: 1 | 2) {
      step1.style.display = n === 1 ? 'flex' : 'none';
      step2.style.display = n === 2 ? 'flex' : 'none';
    }

    function updateHint() {
      const len = notasInput.value.trim().length;
      notasHint.textContent = `${len} / ${MIN_MOTIVO_LEN} caracteres mínimos`;
      notasHint.style.color = len >= MIN_MOTIVO_LEN ? '#10b981' : '#888';
    }

    function openModal(mode: 'suma' | 'resta') {
      currentMode = mode;
      applyModeStyles();
      resetForm();
      modal.style.display = 'flex';
    }

    function closeModal() {
      modal.style.display = 'none';
    }

    addBtn?.addEventListener('click', () => openModal('suma'));
    subBtn?.addEventListener('click', () => openModal('resta'));
    closeBtn?.addEventListener('click', closeModal);
    notasInput.addEventListener('input', updateHint);

    continueBtn.addEventListener('click', () => {
      const miembroId = select.value;
      const cantidad = parseInt(puntosInput.value);
      const motivo = notasInput.value.trim();

      if (!miembroId) { alert('Selecciona un miembro.'); return; }
      if (isNaN(cantidad) || cantidad <= 0) { alert('La cantidad debe ser un entero positivo.'); return; }
      if (motivo.length < MIN_MOTIVO_LEN) {
        alert(`El motivo debe tener al menos ${MIN_MOTIVO_LEN} caracteres para auditoría.`);
        return;
      }

      const m = miembrosMap[miembroId];
      const verb = currentMode === 'suma' ? 'SUMAR' : 'RESTAR';
      confirmSummary.innerHTML = `Vas a <strong>${verb} ${cantidad} puntos</strong> ${currentMode === 'suma' ? 'a' : 'de'} <strong>${m.nombre}</strong> (cuenta ${m.numero_cuenta}).`;
      confirmMotivo.textContent = `"${motivo}"`;
      confirmAdmin.textContent = sessionEmail;
      confirmFecha.textContent = new Date().toLocaleString('es-MX');
      goToStep(2);
    });

    backBtn.addEventListener('click', () => goToStep(1));

    confirmBtn.addEventListener('click', async () => {
      const miembroId = select.value;
      const cantidad = parseInt(puntosInput.value);
      const motivo = notasInput.value.trim();

      confirmBtn.disabled = true;
      backBtn.disabled = true;
      const originalHTML = confirmBtn.innerHTML;
      confirmBtn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Guardando...';

      const { error } = await supabase.rpc('insert_ajuste_manual', {
        p_miembro_id: miembroId,
        p_tipo: currentMode,
        p_cantidad: cantidad,
        p_admin_email: sessionEmail,
        p_motivo: motivo,
      });

      if (error) {
        alert('Error aplicando el ajuste: ' + error.message);
        confirmBtn.disabled = false;
        backBtn.disabled = false;
        confirmBtn.innerHTML = originalHTML;
        return;
      }

      closeModal();
      await loadPending();
    });
  }

  function setupRevokeModal() {
    const modal = document.getElementById('revoke-modal')!;
    const closeBtn = document.getElementById('close-revoke-modal');
    const cancelBtn = document.getElementById('cancel-revoke-btn');
    const confirmBtn = document.getElementById('confirm-revoke-btn') as HTMLButtonElement;
    const motivoInput = document.getElementById('revoke-motivo') as HTMLTextAreaElement;
    const motivoHint = document.getElementById('revoke-motivo-hint')!;
    const summary = document.getElementById('revoke-summary')!;

    let currentRegistroId = '';

    function updateHint() {
      const len = motivoInput.value.trim().length;
      motivoHint.textContent = `${len} / ${MIN_MOTIVO_LEN} caracteres mínimos`;
      motivoHint.style.color = len >= MIN_MOTIVO_LEN ? '#10b981' : '#888';
    }

    function close() { modal.style.display = 'none'; }

    (window as any).__openRevoke = (id: string, cantidad: number, nombre: string, motivoOriginal: string) => {
      currentRegistroId = id;
      const signo = cantidad >= 0 ? '+' : '';
      summary.innerHTML = `Vas a anular el ajuste manual <strong>${signo}${cantidad} pts</strong> de <strong>${nombre}</strong>.<br><span style="color:#666;font-size:0.85rem;">Motivo original: "${motivoOriginal}"</span>`;
      motivoInput.value = '';
      updateHint();
      modal.style.display = 'flex';
    };

    motivoInput.addEventListener('input', updateHint);
    closeBtn?.addEventListener('click', close);
    cancelBtn?.addEventListener('click', close);

    confirmBtn.addEventListener('click', async () => {
      const motivo = motivoInput.value.trim();
      if (motivo.length < MIN_MOTIVO_LEN) {
        alert(`El motivo de la anulación debe tener al menos ${MIN_MOTIVO_LEN} caracteres.`);
        return;
      }

      confirmBtn.disabled = true;
      const originalHTML = confirmBtn.innerHTML;
      confirmBtn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i>';

      const { error } = await supabase.rpc('revocar_ajuste_manual', {
        p_registro_id: currentRegistroId,
        p_admin_email: sessionEmail,
        p_motivo_revocacion: motivo,
      });

      if (error) {
        alert('Error anulando el ajuste: ' + error.message);
        confirmBtn.disabled = false;
        confirmBtn.innerHTML = originalHTML;
        return;
      }

      close();
      await loadPending();
    });
  }
</script>
