  async function processAction(action: 'approve' | 'reject', id: string, pts: number, notas: string, btnElement: HTMLButtonElement, email?: string, nombre?: string, accionName?: string, ptsSolicitados?: number) {
    btnElement.disabled = true;
    btnElement.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i>';

    const rpcName = action === 'approve' ? 'approve_puntos' : 'reject_puntos';
    const payload = action === 'approve' 
      ? { p_registro_id: id, p_puntos_aprobados: pts, p_admin_email: sessionEmail, p_notas: notas }
      : { p_registro_id: id, p_admin_email: sessionEmail, p_notas: notas };

    const { error } = await supabase.rpc(rpcName, payload);

    if (error) {
      alert(`Error al procesar: ${error.message}`);
      btnElement.disabled = false;
      btnElement.innerHTML = action === 'approve' ? '<i class="bi bi-check-lg"></i> Aprobar' : '<i class="bi bi-x-lg"></i> Rechazar';
    } else {
      
      // If rejected, send the email via our new internal API
      if (action === 'reject' && email) {
        try {
          await fetch('/api/send-rejection', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              miembroEmail: email,
              miembroNombre: nombre,
              accion: accionName,
              notasAdmin: notas,
              puntosSolicitados: ptsSolicitados
            })
          });
        } catch (e) {
          console.error("Error enviando correo de rechazo:", e);
        }
      }

      await loadPending(); // Reload entirely to refresh UI safely
    }
  }

  document.addEventListener('DOMContentLoaded', async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (session?.user?.email) {
      sessionEmail = session.user.email;
      await loadPeriods();
      setupManualModal();
      setupRevokeModal();
      setupExportButton();
      setupToggleCerradoButton();
      setupConfigMenu();
    }
  });

  function setupConfigMenu() {
    const btn = document.getElementById('config-menu-btn') as HTMLButtonElement | null;
    const menu = document.getElementById('config-menu');
    const wrapper = document.getElementById('config-menu-wrapper');
    if (!btn || !menu || !wrapper) return;

    function open() {
      if (!menu || !btn) return;
      menu.style.display = 'block';
      btn.setAttribute('aria-expanded', 'true');
    }
    function close() {
      if (!menu || !btn) return;
      menu.style.display = 'none';
      btn.setAttribute('aria-expanded', 'false');
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = menu.style.display === 'block';
      isOpen ? close() : open();
    });

    // Cierra al hacer click fuera del menú
    document.addEventListener('click', (e) => {
      if (!wrapper.contains(e.target as Node)) close();
    });

    // Cierra con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    // Cierra cuando se selecciona un item
    menu.querySelectorAll('.config-menu-item').forEach(item => {
      item.addEventListener('click', () => close());
    });
  }

  function setupToggleCerradoButton() {
    const btn = document.getElementById('toggle-cerrado-btn') as HTMLButtonElement | null;
    if (!btn) return;

    btn.addEventListener('click', async () => {
      if (!selectedPeriodId) { alert('Selecciona un período primero.'); return; }

      const p = periodsCache.find(x => x.id === selectedPeriodId);
      const cerradoActual = !!p?.formularios_cerrados;
      const accion = cerradoActual ? 'REABRIR' : 'CERRAR';
      const detalle = cerradoActual
        ? 'Los miembros volverán a poder subir evidencias en este período.'
        : 'Los miembros ya no podrán subir nuevas evidencias en este período. Los admins seguirán pudiendo revisar, aprobar y ajustar los registros existentes.';

      if (!confirm(`¿${accion} los formularios de "${selectedPeriodName}"?\n\n${detalle}`)) return;

      const original = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Guardando...';

      const { error } = await supabase.rpc('toggle_periodo_cerrado', {
        p_periodo_id: selectedPeriodId,
        p_admin_email: sessionEmail,
      });

      if (error) {
        alert('Error al cambiar el estado: ' + error.message);
        btn.disabled = false;
        btn.innerHTML = original;
        return;
      }

      // Refresh cache localmente sin recargar todo
      const idx = periodsCache.findIndex(x => x.id === selectedPeriodId);
      if (idx !== -1) periodsCache[idx].formularios_cerrados = !cerradoActual;
      btn.disabled = false;
      updateToggleButton();
    });
  }

  function setupExportButton() {
    const btn = document.getElementById('export-excel-btn') as HTMLButtonElement | null;
    if (!btn) return;
    const originalHTML = btn.innerHTML;

    btn.addEventListener('click', async () => {
      if (!selectedPeriodId) {
        alert('Selecciona un período primero.');
        return;
      }
      btn.disabled = true;
      btn.style.opacity = '0.7';
      btn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Generando...';
      try {
        const { exportLeaderboardToExcel } = await import('@lib/export-leaderboard');
        await exportLeaderboardToExcel(supabase, selectedPeriodId, selectedPeriodName || 'Periodo');
      } catch (e: any) {
        alert(e?.message || 'Error generando el Excel.');
        console.error(e);
      } finally {
        btn.disabled = false;
        btn.style.opacity = '1';
        btn.innerHTML = originalHTML;
      }
    });
  }

  const MIN_MOTIVO_LEN = 15;

  async function setupManualModal() {
    const addBtn = document.getElementById('open-add-btn') as HTMLButtonElement | null;
