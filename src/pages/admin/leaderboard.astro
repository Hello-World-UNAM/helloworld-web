---
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Revisión Leaderboard | Admin" activeNav="leaderboard">
  <style is:global>
    .card-registro-content { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; flex-wrap: wrap; }
    .card-registro-left { flex: 1; min-width: 300px; }
    .card-registro-right { width: 320px; display: flex; flex-direction: column; gap: 0.8rem; }

    @media (max-width: 768px) {
      .card-registro-left { min-width: 100%; }
      .card-registro-right { width: 100%; }
      .card-registro-content { gap: 1.2rem; }
    }
  </style>

  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-title">
        <span class="admin-title-icon"><i class="bi bi-award-fill"></i></span>
        Revisión de puntos
      </h1>
      <p class="admin-page-subtitle">Audita y aprueba las evidencias subidas por los miembros.</p>
    </div>
    <div class="admin-page-actions">
      <div id="config-menu-wrapper" class="admin-menu-wrapper">
        <button id="config-menu-btn" class="admin-btn admin-btn-purple" aria-haspopup="menu" aria-expanded="false">
          <i class="bi bi-gear-fill"></i> Configuración <i class="bi bi-chevron-down" style="font-size: 0.7rem;"></i>
        </button>

        <div id="config-menu" class="admin-menu" role="menu">
          <p class="admin-menu-heading">Ajustes manuales</p>
          <button id="open-add-btn" role="menuitem" data-mode="suma" class="config-menu-item admin-menu-item admin-menu-item-success">
            <i class="bi bi-plus-circle-fill"></i> Sumar puntos manuales
          </button>
          <button id="open-subtract-btn" role="menuitem" data-mode="resta" class="config-menu-item admin-menu-item admin-menu-item-danger">
            <i class="bi bi-dash-circle-fill"></i> Restar puntos manuales
          </button>

          <hr class="admin-menu-divider">

          <p class="admin-menu-heading">Registro del semestre</p>
          <button id="toggle-cerrado-btn" role="menuitem" class="config-menu-item admin-menu-item" title="Cerrar o reabrir los formularios del período seleccionado para el registro de evidencias.">
            <i class="bi bi-lock-fill" id="toggle-cerrado-icon"></i> <span id="toggle-cerrado-label">Cerrar formularios</span>
          </button>

          <hr class="admin-menu-divider">

          <p class="admin-menu-heading">Reportes</p>
          <button id="export-excel-btn" role="menuitem" class="config-menu-item admin-menu-item" title="Descarga un Excel con las evidencias aprobadas del período seleccionado, agrupadas por miembro y ordenadas de mayor a menor puntaje.">
            <i class="bi bi-file-earmark-excel-fill"></i> Exportar Excel para Jefatura
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="admin-toolbar">
    <div class="admin-search-wrap">
      <i class="bi bi-search admin-search-icon"></i>
      <input type="text" id="search-input" class="admin-search" placeholder="Buscar por nombre, cuenta o correo..." autocomplete="off">
    </div>
    <div class="admin-toolbar-field">
      <label class="admin-field-label" for="sort-selector">Ordenar</label>
      <select id="sort-selector" class="admin-select">
        <option value="desc" selected>Más recientes</option>
        <option value="asc">Más antiguos</option>
      </select>
    </div>
    <div class="admin-toolbar-field">
      <label class="admin-field-label" for="status-selector">Estado</label>
      <select id="status-selector" class="admin-select">
        <option value="pending" selected>Pendientes</option>
        <option value="approved">Aprobados</option>
        <option value="rejected">Rechazados</option>
        <option value="deleted">Eliminados</option>
        <option value="all">Todos</option>
      </select>
    </div>
    <div class="admin-toolbar-field">
      <label class="admin-field-label" for="period-selector">Semestre</label>
      <select id="period-selector" class="admin-select">
        <option value="">Cargando...</option>
      </select>
    </div>
  </div>

  <div id="pending-list" style="display: grid; gap: 1.4rem;">
    <!-- Populated by JS -->
    <div id="loading" class="admin-redirect" style="min-height: 30vh;">
      <i class="bi bi-arrow-clockwise admin-redirect-spin"></i>
      <p>Cargando solicitudes pendientes...</p>
    </div>

    <div id="empty-state" class="admin-empty admin-days-empty" style="display: none; padding: 4rem 1.5rem;">
      <i class="bi bi-check-circle-fill" style="font-size: 2.6rem; color: #6225e6; display: block; margin-bottom: 0.8rem;"></i>
      <h2 style="margin: 0 0 0.4rem; font-weight: 900; text-transform: uppercase; font-size: 1.2rem; color: #000; font-style: normal;">¡Todo al día!</h2>
      <p style="margin: 0;">No hay evidencias pendientes por revisar.</p>
    </div>
  </div>

  <!-- Modal Ajustes Manuales (2 pasos) -->
  <div id="manual-points-modal" class="admin-modal">
    <div class="admin-modal-card">
      <button id="close-manual-modal" class="admin-modal-close" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>

      <!-- Header dinámico según modo -->
      <div id="manual-header" class="admin-modal-header">
        <h2 id="manual-title" class="admin-modal-title">Sumar Puntos Manuales</h2>
        <p id="manual-subtitle">Se sumarán al balance del miembro seleccionado.</p>
      </div>

      <!-- PASO 1: captura -->
      <div id="manual-step-1" style="display: flex; flex-direction: column; gap: 1.1rem;">
        <div class="admin-modal-field">
          <label for="manual-miembro-selector">Miembro</label>
          <select id="manual-miembro-selector" class="admin-select admin-select-block">
            <option value="">Selecciona un miembro...</option>
          </select>
        </div>

        <div class="admin-modal-field">
          <label for="manual-puntos">Cantidad de puntos <span>(entero positivo)</span></label>
          <input type="number" id="manual-puntos" class="admin-text-input" min="1" step="1" placeholder="Ej: 500">
        </div>

        <div class="admin-modal-field">
          <label for="manual-notas">Motivo <span>(mínimo 15 caracteres — auditoría)</span></label>
          <textarea id="manual-notas" class="admin-textarea" placeholder="Ej: Ganó 1er lugar hackathon UNAM 2026" rows="3" style="min-height: 80px;"></textarea>
          <p id="manual-notas-hint" class="admin-modal-hint">0 / 15 caracteres mínimos</p>
        </div>

        <button id="continue-manual-btn" class="admin-btn admin-btn-black" style="width: 100%; padding: 14px;">
          Continuar <i class="bi bi-arrow-right"></i>
        </button>
      </div>

      <!-- PASO 2: confirmación -->
      <div id="manual-step-2" style="display: none; flex-direction: column; gap: 1.1rem;">
        <div id="confirm-warning" style="padding: 14px 16px; border: 3px solid; font-size: 0.9rem;">
          <p style="margin: 0 0 0.4rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;"><i class="bi bi-exclamation-triangle-fill"></i> Confirmar operación</p>
          <p id="confirm-summary" style="margin: 0; font-weight: 600;"></p>
        </div>

        <div class="admin-confirm-panel">
          <p class="admin-confirm-panel-label">Motivo</p>
          <p id="confirm-motivo" class="admin-confirm-panel-value" style="font-style: italic;"></p>

          <p class="admin-confirm-panel-label">Registrado por</p>
          <p id="confirm-admin" class="admin-confirm-panel-value"></p>

          <p class="admin-confirm-panel-label">Fecha</p>
          <p id="confirm-fecha" class="admin-confirm-panel-value"></p>
        </div>

        <div class="admin-modal-btnrow">
          <button id="back-manual-btn" class="admin-btn">
            <i class="bi bi-arrow-left"></i> Volver
          </button>
          <button id="confirm-manual-btn" class="admin-btn" style="color: #fff;">
            Confirmar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Revocar Ajuste Manual -->
  <div id="revoke-modal" class="admin-modal" style="z-index: 1001;">
    <div class="admin-modal-card admin-modal-card-danger">
      <button id="close-revoke-modal" class="admin-modal-close" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
      <h2 class="admin-modal-title" style="color: #b91c1c; margin-bottom: 0.5rem;"><i class="bi bi-arrow-counterclockwise"></i> Anular ajuste manual</h2>
      <p id="revoke-summary" style="margin: 0 0 1.2rem; font-size: 0.9rem; color: #444;"></p>

      <div class="admin-modal-field">
        <label for="revoke-motivo">Motivo de la anulación <span>(mínimo 15 caracteres)</span></label>
        <textarea id="revoke-motivo" class="admin-textarea" placeholder="Ej: Se comprobó que no cumplió los requisitos del premio." rows="3" style="min-height: 80px;"></textarea>
        <p id="revoke-motivo-hint" class="admin-modal-hint" style="margin-bottom: 1rem;">0 / 15 caracteres mínimos</p>
      </div>

      <div class="admin-modal-btnrow">
        <button id="cancel-revoke-btn" class="admin-btn">
          Cancelar
        </button>
        <button id="confirm-revoke-btn" class="admin-btn admin-btn-danger-solid">
          Anular
        </button>
      </div>
    </div>
  </div>

</AdminLayout>

<script>
  import { supabase } from '@lib/supabase';

  let sessionEmail = '';
  let selectedPeriodId = '';
  let selectedPeriodName = '';
  let selectedStatus = 'pending';
  let searchQuery = '';
  let sortOrder = 'desc';
  let periodsCache: any[] = [];

  function updateSelectedPeriodName() {
    const p = periodsCache.find(x => x.id === selectedPeriodId);
    selectedPeriodName = p?.nombre || '';
    updateToggleButton();
  }

  function updateToggleButton() {
    const label = document.getElementById('toggle-cerrado-label');
    const icon = document.getElementById('toggle-cerrado-icon');
    if (!label || !icon) return;
    const p = periodsCache.find(x => x.id === selectedPeriodId);
    const cerrado = !!p?.formularios_cerrados;
    if (cerrado) {
      icon.className = 'bi bi-unlock-fill';
      icon.style.color = '#ca8a04';
      label.textContent = 'Reabrir formularios';
    } else {
      icon.className = 'bi bi-lock-fill';
      icon.style.color = '';
      label.textContent = 'Cerrar formularios';
    }
  }

  async function loadPeriods() {
    const selector = document.getElementById('period-selector') as HTMLSelectElement;
    const statusSelector = document.getElementById('status-selector') as HTMLSelectElement;

    const { data: periodos, error } = await supabase
      .from('periodos')
      .select('id, nombre, es_activo, formularios_cerrados, cerrado_at, cerrado_por')
      .order('created_at', { ascending: false });

    if (error || !periodos) return;

    periodsCache = periodos;

    selector.innerHTML = periodos.map(p =>
      `<option value="${p.id}" ${p.es_activo ? 'selected' : ''}>${p.nombre} ${p.es_activo ? '(Activo)' : ''}</option>`
    ).join('');

    selectedPeriodId = selector.value;
    selectedStatus = statusSelector.value;
    updateSelectedPeriodName();

    selector.addEventListener('change', (e) => {
      selectedPeriodId = (e.target as HTMLSelectElement).value;
      updateSelectedPeriodName();
      loadPending();
    });

    statusSelector.addEventListener('change', (e) => {
      selectedStatus = (e.target as HTMLSelectElement).value;
      loadPending();
    });

    document.getElementById('sort-selector')?.addEventListener('change', (e) => {
      sortOrder = (e.target as HTMLSelectElement).value;
      loadPending();
    });

    let searchTimeout: any = null;
    document.getElementById('search-input')?.addEventListener('input', (e) => {
      clearTimeout(searchTimeout);
      searchQuery = (e.target as HTMLInputElement).value.trim();
      searchTimeout = setTimeout(() => {
        loadPending();
      }, 400); // 400ms debounce
    });

    // Call loadPending initially
    loadPending();
  }

  async function loadPending() {
    const list = document.getElementById('pending-list')!;
    const loading = document.getElementById('loading')!;
    const empty = document.getElementById('empty-state')!;

    // Reset view
    list.querySelectorAll('.card-registro').forEach(el => el.remove());
    loading.style.display = 'flex';
    empty.style.display = 'none';

    let query = supabase
      .from('puntos_registros')
      .select(`
        id, created_at, horas_reportadas, es_evento_externo, url_evidencia, puntos_solicitados, estado_aprobacion, notas_admin, reviewed_by,
        miembros_activos!inner(nombre, correo, numero_cuenta),
        leaderboard_config(accion, permite_sponsor_alto_valor, multiplicador_externo)
      `)
      .eq('periodo_id', selectedPeriodId);

    if (selectedStatus !== 'all') {
      query = query.eq('estado_aprobacion', selectedStatus);
    }

    const { data: records, error } = await query.order('created_at', { ascending: sortOrder === 'asc' });

    loading.style.display = 'none';

    if (error) {
      console.error(error);
      alert('Error cargando solicitudes.');
      return;
    }

    let filteredRecords = records || [];

    if (searchQuery) {
      const q = searchQuery.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      filteredRecords = filteredRecords.filter(row => {
        const miembro = row.miembros_activos as any;
        const nombre = (miembro?.nombre || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const correo = (miembro?.correo || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const cuenta = (miembro?.numero_cuenta || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        return nombre.includes(q) || correo.includes(q) || cuenta.includes(q);
      });
    }

    if (filteredRecords.length === 0) {
      empty.style.display = 'block';
      return;
    }

    filteredRecords.forEach(row => {
      const card = document.createElement('div');
      card.className = 'card-registro';

      const miembro = row.miembros_activos as any;
      const config = row.leaderboard_config as any;
      const isManual = !config;
      const manualSigned = row.puntos_solicitados;
      const manualIsAdd = manualSigned >= 0;
      const date = new Date(row.created_at).toLocaleString('es-MX');

      let dynamicInfo = '';
      if (row.horas_reportadas) dynamicInfo += `<span class="admin-chip admin-chip-hours">${row.horas_reportadas} hrs reportadas</span>`;
      if (row.es_evento_externo && config) dynamicInfo += `<span class="admin-chip admin-chip-ext">Evento Externo (x${config.multiplicador_externo})</span>`;
      if (isManual) {
        const badgeIcon = manualIsAdd ? 'bi-plus-circle-fill' : 'bi-dash-circle-fill';
        const badgeLabel = manualIsAdd ? 'MANUAL · SUMA' : 'MANUAL · RESTA';
        dynamicInfo += `<span class="admin-chip ${manualIsAdd ? 'admin-chip-add' : 'admin-chip-sub'}"><i class="bi ${badgeIcon}"></i> ${badgeLabel}</span>`;
      }

      // Status Badge
      let statusHTML = '';
      if (row.estado_aprobacion === 'approved') {
        statusHTML = `<span class="admin-status admin-status-accepted"><i class="bi bi-check-circle"></i> Aprobado</span>`;
      } else if (row.estado_aprobacion === 'rejected') {
        statusHTML = `<span class="admin-status admin-status-rejected"><i class="bi bi-x-circle"></i> Rechazado</span>`;
      } else if (row.estado_aprobacion === 'deleted') {
        statusHTML = `<span class="admin-status admin-status-deleted"><i class="bi bi-trash3-fill"></i> Eliminado</span>`;
      } else {
        statusHTML = `<span class="admin-status admin-status-pending"><i class="bi bi-clock-history"></i> Pendiente</span>`;
      }

      // Sponsor logic for admin (only if pending)
      let adminSponsorHTML = '';
      if (config && config.permite_sponsor_alto_valor && row.estado_aprobacion === 'pending') {
        adminSponsorHTML = `
          <div class="admin-sponsor-block">
            <label>
              <input type="checkbox" id="sponsor_${row.id}">
              <span>Marcar como Patrocinio de Alto Valor (x1.5)</span>
            </label>
          </div>
        `;
      }

      let actionsHTML = '';
      if (row.estado_aprobacion === 'pending') {
        actionsHTML = `
          <div class="admin-notes-field">
            <label for="notas_${row.id}">Notas de auditoría (opcional)</label>
            <input type="text" id="notas_${row.id}" class="admin-text-input" placeholder="Ej: Excelente trabajo, o faltó adjuntar X...">
          </div>
        `;
      } else if (row.notas_admin) {
        actionsHTML = `
          <div class="admin-audit-note">
            <p class="admin-audit-note-label">Nota de Auditoría</p>
            <p class="admin-audit-note-text">"${row.notas_admin}"</p>
            ${row.reviewed_by ? `<p class="admin-audit-note-by"><i class="bi bi-person-fill"></i> Por: ${row.reviewed_by}</p>` : ''}
          </div>
        `;
      }

      let actionButtons = '';
      if (row.estado_aprobacion === 'pending') {
        actionButtons += `
          <div class="card-registro-btnrow">
            <button class="approve-btn admin-btn admin-btn-approve" data-id="${row.id}" data-base-pts="${row.puntos_solicitados}" data-sponsor-allowed="${config?.permite_sponsor_alto_valor}">
              <i class="bi bi-check-lg"></i> Aprobar
            </button>
            <button class="reject-btn admin-btn admin-btn-reject" data-id="${row.id}" data-email="${miembro.correo}" data-nombre="${miembro.nombre}" data-accion="${config?.accion}" data-pts="${row.puntos_solicitados}">
              <i class="bi bi-x-lg"></i> Rechazar
            </button>
          </div>
        `;
      }

      if (isManual && row.estado_aprobacion === 'approved') {
        actionButtons += `
          <button class="revoke-btn admin-btn-ghost-danger" data-id="${row.id}" data-cantidad="${manualSigned}" data-nombre="${miembro.nombre.replace(/"/g, '&quot;')}" data-motivo="${(row.notas_admin || '').replace(/"/g, '&quot;')}">
            <i class="bi bi-arrow-counterclockwise"></i> Anular Ajuste
          </button>
        `;
      } else {
        actionButtons += `
          <button class="delete-btn admin-btn-ghost-danger" data-id="${row.id}" ${row.estado_aprobacion === 'deleted' ? 'disabled' : ''}>
            <i class="bi bi-trash3-fill"></i> ${row.estado_aprobacion === 'deleted' ? 'Ya Eliminado' : 'Eliminar Registro'}
          </button>
        `;
      }

      // Media Handling
      const isImage = row.url_evidencia && row.url_evidencia.match(/\.(jpeg|jpg|gif|png|webp|heic|heif)(\?.*)?$/i) != null;
      const isPdf = row.url_evidencia && row.url_evidencia.match(/\.(pdf)(\?.*)?$/i) != null;

      let evidenciaMediaHTML = '';
      if (isImage) {
        evidenciaMediaHTML = `
          <div class="admin-evidence-frame">
            <a href="${row.url_evidencia}" target="_blank">
              <img src="${row.url_evidencia}" alt="Previsualización">
            </a>
            <div class="admin-evidence-caption">
              <a href="${row.url_evidencia}" target="_blank"><i class="bi bi-arrows-fullscreen"></i> Abrir Original</a>
            </div>
          </div>
        `;
      } else if (isPdf) {
        evidenciaMediaHTML = `
          <a href="${row.url_evidencia}" target="_blank" class="admin-evidence-link admin-evidence-link-pdf">
            <i class="bi bi-file-earmark-pdf-fill"></i> Abrir PDF Adjunto
          </a>
        `;
      } else if (row.url_evidencia) {
        evidenciaMediaHTML = `
          <a href="${row.url_evidencia}" target="_blank" class="admin-evidence-link">
            <i class="bi bi-box-arrow-up-right"></i> Abrir Enlace Externo
          </a>
        `;
      } else {
        evidenciaMediaHTML = `
          <div class="admin-evidence-empty">
            <i class="bi bi-slash-circle"></i> Sin evidencia adjunta
          </div>
        `;
      }

      const ptsBoxClass = isManual ? (manualIsAdd ? 'admin-pts-box admin-pts-box-add' : 'admin-pts-box admin-pts-box-sub') : 'admin-pts-box';

      card.innerHTML = `
        <div class="card-registro-content">
          <div class="card-registro-left">
            <div class="card-registro-titlerow">
              <h2 class="card-registro-title">${config ? config.accion : (manualIsAdd ? 'Ajuste manual (suma)' : 'Ajuste manual (resta)')}</h2>
              ${statusHTML}
              ${dynamicInfo}
            </div>
            <p class="card-registro-member">
              <strong>${miembro.nombre}</strong> <span style="color: #666;">(${miembro.correo})</span> • Cta: <span class="admin-cell-mono">${miembro.numero_cuenta}</span>
            </p>
            <p class="card-registro-date"><i class="bi bi-clock"></i> Enviado: ${date}</p>

            ${adminSponsorHTML}
            ${actionsHTML}
          </div>

          <div class="card-registro-right">
            ${evidenciaMediaHTML}

            <div class="${ptsBoxClass}">
              <p class="admin-pts-label">${isManual ? 'Ajuste de balance' : 'Puntos Solicitados'}</p>
              <p class="admin-pts-num" id="puntos_${row.id}">${isManual && manualIsAdd ? '+' : ''}${row.puntos_solicitados}</p>
            </div>

            ${actionButtons}
          </div>
        </div>
      `;
      list.appendChild(card);
    });

    // Attach event listeners to Sponsor checkbox to update visual points
    filteredRecords.forEach(row => {
      const config = row.leaderboard_config as any;
      if (config && config.permite_sponsor_alto_valor) {
        const check = document.getElementById(`sponsor_${row.id}`) as HTMLInputElement;
        const ptsEl = document.getElementById(`puntos_${row.id}`)!;
        check?.addEventListener('change', () => {
          if (check.checked) {
            ptsEl.textContent = Math.round(row.puntos_solicitados * 1.5).toString();
          } else {
            ptsEl.textContent = row.puntos_solicitados.toString();
          }
        });
      }
    });

    // Attach event listeners to buttons
    document.querySelectorAll('.approve-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-id')!;
        const basePts = parseInt(target.getAttribute('data-base-pts')!);
        const sponsorAllowed = target.getAttribute('data-sponsor-allowed') === 'true';

        let finalPts = basePts;
        if (sponsorAllowed) {
          const isHighValue = (document.getElementById(`sponsor_${id}`) as HTMLInputElement).checked;
          if (isHighValue) finalPts = Math.round(basePts * 1.5);
        }

        const notas = (document.getElementById(`notas_${id}`) as HTMLInputElement).value;
        await processAction('approve', id, finalPts, notas, target);
      });
    });

    document.querySelectorAll('.reject-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-id')!;
        const email = target.getAttribute('data-email')!;
        const nombre = target.getAttribute('data-nombre')!;
        const accionName = target.getAttribute('data-accion')!;
        const ptsSolicitados = parseInt(target.getAttribute('data-pts')!);
        const notas = (document.getElementById(`notas_${id}`) as HTMLInputElement).value;

        if (!notas) {
          alert('Por favor, agrega una nota explicando por qué se rechaza la evidencia.');
          return;
        }
        await processAction('reject', id, 0, notas, target, email, nombre, accionName, ptsSolicitados);
      });
    });

    document.querySelectorAll('.revoke-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-id')!;
        const cantidad = parseInt(target.getAttribute('data-cantidad') || '0');
        const nombre = target.getAttribute('data-nombre') || '';
        const motivoOriginal = target.getAttribute('data-motivo') || '(sin motivo registrado)';
        (window as any).__openRevoke?.(id, cantidad, nombre, motivoOriginal);
      });
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-id')!;

        const razon = prompt('Vas a ELIMINAR este registro de la base de datos (queda guardado en auditoría).\\nPor favor, escribe el motivo o tu nombre:');
        if (!razon) return; // Cancelado

        target.disabled = true;
        target.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Eliminando...';

        const { error } = await supabase.rpc('delete_puntos_registro', {
          p_registro_id: id,
          p_admin_email: sessionEmail,
          p_reason: razon
        });

        if (error) {
          alert(`Error al eliminar: ${error.message}`);
          target.disabled = false;
          target.innerHTML = '<i class="bi bi-trash3-fill"></i> Eliminar Registro';
        } else {
          await loadPending();
        }
      });
    });
  }

  async function processAction(action: 'approve' | 'reject', id: string, pts: number, notas: string, btnElement: HTMLButtonElement, email?: string, nombre?: string, accionName?: string, ptsSolicitados?: number) {
    btnElement.disabled = true;
    btnElement.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i>';

    const rpcName = action === 'approve' ? 'approve_puntos' : 'reject_puntos';
    const payload = action === 'approve'
      ? { p_registro_id: id, p_puntos_aprobados: pts, p_admin_email: sessionEmail, p_notas: notas }
      : { p_registro_id: id, p_admin_email: sessionEmail, p_notas: notas };

    const { error } = await supabase.rpc(rpcName, payload);

    if (error) {
      alert(`Error al procesar: ${error.message}`);
      btnElement.disabled = false;
      btnElement.innerHTML = action === 'approve' ? '<i class="bi bi-check-lg"></i> Aprobar' : '<i class="bi bi-x-lg"></i> Rechazar';
    } else {

      // If rejected, send the email via our new internal API
      if (action === 'reject' && email) {
        try {
          await fetch('/api/send-rejection', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              miembroEmail: email,
              miembroNombre: nombre,
              accion: accionName,
              notasAdmin: notas,
              puntosSolicitados: ptsSolicitados
            })
          });
        } catch (e) {
          console.error("Error enviando correo de rechazo:", e);
        }
      }

      await loadPending(); // Reload entirely to refresh UI safely
    }
  }

  document.addEventListener('DOMContentLoaded', async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (session?.user?.email) {
      sessionEmail = session.user.email;
      await loadPeriods();
      setupManualModal();
      setupRevokeModal();
      setupExportButton();
      setupToggleCerradoButton();
      setupConfigMenu();
    }
  });

  function setupConfigMenu() {
    const btn = document.getElementById('config-menu-btn') as HTMLButtonElement | null;
    const menu = document.getElementById('config-menu');
    const wrapper = document.getElementById('config-menu-wrapper');
    if (!btn || !menu || !wrapper) return;

    function open() {
      if (!menu || !btn) return;
      menu.style.display = 'block';
      btn.setAttribute('aria-expanded', 'true');
    }
    function close() {
      if (!menu || !btn) return;
      menu.style.display = 'none';
      btn.setAttribute('aria-expanded', 'false');
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = menu.style.display === 'block';
      isOpen ? close() : open();
    });

    // Cierra al hacer click fuera del menú
    document.addEventListener('click', (e) => {
      if (!wrapper.contains(e.target as Node)) close();
    });

    // Cierra con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    // Cierra cuando se selecciona un item
    menu.querySelectorAll('.config-menu-item').forEach(item => {
      item.addEventListener('click', () => close());
    });
  }

  function setupToggleCerradoButton() {
    const btn = document.getElementById('toggle-cerrado-btn') as HTMLButtonElement | null;
    if (!btn) return;

    btn.addEventListener('click', async () => {
      if (!selectedPeriodId) { alert('Selecciona un período primero.'); return; }

      const p = periodsCache.find(x => x.id === selectedPeriodId);
      const cerradoActual = !!p?.formularios_cerrados;
      const accion = cerradoActual ? 'REABRIR' : 'CERRAR';
      const detalle = cerradoActual
        ? 'Los miembros volverán a poder subir evidencias en este período.'
        : 'Los miembros ya no podrán subir nuevas evidencias en este período. Los admins seguirán pudiendo revisar, aprobar y ajustar los registros existentes.';

      const reversible = 'Puedes deshacer esta acción en cualquier momento desde este mismo menú.';

      if (!confirm(`¿${accion} los formularios de "${selectedPeriodName}"?\n\n${detalle}\n\n${reversible}`)) return;

      const original = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Guardando...';

      const { error } = await supabase.rpc('toggle_periodo_cerrado', {
        p_periodo_id: selectedPeriodId,
        p_admin_email: sessionEmail,
      });

      if (error) {
        alert('Error al cambiar el estado: ' + error.message);
        btn.disabled = false;
        btn.innerHTML = original;
        return;
      }

      // Refresh cache localmente sin recargar todo
      const idx = periodsCache.findIndex(x => x.id === selectedPeriodId);
      if (idx !== -1) periodsCache[idx].formularios_cerrados = !cerradoActual;
      btn.disabled = false;
      updateToggleButton();
    });
  }

  function setupExportButton() {
    const btn = document.getElementById('export-excel-btn') as HTMLButtonElement | null;
    if (!btn) return;
    const originalHTML = btn.innerHTML;

    btn.addEventListener('click', async () => {
      if (!selectedPeriodId) {
        alert('Selecciona un período primero.');
        return;
      }
      btn.disabled = true;
      btn.style.opacity = '0.7';
      btn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Generando...';
      try {
        const { exportLeaderboardToExcel } = await import('@lib/export-leaderboard');
        await exportLeaderboardToExcel(supabase, selectedPeriodId, selectedPeriodName || 'Periodo');
      } catch (e: any) {
        alert(e?.message || 'Error generando el Excel.');
        console.error(e);
      } finally {
        btn.disabled = false;
        btn.style.opacity = '1';
        btn.innerHTML = originalHTML;
      }
    });
  }

  const MIN_MOTIVO_LEN = 15;

  async function setupManualModal() {
    const addBtn = document.getElementById('open-add-btn') as HTMLButtonElement | null;
    const subBtn = document.getElementById('open-subtract-btn') as HTMLButtonElement | null;
    const modal = document.getElementById('manual-points-modal')!;
    const closeBtn = document.getElementById('close-manual-modal');
    const step1 = document.getElementById('manual-step-1')!;
    const step2 = document.getElementById('manual-step-2')!;
    const header = document.getElementById('manual-header')!;
    const titleEl = document.getElementById('manual-title')!;
    const subtitleEl = document.getElementById('manual-subtitle')!;
    const select = document.getElementById('manual-miembro-selector') as HTMLSelectElement;
    const puntosInput = document.getElementById('manual-puntos') as HTMLInputElement;
    const notasInput = document.getElementById('manual-notas') as HTMLTextAreaElement;
    const notasHint = document.getElementById('manual-notas-hint')!;
    const continueBtn = document.getElementById('continue-manual-btn') as HTMLButtonElement;
    const backBtn = document.getElementById('back-manual-btn') as HTMLButtonElement;
    const confirmBtn = document.getElementById('confirm-manual-btn') as HTMLButtonElement;
    const confirmWarning = document.getElementById('confirm-warning')!;
    const confirmSummary = document.getElementById('confirm-summary')!;
    const confirmMotivo = document.getElementById('confirm-motivo')!;
    const confirmAdmin = document.getElementById('confirm-admin')!;
    const confirmFecha = document.getElementById('confirm-fecha')!;

    let currentMode: 'suma' | 'resta' = 'suma';
    let miembrosMap: Record<string, { nombre: string; numero_cuenta: string }> = {};

    const { data: miembros } = await supabase
      .from('miembros_activos')
      .select('id, nombre, numero_cuenta')
      .order('nombre');
    if (miembros) {
      select.innerHTML = '<option value="">Selecciona un miembro...</option>' +
        miembros.map(m => `<option value="${m.id}">${m.nombre}${m.numero_cuenta ? ' (' + m.numero_cuenta + ')' : ''}</option>`).join('');
      miembros.forEach(m => { miembrosMap[m.id] = { nombre: m.nombre, numero_cuenta: m.numero_cuenta || '—' }; });
    }

    function applyModeStyles() {
      const isSuma = currentMode === 'suma';
      const color = isSuma ? '#065f46' : '#991b1b';
      const bg = isSuma ? '#d1fae5' : '#fee2e2';
      const icon = isSuma ? 'bi-plus-circle-fill' : 'bi-dash-circle-fill';
      const verbUpper = isSuma ? 'Sumar' : 'Restar';
      const verbLower = isSuma ? 'sumarán' : 'restarán';
      const prep = isSuma ? 'al' : 'del';

      header.style.background = bg;
      header.style.borderColor = '#000';
      titleEl.innerHTML = `<i class="bi ${icon}" style="color: ${color};"></i> ${verbUpper.toUpperCase()} PUNTOS MANUALES`;
      subtitleEl.textContent = `Los puntos se ${verbLower} ${prep} balance del miembro seleccionado.`;

      confirmWarning.style.background = bg;
      confirmWarning.style.borderColor = '#000';
      confirmWarning.style.color = color;

      confirmBtn.style.background = color;
    }

    function resetForm() {
      goToStep(1);
      select.value = '';
      puntosInput.value = '';
      notasInput.value = '';
      updateHint();
    }

    function goToStep(n: 1 | 2) {
      step1.style.display = n === 1 ? 'flex' : 'none';
      step2.style.display = n === 2 ? 'flex' : 'none';
    }

    function updateHint() {
      const len = notasInput.value.trim().length;
      notasHint.textContent = `${len} / ${MIN_MOTIVO_LEN} caracteres mínimos`;
      notasHint.style.color = len >= MIN_MOTIVO_LEN ? '#065f46' : '#888';
    }

    function openModal(mode: 'suma' | 'resta') {
      currentMode = mode;
      applyModeStyles();
      resetForm();
      modal.style.display = 'flex';
    }

    function closeModal() {
      modal.style.display = 'none';
    }

    addBtn?.addEventListener('click', () => openModal('suma'));
    subBtn?.addEventListener('click', () => openModal('resta'));
    closeBtn?.addEventListener('click', closeModal);
    notasInput.addEventListener('input', updateHint);

    continueBtn.addEventListener('click', () => {
      const miembroId = select.value;
      const cantidad = parseInt(puntosInput.value);
      const motivo = notasInput.value.trim();

      if (!miembroId) { alert('Selecciona un miembro.'); return; }
      if (isNaN(cantidad) || cantidad <= 0) { alert('La cantidad debe ser un entero positivo.'); return; }
      if (motivo.length < MIN_MOTIVO_LEN) {
        alert(`El motivo debe tener al menos ${MIN_MOTIVO_LEN} caracteres para auditoría.`);
        return;
      }

      const m = miembrosMap[miembroId];
      const verb = currentMode === 'suma' ? 'SUMAR' : 'RESTAR';
      confirmSummary.innerHTML = `Vas a <strong>${verb} ${cantidad} puntos</strong> ${currentMode === 'suma' ? 'a' : 'de'} <strong>${m.nombre}</strong> (cuenta ${m.numero_cuenta}).`;
      confirmMotivo.textContent = `"${motivo}"`;
      confirmAdmin.textContent = sessionEmail;
      confirmFecha.textContent = new Date().toLocaleString('es-MX');
      goToStep(2);
    });

    backBtn.addEventListener('click', () => goToStep(1));

    confirmBtn.addEventListener('click', async () => {
      const miembroId = select.value;
      const cantidad = parseInt(puntosInput.value);
      const motivo = notasInput.value.trim();

      confirmBtn.disabled = true;
      backBtn.disabled = true;
      const originalHTML = confirmBtn.innerHTML;
      confirmBtn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Guardando...';

      const { error } = await supabase.rpc('insert_ajuste_manual', {
        p_miembro_id: miembroId,
        p_tipo: currentMode,
        p_cantidad: cantidad,
        p_admin_email: sessionEmail,
        p_motivo: motivo,
      });

      if (error) {
        alert('Error aplicando el ajuste: ' + error.message);
        confirmBtn.disabled = false;
        backBtn.disabled = false;
        confirmBtn.innerHTML = originalHTML;
        return;
      }

      closeModal();
      await loadPending();
    });
  }

  function setupRevokeModal() {
    const modal = document.getElementById('revoke-modal')!;
    const closeBtn = document.getElementById('close-revoke-modal');
    const cancelBtn = document.getElementById('cancel-revoke-btn');
    const confirmBtn = document.getElementById('confirm-revoke-btn') as HTMLButtonElement;
    const motivoInput = document.getElementById('revoke-motivo') as HTMLTextAreaElement;
    const motivoHint = document.getElementById('revoke-motivo-hint')!;
    const summary = document.getElementById('revoke-summary')!;

    let currentRegistroId = '';

    function updateHint() {
      const len = motivoInput.value.trim().length;
      motivoHint.textContent = `${len} / ${MIN_MOTIVO_LEN} caracteres mínimos`;
      motivoHint.style.color = len >= MIN_MOTIVO_LEN ? '#065f46' : '#888';
    }

    function close() { modal.style.display = 'none'; }

    (window as any).__openRevoke = (id: string, cantidad: number, nombre: string, motivoOriginal: string) => {
      currentRegistroId = id;
      const signo = cantidad >= 0 ? '+' : '';
      summary.innerHTML = `Vas a anular el ajuste manual <strong>${signo}${cantidad} pts</strong> de <strong>${nombre}</strong>.<br><span style="color:#666;font-size:0.85rem;">Motivo original: "${motivoOriginal}"</span>`;
      motivoInput.value = '';
      updateHint();
      modal.style.display = 'flex';
    };

    motivoInput.addEventListener('input', updateHint);
    closeBtn?.addEventListener('click', close);
    cancelBtn?.addEventListener('click', close);

    confirmBtn.addEventListener('click', async () => {
      const motivo = motivoInput.value.trim();
      if (motivo.length < MIN_MOTIVO_LEN) {
        alert(`El motivo de la anulación debe tener al menos ${MIN_MOTIVO_LEN} caracteres.`);
        return;
      }

      confirmBtn.disabled = true;
      const originalHTML = confirmBtn.innerHTML;
      confirmBtn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i>';

      const { error } = await supabase.rpc('revocar_ajuste_manual', {
        p_registro_id: currentRegistroId,
        p_admin_email: sessionEmail,
        p_motivo_revocacion: motivo,
      });

      if (error) {
        alert('Error anulando el ajuste: ' + error.message);
        confirmBtn.disabled = false;
        confirmBtn.innerHTML = originalHTML;
        return;
      }

      close();
      await loadPending();
    });
  }
</script>
