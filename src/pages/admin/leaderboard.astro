        const razon = prompt('Vas a ELIMINAR este registro de la base de datos (queda guardado en auditoría).\\nPor favor, escribe el motivo o tu nombre:');
        if (!razon) return; // Cancelado
        
        target.disabled = true;
        target.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Eliminando...';

        const { error } = await supabase.rpc('delete_puntos_registro', {
          p_registro_id: id,
          p_admin_email: sessionEmail,
          p_reason: razon
        });

