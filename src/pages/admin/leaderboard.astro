        if (!notas) {
          alert('Por favor, agrega una nota explicando por qué se rechaza la evidencia.');
          return;
        }
        await processAction('reject', id, 0, notas, target, email, nombre, accionName, ptsSolicitados);
      });
    });

    document.querySelectorAll('.revoke-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-id')!;
