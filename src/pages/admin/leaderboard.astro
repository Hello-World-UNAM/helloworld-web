---
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Revisión Leaderboard | Admin">
  <style is:global>
    .filters-wrapper { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; width: 100%; }

    .config-menu-item:hover { background: #f9f3ff; }
    .config-menu-item:active { background: #efe6ff; }
    #config-menu-btn:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 #000; }
    @media (max-width: 640px) {
      #config-menu { right: auto; left: 0; min-width: 260px; }
    }
    .filter-group { display: flex; gap: 0.5rem; align-items: center; }
    .search-wrapper { flex: 1; min-width: 250px; position: relative; }
    
    .card-registro-content { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; flex-wrap: wrap; }
    .card-registro-left { flex: 1; min-width: 300px; }
    .card-registro-right { width: 320px; display: flex; flex-direction: column; gap: 0.8rem; }
    
    @media (max-width: 768px) {
      .filters-wrapper { flex-direction: column; align-items: stretch; }
      .filter-group { flex-direction: column; align-items: flex-start; width: 100%; gap: 0.3rem; }
      .filter-group select { width: 100%; }
      .search-wrapper { min-width: 100%; width: 100%; }
      
      .card-registro { padding: 1.2rem !important; gap: 1rem !important; }
      .card-registro-left { min-width: 100%; margin-bottom: 1.5rem; }
      .card-registro-right { width: 100%; }
      .card-registro-content { gap: 1.5rem; }
    }
  </style>

  <div class="admin-header-flex" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
      <div>
        <h1 class="admin-page-title" style="margin-bottom: 0.5rem;"><i class="bi bi-award"></i> Revisión de Puntos</h1>
        <p class="admin-page-subtitle">Audita y aprueba las evidencias subidas por los miembros.</p>
      </div>

      <!-- Menú Configuración (colapsa todas las acciones) -->
      <div id="config-menu-wrapper" style="position: relative;">
        <button id="config-menu-btn" aria-haspopup="menu" aria-expanded="false" style="background: #6225e6; color: #fff; padding: 0.6rem 1.2rem; border: 2px solid #000; border-radius: 6px; font-weight: 800; text-transform: uppercase; cursor: pointer; box-shadow: 3px 3px 0 #000; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.5rem;">
          <i class="bi bi-gear-fill"></i> Configuración <i class="bi bi-chevron-down" style="font-size: 0.75rem;"></i>
        </button>

        <div id="config-menu" role="menu" style="display: none; position: absolute; top: calc(100% + 8px); right: 0; min-width: 280px; background: #fff; border: 2px solid #000; border-radius: 8px; box-shadow: 6px 6px 0 #6225e6; z-index: 500; padding: 0.4rem;">
          <!-- Ajustes manuales -->
          <p style="margin: 0.6rem 0.8rem 0.3rem; font-size: 0.7rem; font-weight: 800; color: #6225e6; text-transform: uppercase; letter-spacing: 0.5px;">Ajustes manuales</p>
          <button id="open-add-btn" role="menuitem" data-mode="suma" class="config-menu-item" style="width: 100%; text-align: left; background: transparent; color: #065f46; padding: 0.7rem 0.8rem; border: none; border-radius: 6px; font-weight: 700; font-family: inherit; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.7rem;">
            <i class="bi bi-plus-circle-fill" style="color: #10b981; font-size: 1.1rem;"></i> Sumar puntos manuales
          </button>
          <button id="open-subtract-btn" role="menuitem" data-mode="resta" class="config-menu-item" style="width: 100%; text-align: left; background: transparent; color: #991b1b; padding: 0.7rem 0.8rem; border: none; border-radius: 6px; font-weight: 700; font-family: inherit; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.7rem;">
            <i class="bi bi-dash-circle-fill" style="color: #ef4444; font-size: 1.1rem;"></i> Restar puntos manuales
          </button>

          <hr style="margin: 0.4rem 0.3rem; border: none; border-top: 1px dashed #ddd;">

          <!-- Registro del semestre -->
          <p style="margin: 0.6rem 0.8rem 0.3rem; font-size: 0.7rem; font-weight: 800; color: #6225e6; text-transform: uppercase; letter-spacing: 0.5px;">Registro del semestre</p>
          <button id="toggle-cerrado-btn" role="menuitem" class="config-menu-item" title="Cerrar o reabrir los formularios del período seleccionado para el registro de evidencias." style="width: 100%; text-align: left; background: transparent; color: #000; padding: 0.7rem 0.8rem; border: none; border-radius: 6px; font-weight: 700; font-family: inherit; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.7rem;">
            <i class="bi bi-lock-fill" style="color: #000; font-size: 1.1rem;" id="toggle-cerrado-icon"></i> <span id="toggle-cerrado-label">Cerrar formularios</span>
          </button>

          <hr style="margin: 0.4rem 0.3rem; border: none; border-top: 1px dashed #ddd;">

          <!-- Reportes -->
          <p style="margin: 0.6rem 0.8rem 0.3rem; font-size: 0.7rem; font-weight: 800; color: #6225e6; text-transform: uppercase; letter-spacing: 0.5px;">Reportes</p>
          <button id="export-excel-btn" role="menuitem" class="config-menu-item" title="Descarga un Excel con las evidencias aprobadas del período seleccionado, agrupadas por miembro y ordenadas de mayor a menor puntaje." style="width: 100%; text-align: left; background: transparent; color: #000; padding: 0.7rem 0.8rem; border: none; border-radius: 6px; font-weight: 700; font-family: inherit; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.7rem;">
            <i class="bi bi-file-earmark-excel-fill" style="color: #6225e6; font-size: 1.1rem;"></i> Exportar Excel para Jefatura
          </button>
        </div>
      </div>
    </div>
    <div class="filters-wrapper">
      <div class="search-wrapper">
        <i class="bi bi-search" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: #555; font-weight: bold;"></i>
        <input type="text" id="search-input" placeholder="Buscar por nombre, cuenta o correo..." style="width: 100%; padding: 0.6rem 1rem 0.6rem 2.5rem; border: 2px solid #000; border-radius: 6px; font-weight: 500; font-family: inherit; font-size: 0.95rem; box-shadow: 2px 2px 0 rgba(0,0,0,0.1);">
      </div>
      <div class="filter-group">
        <label style="font-weight: 700; color: #555; font-size: 0.95rem;">Ordenar:</label>
        <select id="sort-selector" style="padding: 0.6rem 1.2rem; border: 2px solid #000; border-radius: 6px; background: #fff; font-weight: 800; font-family: inherit; font-size: 0.95rem; cursor: pointer; box-shadow: 2px 2px 0 #000;">
          <option value="desc" selected>Más recientes</option>
          <option value="asc">Más antiguos</option>
        </select>
      </div>
      <div class="filter-group">
        <label style="font-weight: 700; color: #555; font-size: 0.95rem;">Estado:</label>
        <select id="status-selector" style="padding: 0.6rem 1.2rem; border: 2px solid #000; border-radius: 6px; background: #fff; font-weight: 800; font-family: inherit; font-size: 0.95rem; cursor: pointer; box-shadow: 2px 2px 0 #000;">
          <option value="pending" selected>Pendientes</option>
          <option value="approved">Aprobados</option>
          <option value="rejected">Rechazados</option>
          <option value="deleted">Eliminados</option>
          <option value="all">Todos</option>
        </select>
      </div>
      <div class="filter-group">
        <label style="font-weight: 700; color: #555; font-size: 0.95rem;">Semestre:</label>
        <select id="period-selector" style="padding: 0.6rem 1.2rem; border: 2px solid #000; border-radius: 6px; background: #fff; font-weight: 800; font-family: inherit; font-size: 0.95rem; cursor: pointer; box-shadow: 2px 2px 0 #000;">
          <option value="">Cargando...</option>
        </select>
      </div>
    </div>
  </div>

  <div id="pending-list" style="display: grid; gap: 1.5rem;">
    <!-- Populated by JS -->
    <div id="loading" style="text-align: center; padding: 3rem;">
      <i class="bi bi-arrow-clockwise admin-redirect-spin" style="font-size: 2rem;"></i>
      <p style="margin-top: 1rem; color: var(--color-text-muted);">Cargando solicitudes pendientes...</p>
    </div>
    
    <div id="empty-state" style="display: none; text-align: center; padding: 4rem; background: var(--color-surface); border-radius: 12px; border: 1px dashed var(--color-border);">
      <i class="bi bi-check-circle" style="font-size: 3rem; color: #22c55e;"></i>
      <h2 style="margin-top: 1rem;">¡Todo al día!</h2>
      <p style="color: var(--color-text-muted);">No hay evidencias pendientes por revisar.</p>
    </div>
  </div>

  <!-- Modal Ajustes Manuales (2 pasos) -->
  <div id="manual-points-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(4px); padding: 1rem;">
    <div style="background: #fff; width: 100%; max-width: 540px; padding: 2rem; border-radius: 12px; border: 3px solid #000; box-shadow: 8px 8px 0 #6225e6; position: relative; max-height: 90vh; overflow-y: auto;">
      <button id="close-manual-modal" style="position: absolute; top: 1rem; right: 1rem; background: transparent; border: none; font-size: 1.5rem; cursor: pointer; color: #000;" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>

      <!-- Header dinámico según modo -->
      <div id="manual-header" style="margin-bottom: 1.5rem; padding: 1rem 1.2rem; border: 3px solid #000; border-radius: 8px;">
        <h2 id="manual-title" style="font-size: 1.4rem; font-weight: 900; margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">Sumar Puntos Manuales</h2>
        <p id="manual-subtitle" style="margin: 0.3rem 0 0; font-size: 0.85rem; font-weight: 600; opacity: 0.9;">Se sumarán al balance del miembro seleccionado.</p>
      </div>

      <!-- PASO 1: captura -->
      <div id="manual-step-1" style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
          <label style="display: block; font-weight: 700; margin-bottom: 0.5rem; color: #333;">Miembro</label>
          <select id="manual-miembro-selector" style="width: 100%; padding: 0.8rem; border: 2px solid #000; border-radius: 6px; font-weight: 600; font-family: inherit;">
            <option value="">Selecciona un miembro...</option>
          </select>
        </div>

        <div>
          <label style="display: block; font-weight: 700; margin-bottom: 0.5rem; color: #333;">Cantidad de puntos <span style="color: #666; font-weight: 500;">(entero positivo)</span></label>
          <input type="number" id="manual-puntos" min="1" step="1" placeholder="Ej: 500" style="width: 100%; padding: 0.8rem; border: 2px solid #000; border-radius: 6px; font-weight: 600; font-family: inherit;">
        </div>

        <div>
          <label style="display: block; font-weight: 700; margin-bottom: 0.5rem; color: #333;">Motivo <span style="color: #666; font-weight: 500;">(mínimo 15 caracteres — auditoría)</span></label>
          <textarea id="manual-notas" placeholder="Ej: Ganó 1er lugar hackathon UNAM 2026" rows="3" style="width: 100%; padding: 0.8rem; border: 2px solid #000; border-radius: 6px; font-weight: 500; font-family: inherit; resize: vertical; min-height: 80px;"></textarea>
          <p id="manual-notas-hint" style="margin: 0.3rem 0 0; font-size: 0.75rem; color: #888;">0 / 15 caracteres mínimos</p>
        </div>

        <button id="continue-manual-btn" style="margin-top: 0.5rem; width: 100%; padding: 1rem; background: #000; color: #fff; border: 2px solid #000; border-radius: 6px; font-weight: 800; text-transform: uppercase; cursor: pointer; box-shadow: 3px 3px 0 #6225e6; font-size: 1rem;">
          Continuar <i class="bi bi-arrow-right"></i>
        </button>
      </div>

      <!-- PASO 2: confirmación -->
      <div id="manual-step-2" style="display: none; flex-direction: column; gap: 1rem;">
        <div id="confirm-warning" style="padding: 1rem 1.2rem; border-radius: 8px; border: 2px solid; font-size: 0.9rem;">
          <p style="margin: 0 0 0.4rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;"><i class="bi bi-exclamation-triangle-fill"></i> Confirmar operación</p>
          <p id="confirm-summary" style="margin: 0; font-weight: 600;"></p>
        </div>

        <div style="background: #f9f3ff; padding: 1rem 1.2rem; border-radius: 8px; border: 2px solid #6225e6;">
          <p style="margin: 0 0 0.6rem; font-size: 0.75rem; font-weight: 800; color: #6225e6; text-transform: uppercase;">Motivo</p>
          <p id="confirm-motivo" style="margin: 0 0 1rem; font-style: italic; color: #333; font-size: 0.95rem;"></p>

          <p style="margin: 0 0 0.3rem; font-size: 0.75rem; font-weight: 800; color: #6225e6; text-transform: uppercase;">Registrado por</p>
          <p id="confirm-admin" style="margin: 0 0 0.6rem; font-size: 0.85rem; color: #333;"></p>

          <p style="margin: 0 0 0.3rem; font-size: 0.75rem; font-weight: 800; color: #6225e6; text-transform: uppercase;">Fecha</p>
          <p id="confirm-fecha" style="margin: 0; font-size: 0.85rem; color: #333;"></p>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin-top: 0.5rem;">
          <button id="back-manual-btn" style="padding: 0.9rem; background: #fff; color: #000; border: 2px solid #000; border-radius: 6px; font-weight: 800; text-transform: uppercase; cursor: pointer; font-size: 0.9rem;">
            <i class="bi bi-arrow-left"></i> Volver
          </button>
          <button id="confirm-manual-btn" style="padding: 0.9rem; color: #fff; border: 2px solid #000; border-radius: 6px; font-weight: 800; text-transform: uppercase; cursor: pointer; box-shadow: 3px 3px 0 #000; font-size: 0.9rem;">
            Confirmar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Revocar Ajuste Manual -->
  <div id="revoke-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1001; align-items: center; justify-content: center; backdrop-filter: blur(4px); padding: 1rem;">
    <div style="background: #fff; width: 100%; max-width: 500px; padding: 2rem; border-radius: 12px; border: 3px solid #000; box-shadow: 8px 8px 0 #ef4444; position: relative;">
      <button id="close-revoke-modal" style="position: absolute; top: 1rem; right: 1rem; background: transparent; border: none; font-size: 1.5rem; cursor: pointer; color: #000;" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
      <h2 style="font-size: 1.3rem; font-weight: 900; margin-top: 0; margin-bottom: 0.5rem; text-transform: uppercase; color: #b91c1c;"><i class="bi bi-arrow-counterclockwise"></i> Anular ajuste manual</h2>
      <p id="revoke-summary" style="margin: 0 0 1.2rem; font-size: 0.9rem; color: #444;"></p>

      <label style="display: block; font-weight: 700; margin-bottom: 0.5rem; color: #333;">Motivo de la anulación <span style="color: #666; font-weight: 500;">(mínimo 15 caracteres)</span></label>
      <textarea id="revoke-motivo" placeholder="Ej: Se comprobó que no cumplió los requisitos del premio." rows="3" style="width: 100%; padding: 0.8rem; border: 2px solid #000; border-radius: 6px; font-weight: 500; font-family: inherit; resize: vertical; min-height: 80px;"></textarea>
      <p id="revoke-motivo-hint" style="margin: 0.3rem 0 1rem; font-size: 0.75rem; color: #888;">0 / 15 caracteres mínimos</p>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem;">
        <button id="cancel-revoke-btn" style="padding: 0.9rem; background: #fff; color: #000; border: 2px solid #000; border-radius: 6px; font-weight: 800; text-transform: uppercase; cursor: pointer; font-size: 0.9rem;">
          Cancelar
        </button>
        <button id="confirm-revoke-btn" style="padding: 0.9rem; background: #ef4444; color: #fff; border: 2px solid #000; border-radius: 6px; font-weight: 800; text-transform: uppercase; cursor: pointer; box-shadow: 3px 3px 0 #000; font-size: 0.9rem;">
          Anular
        </button>
      </div>
    </div>
  </div>

</AdminLayout>

<script>
  import { supabase } from '@lib/supabase';

  let sessionEmail = '';
  let selectedPeriodId = '';
  let selectedPeriodName = '';
  let selectedStatus = 'pending';
  let searchQuery = '';
  let sortOrder = 'desc';
  let periodsCache: any[] = [];

  function updateSelectedPeriodName() {
    const p = periodsCache.find(x => x.id === selectedPeriodId);
    selectedPeriodName = p?.nombre || '';
    updateToggleButton();
  }

  function updateToggleButton() {
    const label = document.getElementById('toggle-cerrado-label');
    const icon = document.getElementById('toggle-cerrado-icon');
    if (!label || !icon) return;
    const p = periodsCache.find(x => x.id === selectedPeriodId);
    const cerrado = !!p?.formularios_cerrados;
    if (cerrado) {
      icon.className = 'bi bi-unlock-fill';
      icon.style.color = '#ca8a04';
      label.textContent = 'Reabrir formularios';
    } else {
      icon.className = 'bi bi-lock-fill';
      icon.style.color = '#000';
      label.textContent = 'Cerrar formularios';
    }
  }

  async function loadPeriods() {
    const selector = document.getElementById('period-selector') as HTMLSelectElement;
    const statusSelector = document.getElementById('status-selector') as HTMLSelectElement;

    const { data: periodos, error } = await supabase
      .from('periodos')
      .select('id, nombre, es_activo, formularios_cerrados, cerrado_at, cerrado_por')
      .order('created_at', { ascending: false });

    if (error || !periodos) return;

    periodsCache = periodos;

    selector.innerHTML = periodos.map(p =>
      `<option value="${p.id}" ${p.es_activo ? 'selected' : ''}>${p.nombre} ${p.es_activo ? '(Activo)' : ''}</option>`
    ).join('');

    selectedPeriodId = selector.value;
    selectedStatus = statusSelector.value;
    updateSelectedPeriodName();

    selector.addEventListener('change', (e) => {
      selectedPeriodId = (e.target as HTMLSelectElement).value;
      updateSelectedPeriodName();
      loadPending();
    });

    statusSelector.addEventListener('change', (e) => {
      selectedStatus = (e.target as HTMLSelectElement).value;
      loadPending();
    });

    document.getElementById('sort-selector')?.addEventListener('change', (e) => {
      sortOrder = (e.target as HTMLSelectElement).value;
      loadPending();
    });

    let searchTimeout: any = null;
    document.getElementById('search-input')?.addEventListener('input', (e) => {
      clearTimeout(searchTimeout);
      searchQuery = (e.target as HTMLInputElement).value.trim();
      searchTimeout = setTimeout(() => {
        loadPending();
      }, 400); // 400ms debounce
    });

    // Call loadPending initially
    loadPending();
  }

  async function loadPending() {
    const list = document.getElementById('pending-list')!;
    const loading = document.getElementById('loading')!;
    const empty = document.getElementById('empty-state')!;

    // Reset view
    list.querySelectorAll('.card-registro').forEach(el => el.remove());
    loading.style.display = 'block';
    empty.style.display = 'none';

    let query = supabase
      .from('puntos_registros')
      .select(`
        id, created_at, horas_reportadas, es_evento_externo, url_evidencia, puntos_solicitados, estado_aprobacion, notas_admin, reviewed_by,
        miembros_activos!inner(nombre, correo, numero_cuenta),
        leaderboard_config(accion, permite_sponsor_alto_valor, multiplicador_externo)
      `)
      .eq('periodo_id', selectedPeriodId);

    if (selectedStatus !== 'all') {
      query = query.eq('estado_aprobacion', selectedStatus);
    }

    const { data: records, error } = await query.order('created_at', { ascending: sortOrder === 'asc' });

    loading.style.display = 'none';

    if (error) {
      console.error(error);
      alert('Error cargando solicitudes.');
      return;
    }

    let filteredRecords = records || [];
    
    if (searchQuery) {
      const q = searchQuery.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      filteredRecords = filteredRecords.filter(row => {
        const miembro = row.miembros_activos as any;
        const nombre = (miembro?.nombre || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const correo = (miembro?.correo || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const cuenta = (miembro?.numero_cuenta || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        return nombre.includes(q) || correo.includes(q) || cuenta.includes(q);
      });
    }

    if (filteredRecords.length === 0) {
      empty.style.display = 'block';
      return;
    }

    filteredRecords.forEach(row => {
      const card = document.createElement('div');
      card.className = 'card-registro';
      card.style.cssText = 'background: #fff; border: 2px solid #000; border-radius: 12px; padding: 2rem; display: flex; flex-direction: column; gap: 1.5rem; box-shadow: 6px 6px 0 #6225e6; margin-bottom: 1rem; transition: transform 0.2s;';
      
      const miembro = row.miembros_activos as any;
      const config = row.leaderboard_config as any;
      const isManual = !config;
      const manualSigned = row.puntos_solicitados;
      const manualIsAdd = manualSigned >= 0;
      const date = new Date(row.created_at).toLocaleString('es-MX');

      let dynamicInfo = '';
      if (row.horas_reportadas) dynamicInfo += `<span style="background: #f3e8ff; color: #6b21a8; font-size: 0.75rem; border: 1.5px solid #d8b4fe; border-radius: 4px; padding: 0.3rem 0.6rem; font-weight: 700; text-transform: uppercase;">${row.horas_reportadas} hrs reportadas</span>`;
      if (row.es_evento_externo && config) dynamicInfo += `<span style="background: #fef08a; color: #854d0e; font-size: 0.75rem; border: 1.5px solid #fde047; border-radius: 4px; padding: 0.3rem 0.6rem; font-weight: 700; text-transform: uppercase;">Evento Externo (x${config.multiplicador_externo})</span>`;
      if (isManual) {
        const badgeColor = manualIsAdd ? '#10b981' : '#ef4444';
        const badgeBg = manualIsAdd ? 'rgba(16, 185, 129, 0.12)' : 'rgba(239, 68, 68, 0.12)';
        const badgeIcon = manualIsAdd ? 'bi-plus-circle-fill' : 'bi-dash-circle-fill';
        const badgeLabel = manualIsAdd ? 'MANUAL · SUMA' : 'MANUAL · RESTA';
        dynamicInfo += `<span style="background: ${badgeBg}; color: ${badgeColor}; font-size: 0.75rem; border: 1.5px solid ${badgeColor}; border-radius: 4px; padding: 0.3rem 0.6rem; font-weight: 800; text-transform: uppercase;"><i class="bi ${badgeIcon}"></i> ${badgeLabel}</span>`;
      }

      // Status Badge
      let statusHTML = '';
      if (row.estado_aprobacion === 'approved') {
        statusHTML = `<span style="background: rgba(34, 197, 94, 0.15); color: #16a34a; padding: 0.3rem 0.6rem; border: 1.5px solid #16a34a; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; border-radius: 4px;"><i class="bi bi-check-circle"></i> Aprobado</span>`;
      } else if (row.estado_aprobacion === 'rejected') {
