---
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Gestión de Periodos | Admin" activeNav="periodos">
  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-title">
        <span class="admin-title-icon"><i class="bi bi-calendar-range"></i></span>
        Periodos y semestres
      </h1>
      <p class="admin-page-subtitle">Crea nuevos semestres y elige cuál es el activo actualmente.</p>
    </div>
    <div class="admin-page-actions">
      <button id="btn-new-period" class="admin-btn admin-btn-purple">
        <i class="bi bi-plus-lg"></i> Nuevo periodo
      </button>
    </div>
  </div>

  <div class="admin-info-banner" style="margin-bottom: 26px;">
    <i class="bi bi-shield-check"></i>
    <div>
      <h4>El historial es seguro</h4>
      <p>Al marcar un semestre pasado como "Activo", los alumnos subirán evidencias amarradas a ese semestre histórico. <strong>Ningún punto pasado se perderá o sobrescribirá</strong>. Para volver a la normalidad, simplemente marca el semestre en curso como activo nuevamente.</p>
    </div>
  </div>

  <div id="new-period-form" class="admin-inline-form" style="display: none;">
    <h3><i class="bi bi-calendar-plus"></i> Crear nuevo periodo</h3>
    <form id="form-create-period" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;">
      <div style="flex: 1; min-width: 180px;">
        <label class="admin-field-label" for="input-period-id" style="margin-top: 0;">ID del periodo</label>
        <select id="input-period-id" class="admin-select admin-select-block" required>
          <option value="2027-1">2027-1</option>
          <option value="2027-2">2027-2</option>
          <option value="2028-1">2028-1</option>
          <option value="2028-2">2028-2</option>
          <option value="2029-1">2029-1</option>
        </select>
      </div>
      <div style="flex: 2; min-width: 220px;">
        <label class="admin-field-label" for="input-period-name" style="margin-top: 0;">Nombre descriptivo (automático)</label>
        <input type="text" id="input-period-name" readonly required class="admin-text-input" style="background: #f5f5f5; color: #666; cursor: not-allowed;" value="Semestre 2027-1">
      </div>
      <button type="submit" class="admin-btn admin-btn-purple">
        Guardar
      </button>
      <button type="button" id="btn-cancel-new" class="admin-btn">
        Cancelar
      </button>
    </form>
  </div>

  <div id="loading" class="admin-redirect" style="min-height: 30vh;">
    <i class="bi bi-arrow-clockwise admin-redirect-spin"></i>
    <p>Cargando periodos...</p>
  </div>

  <div id="periods-list" style="display: grid; gap: 1.2rem;">
    <!-- Populated by JS -->
  </div>

</AdminLayout>

<script>
  import { supabase } from '@lib/supabase';

  const btnNewPeriod = document.getElementById('btn-new-period')!;
  const btnCancelNew = document.getElementById('btn-cancel-new')!;
  const formContainer = document.getElementById('new-period-form')!;
  const formCreate = document.getElementById('form-create-period') as HTMLFormElement;
  const idInput = document.getElementById('input-period-id') as HTMLSelectElement;
  const nameInput = document.getElementById('input-period-name') as HTMLInputElement;

  idInput.addEventListener('change', () => {
    nameInput.value = `Semestre ${idInput.value}`;
  });

  btnNewPeriod.addEventListener('click', () => {
    formContainer.style.display = 'block';
    btnNewPeriod.style.display = 'none';
  });

  btnCancelNew.addEventListener('click', () => {
    formContainer.style.display = 'none';
    btnNewPeriod.style.display = '';
    formCreate.reset();
  });

  formCreate.addEventListener('submit', async (e) => {
    e.preventDefault();

    const { error } = await supabase.from('periodos').insert({
      id: idInput.value.trim(),
      nombre: nameInput.value.trim(),
      es_activo: false
    });

    if (error) {
      alert('Error al crear periodo: ' + error.message);
      return;
    }

    formCreate.reset();
    formContainer.style.display = 'none';
    btnNewPeriod.style.display = '';
    loadPeriods();
  });

  async function loadPeriods() {
    const list = document.getElementById('periods-list')!;
    const loading = document.getElementById('loading')!;

    list.innerHTML = '';
    loading.style.display = 'flex';

    const { data: periodos, error } = await supabase
      .from('periodos')
      .select('*')
      .order('created_at', { ascending: false });

    loading.style.display = 'none';

    if (error || !periodos) {
      alert('Error cargando periodos.');
      return;
    }

    periodos.forEach(p => {
      const card = document.createElement('div');
      card.className = `admin-period-card ${p.es_activo ? 'admin-period-card-active' : ''}`;

      const statusBadge = p.es_activo
        ? `<span class="admin-period-badge"><i class="bi bi-star-fill"></i> Activo actual</span>`
        : `<span class="admin-period-badge admin-period-badge-inactive">Inactivo</span>`;

      const actionBtn = p.es_activo
        ? ``
        : `<button class="set-active-btn admin-btn" data-id="${p.id}" style="font-size: 0.8rem; padding: 9px 14px;"><i class="bi bi-check-circle"></i> Marcar activo</button>`;

      card.innerHTML = `
        <div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 2px; flex-wrap: wrap;">
            <h2 class="admin-period-name">${p.nombre}</h2>
            ${statusBadge}
          </div>
          <p class="admin-period-id"><i class="bi bi-hash"></i>${p.id}</p>
        </div>
        <div>
          ${actionBtn}
        </div>
      `;
      list.appendChild(card);
    });

    document.querySelectorAll('.set-active-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
        if (confirm(`¿Estás seguro de que deseas marcar el periodo "${id}" como activo? Esto cerrará el periodo anterior.`)) {
          // Disable all first
          await supabase.from('periodos').update({ es_activo: false }).neq('id', 'dummy');
          // Enable selected
          await supabase.from('periodos').update({ es_activo: true }).eq('id', id);
          loadPeriods();
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', loadPeriods);
</script>
