---
import SelectionRooms from '@components/admin/SelectionRooms.astro';
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Selecciones · Panel Hello World" activeNav="config">
  <section class="admin-config">

    <div id="config-loading" class="admin-redirect">
      <i class="bi bi-arrow-clockwise admin-redirect-spin"></i>
      <p>Cargando…</p>
    </div>

    <!-- ═══ MODO: SELECCIONES CERRADAS — Abrir selecciones ═══ -->
    <div id="config-mode-closed" style="display:none;">
      <div class="admin-config-card">
        <div class="admin-config-eyebrow">
          <i class="bi bi-lock-fill"></i> Sin selecciones activas
        </div>
        <h1>Abrir nueva temporada</h1>
        <p class="admin-config-sub">
          Cuando abras las selecciones, el sitio público mostrará el flujo de aplicación con la temporada que elijas.
          Los aspirantes podrán enviar su solicitud, y aquí podrás revisarlas.
        </p>

        <form id="open-form" class="admin-config-form" novalidate>
          <div>
            <label class="admin-field-label" for="season-select">
              Temporada a abrir <span class="sel-req">*</span>
            </label>
            <select id="season-select" class="admin-select admin-select-block" required>
              <option value="" disabled selected>Selecciona un semestre…</option>
            </select>
          </div>

          <button type="submit" id="open-submit" class="hw-btn hw-btn-primary admin-save-btn">
            Abrir selecciones →
          </button>

          <div id="open-feedback" class="admin-save-feedback" style="display:none;"></div>
        </form>

        <div class="admin-config-meta">
          <p>
            <i class="bi bi-info-circle"></i>
            Esta acción es manual y reversible — puedes cerrar las selecciones en cualquier momento.
          </p>
        </div>
      </div>
    </div>

    <!-- ═══ MODO: SELECCIONES ABIERTAS — Info + cerrar ═══ -->
    <div id="config-mode-open" style="display:none;">
      <div class="admin-config-card">
        <div class="admin-config-eyebrow admin-config-eyebrow-active">
          <i class="bi bi-broadcast"></i> Selecciones activas
        </div>
        <h1>Temporada <span id="active-season-display">—</span></h1>
        <p class="admin-config-sub">
          El sitio público está mostrando el flujo de aplicación. Los aspirantes pueden enviar su solicitud ahora mismo.
        </p>

        <dl class="admin-dl admin-dl-config">
          <dt>Abierta desde</dt>
          <dd id="opened-at-display">—</dd>
          <dt>Por</dt>
          <dd id="opened-by-display">—</dd>
        </dl>

        <div id="progressive-window-section" class="admin-deadline-section admin-progressive-window" style="display:none;">
          <h3 class="admin-deadline-title">
            <i class="bi bi-hourglass-split"></i>
            Invitaciones a entrevista
          </h3>
          <p class="admin-deadline-hint">
            Define cuánto tiempo tendrá cada persona aceptada para elegir horario, contado desde que se procese su correo.
            Este plazo se aplicará a los lotes futuros.
          </p>
          <div class="admin-progressive-settings">
            <label class="admin-field-label admin-progressive-days" for="progressive-default-days">
              Días para agendar
              <span class="admin-progressive-number-wrap">
                <input id="progressive-default-days" class="admin-text-input" type="number" min="1" max="365" value="7" />
                <span aria-hidden="true">días</span>
              </span>
            </label>
            <label class="admin-progressive-pause" for="progressive-dispatch-paused">
              <input id="progressive-dispatch-paused" type="checkbox" />
              <span><strong>Pausar correos</strong><small>Los lotes quedan en cola hasta reanudar el despacho.</small></span>
            </label>
          </div>
          <fieldset class="admin-reminder-settings">
            <legend>Recordatorios para agendar</legend>
            <label><input id="progressive-reminder-enabled" type="checkbox" checked /> Activar recordatorios automáticos</label>
            <div class="admin-progressive-settings">
              <label class="admin-field-label" for="progressive-reminder-first">Primer aviso (horas antes del vencimiento)
                <input id="progressive-reminder-first" class="admin-text-input" type="number" min="1" max="8760" value="72" />
              </label>
              <label class="admin-field-label" for="progressive-reminder-last">Último aviso (horas antes del vencimiento)
                <input id="progressive-reminder-last" class="admin-text-input" type="number" min="1" max="8760" value="24" />
              </label>
            </div>
            <p class="admin-deadline-hint">Se aplica a las invitaciones que se envíen a partir de ahora. Máximo dos avisos, sólo si la persona no ha agendado y hay horarios. Si el plazo es corto, se omite el aviso que quedaría antes de la invitación. Las invitaciones anteriores conservan su configuración.</p>
          </fieldset>
          <button type="button" id="progressive-config-save" class="hw-btn hw-btn-primary admin-deadline-save">
            Guardar configuración
          </button>
          <div id="progressive-config-feedback" class="admin-save-feedback" style="display:none;"></div>
        </div>

        <!-- ═══ Estado del formulario público ═══ -->
        <div class="admin-forms-section">
          <h3 class="admin-deadline-title">
            <i class="bi bi-clipboard-check"></i>
            Formulario de inscripciones
          </h3>
          <p class="admin-deadline-hint">
            Cuando el form está abierto, cualquiera puede aplicar desde la web pública.
            Cuando se cierra manualmente, el sitio público muestra "En fase de entrevistas".
            Comunicar un lote ya no cambia este estado automáticamente.
          </p>

          <div class="admin-forms-row">
            <div class="admin-forms-status">
              <span class="admin-forms-label">Estado actual:</span>
              <span id="forms-status-pill" class="admin-forms-pill admin-forms-pill-open">
                <i class="bi bi-unlock-fill"></i> Abierto
              </span>
            </div>
            <button type="button" id="forms-toggle-btn" class="admin-action-btn admin-action-btn-primary">
              <i class="bi bi-lock-fill"></i> Cerrar inscripciones
            </button>
          </div>
          <div id="forms-feedback" class="admin-save-feedback" style="display:none;"></div>
        </div>

        <!-- ═══ Fecha límite entrevista (configurable) ═══ -->
        <div id="legacy-deadline-section" class="admin-deadline-section">
          <h3 class="admin-deadline-title">
            <i class="bi bi-calendar-event"></i>
            Fecha límite para agendar entrevista
          </h3>
          <p class="admin-deadline-hint">
            Esta fecha aparece en el correo de aceptación. Debe ser futura.
            Sin ella, el botón "Cierre de inscripciones" estará bloqueado.
          </p>

          <div class="admin-deadline-row">
            <input
              type="datetime-local"
              id="deadline-input"
              class="admin-text-input admin-deadline-input"
            >
            <div class="admin-deadline-presets">
              <button type="button" class="admin-preset-btn" data-days="7">+7 días</button>
              <button type="button" class="admin-preset-btn" data-days="14">+14 días</button>
              <button type="button" class="admin-preset-btn" data-days="21">+21 días</button>
            </div>
          </div>

          <div class="admin-deadline-preview" id="deadline-preview">
            <i class="bi bi-envelope-paper"></i>
            <span>El correo dirá: <strong id="deadline-preview-text">—</strong></span>
          </div>

          <button type="button" id="deadline-save" class="hw-btn hw-btn-primary admin-deadline-save">
            Guardar fecha
          </button>
          <div id="deadline-feedback" class="admin-save-feedback" style="display:none;"></div>
        </div>

        <!-- ═══ URL del grupo de WhatsApp ═══ -->
        <div class="admin-deadline-section">
          <h3 class="admin-deadline-title">
            <i class="bi bi-whatsapp"></i>
            Grupo de WhatsApp del club
          </h3>
          <p class="admin-deadline-hint">
            Se incluye en el correo de bienvenida final que reciben los aceptados al
            terminar el proceso de selección. Cada generación nueva debería crear su propio
            link y actualizarlo aquí.
          </p>

          <input
            type="url"
            id="whatsapp-input"
            class="admin-text-input"
            placeholder="https://chat.whatsapp.com/..."
          >

          <div class="admin-deadline-preview" id="whatsapp-preview" style="margin-top:14px;">
            <i class="bi bi-envelope-paper"></i>
            <span>El correo dirá: <strong>Únete al grupo de WhatsApp →</strong> (link a <span id="whatsapp-preview-text">—</span>)</span>
          </div>

          <button type="button" id="whatsapp-save" class="hw-btn hw-btn-primary admin-deadline-save">
            Guardar URL
          </button>
          <div id="whatsapp-feedback" class="admin-save-feedback" style="display:none;"></div>
        </div>

        <div class="admin-config-actions">
          <a href="/admin/solicitudes" class="hw-btn hw-btn-primary">
            Ver solicitudes →
          </a>
          <a href="/admin/entrevistas" class="admin-action-btn">
            <i class="bi bi-calendar-week"></i> Ver entrevistas
          </a>
        </div>
      </div>

      <div class="admin-config-card admin-schedule-card">
        <div class="admin-schedule-header">
          <div>
            <span class="admin-schedule-kicker"><i class="bi bi-signpost-split" aria-hidden="true"></i> CONTENIDO PÚBLICO</span>
            <h2>Cronograma de selección</h2>
          </div>
          <span class="admin-schedule-season" id="admin-schedule-season">—</span>
        </div>
        <p class="admin-config-sub">Define las cuatro fechas objetivo. Aparecerán en la página pública de esta temporada cuando publiques el cronograma.</p>
        <form id="schedule-form" class="admin-config-form">
          <div class="admin-schedule-fields">
            <div class="admin-schedule-field">
              <span class="admin-schedule-field-number" aria-hidden="true">01</span>
              <div><label class="admin-field-label" for="schedule-first">Cierre de solicitudes <small>Y resultados de primera etapa</small></label><input id="schedule-first" class="admin-text-input" type="date" required></div>
            </div>
            <div class="admin-schedule-field">
              <span class="admin-schedule-field-number" aria-hidden="true">02</span>
              <div><label class="admin-field-label" for="schedule-start">Inician las entrevistas <small>Desde esta fecha</small></label><input id="schedule-start" class="admin-text-input" type="date" required></div>
            </div>
            <div class="admin-schedule-field">
              <span class="admin-schedule-field-number" aria-hidden="true">03</span>
              <div><label class="admin-field-label" for="schedule-end">Últimas entrevistas <small>Fecha límite</small></label><input id="schedule-end" class="admin-text-input" type="date" required></div>
            </div>
            <div class="admin-schedule-field">
              <span class="admin-schedule-field-number" aria-hidden="true">04</span>
              <div><label class="admin-field-label" for="schedule-final">Decisión final <small>Aceptaciones y rechazos</small></label><input id="schedule-final" class="admin-text-input" type="date" required></div>
            </div>
          </div>
          <div class="admin-schedule-preview-wrap">
            <span class="admin-schedule-kicker">VISTA PREVIA EN LA PÁGINA</span>
            <div id="schedule-preview" class="admin-schedule-preview" aria-live="polite"></div>
          </div>
          <label class="admin-schedule-publish"><input id="schedule-published" type="checkbox"><span><strong>Publicar cronograma</strong><small>Visible en /seleccion mientras esta temporada esté activa.</small></span></label>
          <button type="submit" class="hw-btn hw-btn-primary admin-save-btn">Guardar cambios →</button>
          <p class="admin-schedule-safety">Guardar estas fechas no cierra solicitudes ni envía correos.</p>
          <div id="schedule-feedback" class="admin-save-feedback" style="display:none;"></div>
        </form>
        <div class="admin-schedule-notices">
          <span class="admin-schedule-kicker">COMUNICACIÓN DE LA MESA</span>
          <h3>Actualizaciones</h3>
          <p class="admin-config-sub">Publica avisos breves cuando haya novedades. Los avisos anteriores de esta temporada permanecen en el historial.</p>
          <form id="schedule-update-form" class="admin-config-form">
            <label class="admin-field-label" for="schedule-update-body">Nuevo aviso</label>
            <textarea id="schedule-update-body" class="admin-text-input" maxlength="500" rows="3" placeholder="Ej. Ya enviamos las invitaciones a entrevista…" required></textarea>
            <div class="admin-schedule-notice-actions"><label class="admin-schedule-check"><input id="schedule-update-published" type="checkbox"> Publicar ahora</label><button type="submit" class="admin-action-btn">Añadir aviso →</button></div>
          </form>
          <div id="schedule-update-feedback" class="admin-save-feedback" style="display:none;"></div>
          <div id="schedule-updates-admin" class="admin-schedule-update-list"></div>
        </div>
      </div>

      <!-- ═══════════════ DIVISOR FUERTE ═══════════════ -->
      <div class="admin-section-divider">
        <span class="admin-section-divider-label">
          <i class="bi bi-calendar-week-fill"></i> Configuración de entrevistas
        </span>
      </div>

      <SelectionRooms />

      <!-- ═══════════════ DIVISOR FUERTE ═══════════════ -->
      <div class="admin-section-divider">
        <span class="admin-section-divider-label">
          <i class="bi bi-slash-circle-fill"></i> Cierre del proceso
        </span>
      </div>

      <!-- ═══ Card: Cerrar ciclo de selección ═══ -->
      <div class="admin-config-card">
        <div class="admin-config-eyebrow admin-config-eyebrow-danger">
          <i class="bi bi-x-octagon-fill"></i> Fin del ciclo de selección
        </div>
        <h2>Cerrar el proceso de selección</h2>
        <p class="admin-config-sub">
          Una vez enviados todos los correos finales, cierra el ciclo formalmente. El sitio público
          dejará de mostrar cualquier estado de selecciones activo. Los datos del ciclo se conservan
          en el histórico para consulta futura.
        </p>
        <p class="admin-config-sub" style="font-weight:700;">
          Esta acción archiva definitivamente esta temporada; después podrás abrir una temporada nueva.
        </p>
        <button type="button" id="close-btn" class="admin-action-btn admin-action-btn-danger" style="margin-top:4px;">
          <i class="bi bi-x-circle"></i> Cerrar ciclo de selección
        </button>
        <div id="close-feedback" class="admin-save-feedback" style="display:none;"></div>
      </div>
    </div>

  </section>
</AdminLayout>

<script>
  import { initSelectionRooms } from '@lib/selection-rooms-ui';
  import { supabase } from '@lib/supabase';
  import { nextSemesters, formatSemesterDisplay } from '@lib/season';
  import {
    getSelectionFeatureMode,
    getSelectionState,
    selectionAdmin,
    selectionErrorMessage,
  } from '@lib/selection-client';

  let userEmail = '';
  let activeSeasonGlobal: string | null = null;
  let progressiveEnabled = false;
  let selectionConfigRevision = 0;

  document.addEventListener('DOMContentLoaded', async () => {
    // ── Auth guard ──────────────────────────────────────────────────────
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user?.email) {
      window.location.replace('/admin/login');
      return;
    }
    userEmail = session.user.email.toLowerCase();
    const { data: directiva } = await supabase
      .from('directiva').select('email').eq('email', userEmail).maybeSingle();
    if (!directiva) {
      await supabase.auth.signOut();
      window.location.replace('/admin/login');
      return;
    }

    const feature = await getSelectionFeatureMode();
    if (feature.mode === 'unavailable') {
      document.getElementById('config-loading')!.innerHTML =
        '<p class="admin-empty admin-empty-error">No se pudo verificar el backend de selecciones.</p>';
      return;
    }
    progressiveEnabled = feature.mode === 'progressive';
    selectionConfigRevision = Number(feature.state?.config.selection_revision ?? 0);

    // ── Load current config ─────────────────────────────────────────────
    await renderConfig();

    // Submit handlers
    document.getElementById('open-form')!.addEventListener('submit', openSelecciones);
    document.getElementById('close-btn')!.addEventListener('click', closeSelecciones);

    // Deadline section
    if (progressiveEnabled) setupProgressiveSection(feature.state?.config);
    else setupDeadlineSection();

    // Interviews section (solo si hay temporada activa)
    if (activeSeasonGlobal) {
      setupSchedule();
      setupInterviewsSection();
      setupWhatsappSection();
      setupFormsToggle();
    }
  });

  function scheduleField(id: string) { return document.getElementById(id) as HTMLInputElement; }
  const scheduleDates = ['schedule-first', 'schedule-start', 'schedule-end', 'schedule-final'];

  async function setupSchedule() {
    if (!activeSeasonGlobal) return;
    const season = activeSeasonGlobal;
    document.getElementById('admin-schedule-season')!.textContent = season;
    const form = document.getElementById('schedule-form') as HTMLFormElement;
    const noticeForm = document.getElementById('schedule-update-form') as HTMLFormElement;
    const { data, error } = await supabase.from('selection_schedules').select('*').eq('season', season).maybeSingle();
    if (error) {
      showFeedback(document.getElementById('schedule-feedback')!, error.message, 'error');
      return;
    }
    if (data) {
      [data.first_stage_date, data.interviews_start_date, data.interviews_end_date, data.final_results_date]
        .forEach((value, index) => { scheduleField(scheduleDates[index]).value = value; });
      scheduleField('schedule-published').checked = data.is_published;
    }
    const preview = () => {
      const values = scheduleDates.map(id => scheduleField(id).value);
      const target = document.getElementById('schedule-preview')!;
      target.replaceChildren();
      if (!values.every(Boolean)) {
        target.textContent = 'Completa las cuatro fechas para ver cómo se leerá el cronograma.';
        return;
      }
      const titles = ['Cierre de solicitudes', 'Inician las entrevistas', 'Últimas entrevistas', 'Decisión final'];
      values.forEach((value, index) => {
        const row = document.createElement('div');
        row.className = 'admin-schedule-preview-row';
        const number = document.createElement('span');
        number.textContent = String(index + 1).padStart(2, '0');
        const date = document.createElement('time');
        date.dateTime = value;
        date.textContent = new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Mexico_City' })
          .format(new Date(`${value}T12:00:00-06:00`));
        const title = document.createElement('strong');
        title.textContent = titles[index];
        row.append(number, date, title);
        target.append(row);
      });
      const note = document.createElement('p');
      note.textContent = 'Quien reciba una invitación tendrá siete días desde el envío de su correo para agendar.';
      target.append(note);
    };
    form.addEventListener('input', preview);
    preview();
    form.addEventListener('submit', async event => {
      event.preventDefault();
      const values = scheduleDates.map(id => scheduleField(id).value);
      const feedback = document.getElementById('schedule-feedback')!;
      if (!values.every(Boolean) || values.some((date, index) => index > 0 && date < values[index - 1])) {
        showFeedback(feedback, 'Completa las fechas en orden cronológico.', 'error');
        return;
      }
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      button.disabled = true;
      const { error: saveError } = await supabase.from('selection_schedules').upsert({
        season, first_stage_date: values[0], interviews_start_date: values[1],
        interviews_end_date: values[2], final_results_date: values[3],
        is_published: scheduleField('schedule-published').checked, updated_at: new Date().toISOString(),
      });
      showFeedback(feedback, saveError?.message ?? 'Cronograma guardado.', saveError ? 'error' : 'success');
      button.disabled = false;
    });
    noticeForm.addEventListener('submit', async event => {
      event.preventDefault();
      const body = (document.getElementById('schedule-update-body') as HTMLTextAreaElement).value.trim();
      const feedback = document.getElementById('schedule-update-feedback')!;
      if (!body) return;
      const { error: noticeError } = await supabase.from('selection_schedule_updates').insert({
        season, body, is_published: scheduleField('schedule-update-published').checked,
      });
      showFeedback(feedback, noticeError?.message ?? 'Aviso guardado.', noticeError ? 'error' : 'success');
      if (!noticeError) {
        noticeForm.reset();
        await refreshScheduleUpdates(season);
      }
    });
    await refreshScheduleUpdates(season);
  }

  async function refreshScheduleUpdates(season: string) {
    const list = document.getElementById('schedule-updates-admin')!;
    const { data, error } = await supabase.from('selection_schedule_updates').select('*')
      .eq('season', season).order('created_at', { ascending: false });
    list.replaceChildren();
    if (error) { list.textContent = error.message; return; }
    if (!data?.length) { list.textContent = 'Sin avisos para esta temporada.'; return; }
    for (const update of data) {
      const item = document.createElement('div');
      item.className = 'admin-schedule-update';
      const body = document.createElement('p');
      body.textContent = update.body;
      const status = document.createElement('span');
      status.className = `admin-schedule-update-status ${update.is_published ? 'is-published' : ''}`;
      status.textContent = update.is_published ? 'PUBLICADO' : 'BORRADOR';
      const meta = document.createElement('small');
      meta.textContent = update.published_at
        ? `${update.is_published ? 'Publicado' : 'Publicado anteriormente'} el ${new Intl.DateTimeFormat('es-MX', { dateStyle: 'long', timeZone: 'America/Mexico_City' }).format(new Date(update.published_at))}`
        : 'Sin publicar';
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'admin-action-btn';
      button.textContent = update.is_published ? 'Ocultar' : 'Publicar';
      button.addEventListener('click', async () => {
        button.disabled = true;
        const { error: updateError } = await supabase.from('selection_schedule_updates')
          .update({ is_published: !update.is_published }).eq('id', update.id);
        if (updateError) {
          showFeedback(document.getElementById('schedule-update-feedback')!, updateError.message, 'error');
          button.disabled = false;
        } else await refreshScheduleUpdates(season);
      });
      const actions = document.createElement('div');
      actions.className = 'admin-schedule-update-actions';
      actions.append(button);
      if (!update.is_published) {
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'admin-action-btn admin-schedule-delete';
        remove.innerHTML = '<i class="bi bi-trash3" aria-hidden="true"></i> Eliminar';
        remove.addEventListener('click', async () => {
          if (!confirm('¿Eliminar este borrador? No se podrá recuperar.')) return;
          remove.disabled = true;
          const { data: deleted, error: deleteError } = await supabase.from('selection_schedule_updates')
            .delete().eq('id', update.id).eq('season', season).eq('is_published', false).select('id');
          if (deleteError || !deleted?.length) {
            showFeedback(document.getElementById('schedule-update-feedback')!, deleteError?.message ?? 'El aviso cambió. Actualiza la página e inténtalo de nuevo.', 'error');
            remove.disabled = false;
          } else {
            showFeedback(document.getElementById('schedule-update-feedback')!, 'Borrador eliminado.', 'success');
            await refreshScheduleUpdates(season);
          }
        });
        actions.append(remove);
      }
      const copy = document.createElement('div');
      copy.className = 'admin-schedule-update-copy';
      copy.append(status, meta, body);
      item.append(copy, actions);
      list.append(item);
    }
  }

  function renderFormsStatus(closed: boolean) {
    const pill = document.getElementById('forms-status-pill');
    const btn  = document.getElementById('forms-toggle-btn') as HTMLButtonElement | null;
    if (!pill || !btn) return;
    if (closed) {
      pill.className = 'admin-forms-pill admin-forms-pill-closed';
      pill.innerHTML = '<i class="bi bi-lock-fill"></i> Cerrado';
      btn.innerHTML = '<i class="bi bi-unlock-fill"></i> Reabrir inscripciones';
      btn.dataset.action = 'reopen';
    } else {
      pill.className = 'admin-forms-pill admin-forms-pill-open';
      pill.innerHTML = '<i class="bi bi-unlock-fill"></i> Abierto';
      btn.innerHTML = '<i class="bi bi-lock-fill"></i> Cerrar inscripciones';
      btn.dataset.action = 'close';
    }
  }

  async function refreshProgressiveRevision() {
    if (!progressiveEnabled) return;
    const state = await getSelectionState(activeSeasonGlobal ?? undefined);
    selectionConfigRevision = Number(state.config.selection_revision ?? 0);
  }

  function setupProgressiveSection(config: Record<string, unknown> | undefined) {
    document.getElementById('legacy-deadline-section')!.style.display = 'none';
    document.getElementById('progressive-window-section')!.style.display = '';
    const configuredHours = Number(config?.default_booking_hours ?? 168);
    (document.getElementById('progressive-default-days') as HTMLInputElement).value =
      String(Math.max(1, Math.round(configuredHours / 24)));
    (document.getElementById('progressive-dispatch-paused') as HTMLInputElement).checked =
      config?.dispatch_paused === true;
    const reminderHours = Array.isArray(config?.reminder_hours) ? config.reminder_hours : [72, 24];
    (document.getElementById('progressive-reminder-enabled') as HTMLInputElement).checked = config?.reminder_enabled !== false;
    (document.getElementById('progressive-reminder-first') as HTMLInputElement).value = String(reminderHours[0]);
    (document.getElementById('progressive-reminder-last') as HTMLInputElement).value = String(reminderHours[1]);
    document.getElementById('progressive-config-save')!.addEventListener('click', async () => {
      const days = Number((document.getElementById('progressive-default-days') as HTMLInputElement).value);
      const paused = (document.getElementById('progressive-dispatch-paused') as HTMLInputElement).checked;
      const button = document.getElementById('progressive-config-save') as HTMLButtonElement;
      const feedback = document.getElementById('progressive-config-feedback') as HTMLElement;
      if (!Number.isInteger(days) || days < 1 || days > 365) {
        showFeedback(feedback, 'Los días deben ser un número entero entre 1 y 365.', 'error');
        return;
      }
      const hours = days * 24;
      const reminderEnabled = (document.getElementById('progressive-reminder-enabled') as HTMLInputElement).checked;
      const reminderHours = ['first', 'last'].map(name => Number((document.getElementById(`progressive-reminder-${name}`) as HTMLInputElement).value));
      if (reminderHours.some(value => !Number.isInteger(value) || value < 1 || value > 8760) || reminderHours[0] <= reminderHours[1]) {
        showFeedback(feedback, 'Los avisos deben ser horas enteras entre 1 y 8760. El primer aviso debe ocurrir antes que el último.', 'error');
        return;
      }
      button.disabled = true;
      try {
        await selectionAdmin('config', {
          revision: selectionConfigRevision,
          default_booking_hours: hours,
          dispatch_paused: paused,
          reminder_enabled: reminderEnabled,
          reminder_hours: reminderHours,
        });
        await refreshProgressiveRevision();
        showFeedback(feedback, `✓ Configuración guardada: ${days} día${days === 1 ? '' : 's'} para agendar.`, 'success');
      } catch (error) {
        showFeedback(feedback, selectionErrorMessage(error), 'error');
      } finally {
        button.disabled = false;
      }
    });
  }

  function setupFormsToggle() {
    const btn = document.getElementById('forms-toggle-btn') as HTMLButtonElement | null;
    const fb  = document.getElementById('forms-feedback') as HTMLElement | null;
    if (!btn || !fb) return;

    btn.addEventListener('click', async () => {
      const action = btn.dataset.action || 'close';
      const willClose = action === 'close';
      const msg = willClose
        ? '¿Cerrar el formulario de inscripciones?\n\nNadie podrá enviar solicitudes nuevas desde la web pública. Los visitantes verán "En fase de entrevistas".'
        : '¿Reabrir el formulario de inscripciones?\n\nLa web pública volverá a permitir aplicaciones nuevas para esta temporada.';
      if (!confirm(msg)) return;

      btn.disabled = true;
      const original = btn.innerHTML;
      btn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Guardando…';

      let error: { message: string } | null = null;
      if (progressiveEnabled) {
        try {
          await selectionAdmin('config', { revision: selectionConfigRevision, applications_closed: willClose });
          await refreshProgressiveRevision();
        } catch (cause) {
          error = { message: selectionErrorMessage(cause) };
        }
      } else {
        error = (await supabase
          .from('seleccion_config')
          .update({ applications_closed: willClose })
          .eq('id', true)).error;
      }

      if (error) {
        showFeedback(fb, `Error: ${error.message}`, 'error');
        btn.disabled = false;
        btn.innerHTML = original;
        return;
      }
      showFeedback(fb, willClose ? '✓ Inscripciones cerradas.' : '✓ Inscripciones reabiertas.', 'success');
      renderFormsStatus(willClose);
      btn.disabled = false;
    });
  }

  function setupWhatsappSection() {
    const input  = document.getElementById('whatsapp-input')   as HTMLInputElement | null;
    const preview = document.getElementById('whatsapp-preview-text');
    const saveBtn = document.getElementById('whatsapp-save')   as HTMLButtonElement | null;
    const fb      = document.getElementById('whatsapp-feedback') as HTMLElement | null;
    if (!input || !saveBtn || !fb) return;

    input.addEventListener('input', () => {
      if (preview) preview.textContent = input.value.trim() || '—';
    });

    saveBtn.addEventListener('click', async () => {
      const url = input.value.trim();
      if (!url) {
        showFeedback(fb, 'Pon una URL primero.', 'error');
        return;
      }
      if (!/^https:\/\/chat\.whatsapp\.com\//i.test(url)) {
        const ok = confirm('Esta URL no parece de un grupo de WhatsApp (chat.whatsapp.com). ¿Continuar de todos modos?');
        if (!ok) return;
      }

      saveBtn.disabled = true;
      saveBtn.textContent = 'Guardando…';

      let error: { message: string } | null = null;
      if (progressiveEnabled) {
        try {
          await selectionAdmin('config', { revision: selectionConfigRevision, whatsapp_url: url });
          await refreshProgressiveRevision();
        } catch (cause) {
          error = { message: selectionErrorMessage(cause) };
        }
      } else {
        error = (await supabase
          .from('seleccion_config')
          .update({ whatsapp_url: url })
          .eq('id', true)).error;
      }

      if (error) {
        showFeedback(fb, `Error: ${error.message}`, 'error');
      } else {
        showFeedback(fb, '✓ URL guardada.', 'success');
      }
      saveBtn.disabled = false;
      saveBtn.textContent = 'Guardar URL';
    });
  }

  // ── Formato fecha en español ─────────────────────────────────────────
  function formatDeadlineSpanish(date: Date): string {
    return new Intl.DateTimeFormat('es-MX', {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    }).format(date);
  }

  // Convierte un Date a string apto para datetime-local input (sin zona)
  function toLocalInputValue(d: Date): string {
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  function setupDeadlineSection() {
    const input    = document.getElementById('deadline-input')    as HTMLInputElement | null;
    const previewT = document.getElementById('deadline-preview-text') as HTMLElement | null;
    const saveBtn  = document.getElementById('deadline-save')     as HTMLButtonElement | null;
    const fb       = document.getElementById('deadline-feedback') as HTMLElement | null;
    if (!input || !previewT || !saveBtn || !fb) return;

    function updatePreview() {
      const v = input!.value;
      if (!v) {
        previewT!.textContent = '— (sin fecha definida)';
        saveBtn!.disabled = true;
        return;
      }
      const d = new Date(v);
      if (isNaN(d.getTime())) {
        previewT!.textContent = '— (fecha inválida)';
        saveBtn!.disabled = true;
        return;
      }
      const isFuture = d.getTime() > Date.now() + 60_000; // mínimo +1 min
      previewT!.textContent = `Tienes hasta el ${formatDeadlineSpanish(d)} para agendar.`;
      saveBtn!.disabled = !isFuture;
      if (!isFuture) {
        previewT!.textContent += ' (debe ser futura)';
      }
    }

    input.addEventListener('input', updatePreview);
    input.addEventListener('change', updatePreview);

    // Presets
    document.querySelectorAll<HTMLButtonElement>('.admin-preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const days = parseInt(btn.dataset.days || '7', 10);
        const target = new Date();
        target.setDate(target.getDate() + days);
        target.setHours(23, 59, 0, 0);
        input.value = toLocalInputValue(target);
        updatePreview();
      });
    });

    saveBtn.addEventListener('click', saveDeadline);

    // Sin deadline guardada → default +7 días
    if (!input.value) {
      const d = new Date();
      d.setDate(d.getDate() + 7);
      d.setHours(23, 59, 0, 0);
      input.value = toLocalInputValue(d);
    }
    updatePreview();
  }

  async function saveDeadline() {
    const input   = document.getElementById('deadline-input')    as HTMLInputElement;
    const saveBtn = document.getElementById('deadline-save')     as HTMLButtonElement;
    const fb      = document.getElementById('deadline-feedback') as HTMLElement;

    const v = input.value;
    if (!v) {
      showFeedback(fb, 'Pon una fecha primero.', 'error');
      return;
    }
    const d = new Date(v);
    if (isNaN(d.getTime()) || d.getTime() <= Date.now()) {
      showFeedback(fb, 'La fecha debe ser futura.', 'error');
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Guardando…';

    const { error } = await supabase
      .from('seleccion_config')
      .update({ interview_deadline_at: d.toISOString() })
      .eq('id', true);

    if (error) {
      showFeedback(fb, `Error: ${error.message}`, 'error');
    } else {
      showFeedback(fb, '✓ Fecha guardada. Ya puedes agregar días de entrevista.', 'success');
    }
    saveBtn.disabled = false;
    saveBtn.textContent = 'Guardar fecha';
  }

  async function renderConfig() {
    const loading     = document.getElementById('config-loading')!;
    const modeOpen    = document.getElementById('config-mode-open')!;
    const modeClosed  = document.getElementById('config-mode-closed')!;

    const { data, error } = await supabase
      .from('seleccion_config')
      .select('*')
      .eq('id', true)
      .maybeSingle();

    loading.style.display = 'none';

    if (error) {
      alert(`Error: ${error.message}`);
      return;
    }

    if (data?.is_open && data.active_season) {
      // Modo: abiertas
      activeSeasonGlobal = data.active_season;
      selectionConfigRevision = Number(data.selection_revision ?? selectionConfigRevision);
      modeOpen.style.display = '';
      modeClosed.style.display = 'none';
      document.getElementById('active-season-display')!.textContent = formatSemesterDisplay(data.active_season);
      document.getElementById('opened-at-display')!.textContent = data.opened_at
        ? new Date(data.opened_at).toLocaleString('es-MX', { day:'2-digit', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit' })
        : '—';
      document.getElementById('opened-by-display')!.textContent = data.opened_by || '—';

      // Pre-llenar deadline input con valor actual
      const deadlineInput = document.getElementById('deadline-input') as HTMLInputElement | null;
      if (deadlineInput && data.interview_deadline_at) {
        deadlineInput.value = toLocalInputValue(new Date(data.interview_deadline_at));
        deadlineInput.dispatchEvent(new Event('input'));
      }

      // Pre-llenar WhatsApp URL
      const whatsappInput = document.getElementById('whatsapp-input') as HTMLInputElement | null;
      const whatsappPreview = document.getElementById('whatsapp-preview-text');
      if (whatsappInput && data.whatsapp_url) {
        whatsappInput.value = data.whatsapp_url;
        if (whatsappPreview) whatsappPreview.textContent = data.whatsapp_url;
      }

      // Estado del forms público
      renderFormsStatus(data.applications_closed);
    } else {
      // Modo: cerradas
      modeClosed.style.display = '';
      modeOpen.style.display = 'none';

      // Poblar dropdown con próximos semestres
      const select = document.getElementById('season-select') as HTMLSelectElement;
      const semesters = nextSemesters(8);
      select.innerHTML = '<option value="" disabled selected>Selecciona un semestre…</option>' +
        semesters.map(s => `<option value="${s}">${formatSemesterDisplay(s)}</option>`).join('');
    }
  }

  async function openSelecciones(e: Event) {
    e.preventDefault();
    const select = document.getElementById('season-select') as HTMLSelectElement;
    const submit = document.getElementById('open-submit') as HTMLButtonElement;
    const fb     = document.getElementById('open-feedback') as HTMLElement;

    const season = select.value;
    if (!season) {
      showFeedback(fb, 'Selecciona una temporada primero.', 'error');
      return;
    }

    const ok = confirm(
      `¿Seguro que quieres abrir las selecciones para la temporada ${season}?\n\n` +
      `El sitio público mostrará el formulario de aplicación de inmediato.`
    );
    if (!ok) return;

    submit.disabled = true;
    submit.textContent = 'Abriendo…';
    fb.style.display = 'none';

    let error: { message: string } | null = null;
    if (progressiveEnabled) {
      try {
        await selectionAdmin('config', { revision: selectionConfigRevision, open_season: season });
        await refreshProgressiveRevision();
      } catch (cause) {
        error = { message: selectionErrorMessage(cause) };
      }
    } else {
      error = (await supabase
        .from('seleccion_config')
        .update({
          is_open: true,
          active_season: season,
          next_season_hint: null,
          applications_closed: false,
          opened_at: new Date().toISOString(),
          opened_by: userEmail,
          closed_at: null,
          closed_by: null,
        })
        .eq('id', true)).error;
    }

    if (error) {
      showFeedback(fb, `Error: ${error.message}`, 'error');
      submit.disabled = false;
      submit.textContent = 'Abrir selecciones →';
      return;
    }

    showFeedback(fb, '✓ Selecciones abiertas. Redirigiendo…', 'success');
    setTimeout(() => window.location.replace('/admin/solicitudes'), 800);
  }

  async function closeSelecciones() {
    const fb     = document.getElementById('close-feedback') as HTMLElement;
    const closeBtn = document.getElementById('close-btn') as HTMLButtonElement;

    const ok1 = confirm(
      `Archivar la temporada desactivará el formulario público.\n\n` +
      `El servidor sólo lo permitirá si no quedan decisiones, reservas o comunicaciones pendientes.\n\n` +
      `¿Confirmar el archivado?`
    );
    if (!ok1) return;

    closeBtn.disabled = true;
    closeBtn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Cerrando…';

    let error: { message: string } | null = null;
    if (progressiveEnabled) {
      try {
        await selectionAdmin('config', { revision: selectionConfigRevision, archive: true });
      } catch (cause) {
        error = { message: selectionErrorMessage(cause) };
      }
    } else {
      error = (await supabase
        .from('seleccion_config')
        .update({
          is_open: false,
          closed_at: new Date().toISOString(),
          closed_by: userEmail,
        })
        .eq('id', true)).error;
    }

    if (error) {
      showFeedback(fb, `Error: ${error.message}`, 'error');
      closeBtn.disabled = false;
      closeBtn.innerHTML = '<i class="bi bi-x-circle"></i> Cerrar selecciones';
      return;
    }

    showFeedback(fb, '✓ Selecciones cerradas.', 'success');
    setTimeout(() => renderConfig(), 800);
  }

  function showFeedback(el: HTMLElement, msg: string, type: 'success' | 'error') {
    el.style.display = 'block';
    el.className = `admin-save-feedback admin-save-feedback-${type}`;
    el.textContent = msg;
  }

  function setupInterviewsSection() {
    if (!progressiveEnabled) return;
    document.addEventListener('selection-rooms-state', event => { selectionConfigRevision = (event as CustomEvent<number>).detail; });
    initSelectionRooms(() => activeSeasonGlobal ?? undefined);
  }

</script>

