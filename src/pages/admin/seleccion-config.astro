---
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Selecciones · Panel Hello World" activeNav="config">
  <section class="admin-config">

    <div id="config-loading" class="admin-redirect">
      <i class="bi bi-arrow-clockwise admin-redirect-spin"></i>
      <p>Cargando…</p>
    </div>

    <!-- ═══ MODO: SELECCIONES CERRADAS — Abrir selecciones ═══ -->
    <div id="config-mode-closed" style="display:none;">
      <div class="admin-config-card">
        <div class="admin-config-eyebrow">
          <i class="bi bi-lock-fill"></i> Sin selecciones activas
        </div>
        <h1>Abrir nueva temporada</h1>
        <p class="admin-config-sub">
          Cuando abras las selecciones, el sitio público mostrará el flujo de aplicación con la temporada que elijas.
          Los aspirantes podrán enviar su solicitud, y aquí podrás revisarlas.
        </p>

        <form id="open-form" class="admin-config-form" novalidate>
          <div>
            <label class="admin-field-label" for="season-select">
              Temporada a abrir <span class="sel-req">*</span>
            </label>
            <select id="season-select" class="admin-select admin-select-block" required>
              <option value="" disabled selected>Selecciona un semestre…</option>
            </select>
          </div>

          <button type="submit" id="open-submit" class="hw-btn hw-btn-primary admin-save-btn">
            Abrir selecciones →
          </button>

          <div id="open-feedback" class="admin-save-feedback" style="display:none;"></div>
        </form>

        <div class="admin-config-meta">
          <p>
            <i class="bi bi-info-circle"></i>
            Esta acción es manual y reversible — puedes cerrar las selecciones en cualquier momento.
          </p>
        </div>
      </div>
    </div>

    <!-- ═══ MODO: SELECCIONES ABIERTAS — Info + cerrar ═══ -->
    <div id="config-mode-open" style="display:none;">
      <div class="admin-config-card">
        <div class="admin-config-eyebrow admin-config-eyebrow-active">
          <i class="bi bi-broadcast"></i> Selecciones activas
        </div>
        <h1>Temporada <span id="active-season-display">—</span></h1>
        <p class="admin-config-sub">
          El sitio público está mostrando el flujo de aplicación. Los aspirantes pueden enviar su solicitud ahora mismo.
        </p>

        <dl class="admin-dl admin-dl-config">
          <dt>Abierta desde</dt>
          <dd id="opened-at-display">—</dd>
          <dt>Por</dt>
          <dd id="opened-by-display">—</dd>
        </dl>

        <!-- ═══ Estado del formulario público ═══ -->
        <div class="admin-forms-section">
          <h3 class="admin-deadline-title">
            <i class="bi bi-clipboard-check"></i>
            Formulario de inscripciones
          </h3>
          <p class="admin-deadline-hint">
            Cuando el form está abierto, cualquiera puede aplicar desde la web pública.
            Cuando se cierra (manual o al enviar el bulk a entrevista), el sitio público
            muestra "En fase de entrevistas" hasta que se reabra o se cierre el ciclo.
          </p>

          <div class="admin-forms-row">
            <div class="admin-forms-status">
              <span class="admin-forms-label">Estado actual:</span>
              <span id="forms-status-pill" class="admin-forms-pill admin-forms-pill-open">
                <i class="bi bi-unlock-fill"></i> Abierto
              </span>
            </div>
            <button type="button" id="forms-toggle-btn" class="admin-action-btn admin-action-btn-primary">
              <i class="bi bi-lock-fill"></i> Cerrar inscripciones
            </button>
          </div>
          <div id="forms-feedback" class="admin-save-feedback" style="display:none;"></div>
        </div>

        <!-- ═══ Fecha límite entrevista (configurable) ═══ -->
        <div class="admin-deadline-section">
          <h3 class="admin-deadline-title">
            <i class="bi bi-calendar-event"></i>
            Fecha límite para agendar entrevista
          </h3>
          <p class="admin-deadline-hint">
            Esta fecha aparece en el correo de aceptación. Debe ser futura.
            Sin ella, el botón "Cierre de inscripciones" estará bloqueado.
          </p>

          <div class="admin-deadline-row">
            <input
              type="datetime-local"
              id="deadline-input"
              class="admin-text-input admin-deadline-input"
            >
            <div class="admin-deadline-presets">
              <button type="button" class="admin-preset-btn" data-days="7">+7 días</button>
              <button type="button" class="admin-preset-btn" data-days="14">+14 días</button>
              <button type="button" class="admin-preset-btn" data-days="21">+21 días</button>
            </div>
          </div>

          <div class="admin-deadline-preview" id="deadline-preview">
            <i class="bi bi-envelope-paper"></i>
            <span>El correo dirá: <strong id="deadline-preview-text">—</strong></span>
          </div>

          <button type="button" id="deadline-save" class="hw-btn hw-btn-primary admin-deadline-save">
            Guardar fecha
          </button>
          <div id="deadline-feedback" class="admin-save-feedback" style="display:none;"></div>
        </div>

        <!-- ═══ URL del grupo de WhatsApp ═══ -->
        <div class="admin-deadline-section">
          <h3 class="admin-deadline-title">
            <i class="bi bi-whatsapp"></i>
            Grupo de WhatsApp del club
          </h3>
          <p class="admin-deadline-hint">
            Se incluye en el correo de bienvenida final que reciben los aceptados al
            terminar el proceso de selección. Cada generación nueva debería crear su propio
            link y actualizarlo aquí.
          </p>

          <input
            type="url"
            id="whatsapp-input"
            class="admin-text-input"
            placeholder="https://chat.whatsapp.com/..."
          >

          <div class="admin-deadline-preview" id="whatsapp-preview" style="margin-top:14px;">
            <i class="bi bi-envelope-paper"></i>
            <span>El correo dirá: <strong>Únete al grupo de WhatsApp →</strong> (link a <span id="whatsapp-preview-text">—</span>)</span>
          </div>

          <button type="button" id="whatsapp-save" class="hw-btn hw-btn-primary admin-deadline-save">
            Guardar URL
          </button>
          <div id="whatsapp-feedback" class="admin-save-feedback" style="display:none;"></div>
        </div>

        <div class="admin-config-actions">
          <a href="/admin/solicitudes" class="hw-btn hw-btn-primary">
            Ver solicitudes →
          </a>
          <a href="/admin/entrevistas" class="admin-action-btn">
            <i class="bi bi-calendar-week"></i> Ver entrevistas
          </a>
        </div>
      </div>

      <!-- ═══════════════ DIVISOR FUERTE ═══════════════ -->
      <div class="admin-section-divider">
        <span class="admin-section-divider-label">
          <i class="bi bi-calendar-week-fill"></i> Configuración de entrevistas
        </span>
      </div>

      <!-- ═══ Card: configuración de días de entrevista ═══ -->
      <div class="admin-config-card">
        <h2 class="admin-interviews-title">Días disponibles para entrevistas</h2>
        <p class="admin-config-sub">
          Define los días en los que el equipo podrá entrevistar. Los slots se generan
          automáticamente desde el rango horario y la duración elegida. Cada día tiene una
          sala de Google Meet única que todos los entrevistados ese día usarán.
        </p>

        <!-- Stats de capacidad -->
        <div class="admin-stats-row" id="interview-stats">
          <div class="admin-stat-pill">
            <span class="admin-stat-pill-num" id="stat-slots">0</span>
            <span class="admin-stat-pill-label">Slots</span>
          </div>
          <div class="admin-stat-pill">
            <span class="admin-stat-pill-num" id="stat-accepted">0</span>
            <span class="admin-stat-pill-label">Aceptados</span>
          </div>
          <div class="admin-stat-pill" id="stat-warning-pill" style="display:none;">
            <span class="admin-stat-pill-num" id="stat-missing">0</span>
            <span class="admin-stat-pill-label">Faltan</span>
          </div>
        </div>

        <!-- Lista de días configurados -->
        <div id="interview-days-list" class="admin-days-list">
          <div class="admin-empty admin-days-empty">Sin días configurados todavía.</div>
        </div>

        <!-- Form: añadir día -->
        <details class="admin-add-day-details">
          <summary class="admin-add-day-summary">
            <i class="bi bi-plus-circle"></i> Agregar día de entrevista
          </summary>
          <form id="day-form" class="admin-day-form" novalidate>
            <div id="day-deadline-hint" class="admin-warn-hint" style="display:none;">
              <i class="bi bi-exclamation-triangle-fill"></i>
              Primero guarda la <strong>Fecha límite para agendar entrevista</strong> (sección de arriba).
              Los días de entrevista deben ser <em>posteriores</em> a esa fecha.
            </div>
            <div class="admin-day-form-row">
              <div class="admin-day-form-field">
                <label class="admin-field-label" for="day-date">Fecha</label>
                <input type="date" id="day-date" class="admin-text-input" required>
              </div>
              <div class="admin-day-form-field">
                <label class="admin-field-label" for="day-start">Hora inicio</label>
                <input type="time" id="day-start" class="admin-text-input" required>
              </div>
              <div class="admin-day-form-field">
                <label class="admin-field-label" for="day-end">Hora fin</label>
                <input type="time" id="day-end" class="admin-text-input" required>
              </div>
            </div>
            <div class="admin-day-form-row admin-day-form-row-meet">
              <div class="admin-day-form-field">
                <label class="admin-field-label" for="day-duration">Duración</label>
                <select id="day-duration" class="admin-select admin-select-block">
                  <option value="15">15 min</option>
                  <option value="20">20 min</option>
                  <option value="30" selected>30 min</option>
                  <option value="45">45 min</option>
                  <option value="60">60 min</option>
                </select>
              </div>
              <div class="admin-day-form-field">
                <label class="admin-field-label" for="day-meet">URL de Google Meet</label>
                <input type="url" id="day-meet" class="admin-text-input" required
                  placeholder="https://meet.google.com/abc-defg-hij">
              </div>
            </div>
            <div id="day-slots-preview" class="admin-slots-preview" style="display:none;">
              <span class="admin-slots-preview-label">Slots que se generarán:</span>
              <span id="day-slots-list"></span>
            </div>
            <button type="submit" id="day-add-btn" class="hw-btn hw-btn-primary admin-deadline-save">
              Agregar día
            </button>
            <div id="day-feedback" class="admin-save-feedback" style="display:none;"></div>
          </form>
        </details>
      </div>

      <!-- ═══════════════ DIVISOR FUERTE ═══════════════ -->
      <div class="admin-section-divider">
        <span class="admin-section-divider-label">
          <i class="bi bi-slash-circle-fill"></i> Cierre del proceso
        </span>
      </div>

      <!-- ═══ Card: Cerrar ciclo de selección ═══ -->
      <div class="admin-config-card">
        <div class="admin-config-eyebrow admin-config-eyebrow-danger">
          <i class="bi bi-x-octagon-fill"></i> Fin del ciclo de selección
        </div>
        <h2>Cerrar el proceso de selección</h2>
        <p class="admin-config-sub">
          Una vez enviados todos los correos finales, cierra el ciclo formalmente. El sitio público
          dejará de mostrar cualquier estado de selecciones activo. Los datos del ciclo se conservan
          en el histórico para consulta futura.
        </p>
        <p class="admin-config-sub" style="font-weight:700;">
          Esta acción es reversible — puedes abrir un nuevo ciclo en cualquier momento desde este mismo panel.
        </p>
        <button type="button" id="close-btn" class="admin-action-btn admin-action-btn-danger" style="margin-top:4px;">
          <i class="bi bi-x-circle"></i> Cerrar ciclo de selección
        </button>
        <div id="close-feedback" class="admin-save-feedback" style="display:none;"></div>
      </div>
    </div>

  </section>
</AdminLayout>

<script>
  import { supabase } from '@lib/supabase';
  import { nextSemesters, formatSemesterDisplay } from '@lib/season';
  import { generateSlots, formatSlotTime, formatDayShort, type InterviewDay } from '@lib/interview-slots';

  let userEmail = '';
  let activeSeasonGlobal: string | null = null;
  let interviewDeadlineGlobal: Date | null = null;

  document.addEventListener('DOMContentLoaded', async () => {
    // ── Auth guard ──────────────────────────────────────────────────────
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user?.email) {
      window.location.replace('/admin/login');
      return;
    }
    userEmail = session.user.email.toLowerCase();
    const { data: directiva } = await supabase
      .from('directiva').select('email').eq('email', userEmail).maybeSingle();
    if (!directiva) {
      await supabase.auth.signOut();
      window.location.replace('/admin/login');
      return;
    }

    // ── Load current config ─────────────────────────────────────────────
    await renderConfig();

    // Submit handlers
    document.getElementById('open-form')!.addEventListener('submit', openSelecciones);
    document.getElementById('close-btn')!.addEventListener('click', closeSelecciones);

    // Deadline section
    setupDeadlineSection();

    // Interviews section (solo si hay temporada activa)
    if (activeSeasonGlobal) {
      setupInterviewsSection();
      setupWhatsappSection();
      setupFormsToggle();
    }
  });

  function renderFormsStatus(closed: boolean) {
    const pill = document.getElementById('forms-status-pill');
    const btn  = document.getElementById('forms-toggle-btn') as HTMLButtonElement | null;
    if (!pill || !btn) return;
    if (closed) {
      pill.className = 'admin-forms-pill admin-forms-pill-closed';
      pill.innerHTML = '<i class="bi bi-lock-fill"></i> Cerrado';
      btn.innerHTML = '<i class="bi bi-unlock-fill"></i> Reabrir inscripciones';
      btn.dataset.action = 'reopen';
    } else {
      pill.className = 'admin-forms-pill admin-forms-pill-open';
      pill.innerHTML = '<i class="bi bi-unlock-fill"></i> Abierto';
      btn.innerHTML = '<i class="bi bi-lock-fill"></i> Cerrar inscripciones';
      btn.dataset.action = 'close';
    }
  }

  function setupFormsToggle() {
    const btn = document.getElementById('forms-toggle-btn') as HTMLButtonElement | null;
    const fb  = document.getElementById('forms-feedback') as HTMLElement | null;
    if (!btn || !fb) return;

    btn.addEventListener('click', async () => {
      const action = btn.dataset.action || 'close';
      const willClose = action === 'close';
      const msg = willClose
        ? '¿Cerrar el formulario de inscripciones?\n\nNadie podrá enviar solicitudes nuevas desde la web pública. Los visitantes verán "En fase de entrevistas".'
        : '¿Reabrir el formulario de inscripciones?\n\nLa web pública volverá a permitir aplicaciones nuevas para esta temporada.';
      if (!confirm(msg)) return;

      btn.disabled = true;
      const original = btn.innerHTML;
      btn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Guardando…';

      const { error } = await supabase
        .from('seleccion_config')
        .update({ applications_closed: willClose })
        .eq('id', true);

      if (error) {
        showFeedback(fb, `Error: ${error.message}`, 'error');
        btn.disabled = false;
        btn.innerHTML = original;
        return;
      }
      showFeedback(fb, willClose ? '✓ Inscripciones cerradas.' : '✓ Inscripciones reabiertas.', 'success');
      renderFormsStatus(willClose);
      btn.disabled = false;
    });
  }

  function setupWhatsappSection() {
    const input  = document.getElementById('whatsapp-input')   as HTMLInputElement | null;
    const preview = document.getElementById('whatsapp-preview-text');
    const saveBtn = document.getElementById('whatsapp-save')   as HTMLButtonElement | null;
    const fb      = document.getElementById('whatsapp-feedback') as HTMLElement | null;
    if (!input || !saveBtn || !fb) return;

    input.addEventListener('input', () => {
      if (preview) preview.textContent = input.value.trim() || '—';
    });

    saveBtn.addEventListener('click', async () => {
      const url = input.value.trim();
      if (!url) {
        showFeedback(fb, 'Pon una URL primero.', 'error');
        return;
      }
      if (!/^https:\/\/chat\.whatsapp\.com\//i.test(url)) {
        const ok = confirm('Esta URL no parece de un grupo de WhatsApp (chat.whatsapp.com). ¿Continuar de todos modos?');
        if (!ok) return;
      }

      saveBtn.disabled = true;
      saveBtn.textContent = 'Guardando…';

      const { error } = await supabase
        .from('seleccion_config')
        .update({ whatsapp_url: url })
        .eq('id', true);

      if (error) {
        showFeedback(fb, `Error: ${error.message}`, 'error');
      } else {
        showFeedback(fb, '✓ URL guardada.', 'success');
      }
      saveBtn.disabled = false;
      saveBtn.textContent = 'Guardar URL';
    });
  }

  // ── Formato fecha en español ─────────────────────────────────────────
  function formatDeadlineSpanish(date: Date): string {
    return new Intl.DateTimeFormat('es-MX', {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    }).format(date);
  }

  // Convierte un Date a string apto para datetime-local input (sin zona)
  function toLocalInputValue(d: Date): string {
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  function setupDeadlineSection() {
    const input    = document.getElementById('deadline-input')    as HTMLInputElement | null;
    const previewT = document.getElementById('deadline-preview-text') as HTMLElement | null;
    const saveBtn  = document.getElementById('deadline-save')     as HTMLButtonElement | null;
    const fb       = document.getElementById('deadline-feedback') as HTMLElement | null;
    if (!input || !previewT || !saveBtn || !fb) return;

    function updatePreview() {
      const v = input!.value;
      if (!v) {
        previewT!.textContent = '— (sin fecha definida)';
        saveBtn!.disabled = true;
        return;
      }
      const d = new Date(v);
      if (isNaN(d.getTime())) {
        previewT!.textContent = '— (fecha inválida)';
        saveBtn!.disabled = true;
        return;
      }
      const isFuture = d.getTime() > Date.now() + 60_000; // mínimo +1 min
      previewT!.textContent = `Tienes hasta el ${formatDeadlineSpanish(d)} para agendar.`;
      saveBtn!.disabled = !isFuture;
      if (!isFuture) {
        previewT!.textContent += ' (debe ser futura)';
      }
    }

    input.addEventListener('input', updatePreview);
    input.addEventListener('change', updatePreview);

    // Presets
    document.querySelectorAll<HTMLButtonElement>('.admin-preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const days = parseInt(btn.dataset.days || '7', 10);
        const target = new Date();
        target.setDate(target.getDate() + days);
        target.setHours(23, 59, 0, 0);
        input.value = toLocalInputValue(target);
        updatePreview();
      });
    });

    saveBtn.addEventListener('click', saveDeadline);

    // Sin deadline guardada → default +7 días
    if (!input.value) {
      const d = new Date();
      d.setDate(d.getDate() + 7);
      d.setHours(23, 59, 0, 0);
      input.value = toLocalInputValue(d);
    }
    updatePreview();
  }

  async function saveDeadline() {
    const input   = document.getElementById('deadline-input')    as HTMLInputElement;
    const saveBtn = document.getElementById('deadline-save')     as HTMLButtonElement;
    const fb      = document.getElementById('deadline-feedback') as HTMLElement;

    const v = input.value;
    if (!v) {
      showFeedback(fb, 'Pon una fecha primero.', 'error');
      return;
    }
    const d = new Date(v);
    if (isNaN(d.getTime()) || d.getTime() <= Date.now()) {
      showFeedback(fb, 'La fecha debe ser futura.', 'error');
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Guardando…';

    const { error } = await supabase
      .from('seleccion_config')
      .update({ interview_deadline_at: d.toISOString() })
      .eq('id', true);

    if (error) {
      showFeedback(fb, `Error: ${error.message}`, 'error');
    } else {
      interviewDeadlineGlobal = d;
      updateDayFormDeadlineState();
      showFeedback(fb, '✓ Fecha guardada. Ya puedes agregar días de entrevista.', 'success');
    }
    saveBtn.disabled = false;
    saveBtn.textContent = 'Guardar fecha';
  }

  async function renderConfig() {
    const loading     = document.getElementById('config-loading')!;
    const modeOpen    = document.getElementById('config-mode-open')!;
    const modeClosed  = document.getElementById('config-mode-closed')!;

    const { data, error } = await supabase
      .from('seleccion_config')
      .select('*')
      .eq('id', true)
      .maybeSingle();

    loading.style.display = 'none';

    if (error) {
      alert(`Error: ${error.message}`);
      return;
    }

    if (data?.is_open && data.active_season) {
      // Modo: abiertas
      activeSeasonGlobal = data.active_season;
      modeOpen.style.display = '';
      modeClosed.style.display = 'none';
      document.getElementById('active-season-display')!.textContent = formatSemesterDisplay(data.active_season);
      document.getElementById('opened-at-display')!.textContent = data.opened_at
        ? new Date(data.opened_at).toLocaleString('es-MX', { day:'2-digit', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit' })
        : '—';
      document.getElementById('opened-by-display')!.textContent = data.opened_by || '—';

      // Pre-llenar deadline input con valor actual
      interviewDeadlineGlobal = data.interview_deadline_at ? new Date(data.interview_deadline_at) : null;
      const deadlineInput = document.getElementById('deadline-input') as HTMLInputElement | null;
      if (deadlineInput && data.interview_deadline_at) {
        deadlineInput.value = toLocalInputValue(new Date(data.interview_deadline_at));
        deadlineInput.dispatchEvent(new Event('input'));
      }

      // Pre-llenar WhatsApp URL
      const whatsappInput = document.getElementById('whatsapp-input') as HTMLInputElement | null;
      const whatsappPreview = document.getElementById('whatsapp-preview-text');
      if (whatsappInput && data.whatsapp_url) {
        whatsappInput.value = data.whatsapp_url;
        if (whatsappPreview) whatsappPreview.textContent = data.whatsapp_url;
      }

      // Estado del forms público
      renderFormsStatus(data.applications_closed);
    } else {
      // Modo: cerradas
      modeClosed.style.display = '';
      modeOpen.style.display = 'none';

      // Poblar dropdown con próximos semestres
      const select = document.getElementById('season-select') as HTMLSelectElement;
      const semesters = nextSemesters(8);
      select.innerHTML = '<option value="" disabled selected>Selecciona un semestre…</option>' +
        semesters.map(s => `<option value="${s}">${formatSemesterDisplay(s)}</option>`).join('');
    }
  }

  async function openSelecciones(e: Event) {
    e.preventDefault();
    const select = document.getElementById('season-select') as HTMLSelectElement;
    const submit = document.getElementById('open-submit') as HTMLButtonElement;
    const fb     = document.getElementById('open-feedback') as HTMLElement;

    const season = select.value;
    if (!season) {
      showFeedback(fb, 'Selecciona una temporada primero.', 'error');
      return;
    }

    const ok = confirm(
      `¿Seguro que quieres abrir las selecciones para la temporada ${season}?\n\n` +
      `El sitio público mostrará el formulario de aplicación de inmediato.`
    );
    if (!ok) return;

    submit.disabled = true;
    submit.textContent = 'Abriendo…';
    fb.style.display = 'none';

    const { error } = await supabase
      .from('seleccion_config')
      .update({
        is_open: true,
        active_season: season,
        next_season_hint: null,
        applications_closed: false,
        opened_at: new Date().toISOString(),
        opened_by: userEmail,
        closed_at: null,
        closed_by: null,
      })
      .eq('id', true);

    if (error) {
      showFeedback(fb, `Error: ${error.message}`, 'error');
      submit.disabled = false;
      submit.textContent = 'Abrir selecciones →';
      return;
    }

    showFeedback(fb, '✓ Selecciones abiertas. Redirigiendo…', 'success');
    setTimeout(() => window.location.replace('/admin/solicitudes'), 800);
  }

  async function closeSelecciones() {
    const fb     = document.getElementById('close-feedback') as HTMLElement;
    const closeBtn = document.getElementById('close-btn') as HTMLButtonElement;

    const ok1 = confirm(
      `Cerrar las selecciones desactivará el formulario público.\n\n` +
      `Las solicitudes recibidas se conservarán intactas. Puedes reabrir o abrir una temporada nueva en cualquier momento.\n\n` +
      `¿Confirmar el cierre?`
    );
    if (!ok1) return;

    closeBtn.disabled = true;
    closeBtn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Cerrando…';

    const { error } = await supabase
      .from('seleccion_config')
      .update({
        is_open: false,
        closed_at: new Date().toISOString(),
        closed_by: userEmail,
      })
      .eq('id', true);

    if (error) {
      showFeedback(fb, `Error: ${error.message}`, 'error');
      closeBtn.disabled = false;
      closeBtn.innerHTML = '<i class="bi bi-x-circle"></i> Cerrar selecciones';
      return;
    }

    showFeedback(fb, '✓ Selecciones cerradas.', 'success');
    setTimeout(() => renderConfig(), 800);
  }

  function showFeedback(el: HTMLElement, msg: string, type: 'success' | 'error') {
    el.style.display = 'block';
    el.className = `admin-save-feedback admin-save-feedback-${type}`;
    el.textContent = msg;
  }

  function updateDayFormDeadlineState() {
    const btn  = document.getElementById('day-add-btn') as HTMLButtonElement | null;
    const hint = document.getElementById('day-deadline-hint') as HTMLElement | null;
    if (!btn || !hint) return;
    const valid = !!interviewDeadlineGlobal && interviewDeadlineGlobal.getTime() > Date.now();
    hint.style.display = valid ? 'none' : '';
    btn.disabled = !valid;
    if (!valid) btn.title = 'Primero guarda la fecha límite para agendar entrevista';
    else btn.title = '';
  }

  // ══════════════════════════════════════════════════════════════════════
  // Sección: días de entrevista
  // ══════════════════════════════════════════════════════════════════════

  function setupInterviewsSection() {
    updateDayFormDeadlineState();
    refreshInterviewDays();

    const dayForm = document.getElementById('day-form') as HTMLFormElement;
    const dateInput     = document.getElementById('day-date')     as HTMLInputElement;
    const startInput    = document.getElementById('day-start')    as HTMLInputElement;
    const endInput      = document.getElementById('day-end')      as HTMLInputElement;
    const durationInput = document.getElementById('day-duration') as HTMLSelectElement;

    // Live preview de los slots que se van a generar
    function updateSlotsPreview() {
      const previewWrap = document.getElementById('day-slots-preview') as HTMLElement;
      const previewList = document.getElementById('day-slots-list')    as HTMLElement;
      if (!dateInput.value || !startInput.value || !endInput.value) {
        previewWrap.style.display = 'none';
        return;
      }
      try {
        const slots = generateSlots({
          id: '', date: dateInput.value,
          start_time: startInput.value + ':00',
          end_time:   endInput.value + ':00',
          duration_minutes: parseInt(durationInput.value, 10),
        });
        if (slots.length === 0) {
          previewWrap.style.display = 'block';
          previewList.textContent = '(rango inválido — ningún slot cabe)';
          return;
        }
        previewWrap.style.display = 'block';
        previewList.textContent = `${slots.length} slots: ${slots.map(formatSlotTime).join(', ')}`;
      } catch {
        previewWrap.style.display = 'none';
      }
    }

    [dateInput, startInput, endInput, durationInput].forEach(el => {
      el.addEventListener('input', updateSlotsPreview);
      el.addEventListener('change', updateSlotsPreview);
    });

    dayForm.addEventListener('submit', addDay);

    // Al abrir el details: default date = deadline+1 (si hay deadline) o hoy
    const detailsEl = document.querySelector<HTMLDetailsElement>('.admin-add-day-details');
    if (detailsEl) {
      detailsEl.addEventListener('toggle', () => {
        if (!detailsEl.open || dateInput.value) return;
        let defaultDateStr: string;
        if (interviewDeadlineGlobal) {
          const deadlineLocal = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format(interviewDeadlineGlobal);
          const [y, m, d] = deadlineLocal.split('-').map(Number);
          const next = new Date(y, m - 1, d + 1);
          defaultDateStr = `${next.getFullYear()}-${String(next.getMonth() + 1).padStart(2, '0')}-${String(next.getDate()).padStart(2, '0')}`;
        } else {
          const today = new Date();
          defaultDateStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
        }
        dateInput.value = defaultDateStr;
        updateSlotsPreview();
      });
    }
  }

  async function refreshInterviewDays() {
    const list = document.getElementById('interview-days-list')!;
    if (!activeSeasonGlobal) return;

    const { data: days, error } = await supabase
      .from('interview_days')
      .select('*')
      .eq('season', activeSeasonGlobal)
      .order('date', { ascending: true });

    if (error) {
      list.innerHTML = `<div class="admin-empty admin-empty-error">Error: ${escapeHtml(error.message)}</div>`;
      return;
    }

    if (!days || days.length === 0) {
      list.innerHTML = '<div class="admin-empty admin-days-empty">Sin días configurados todavía.</div>';
    } else {
      list.innerHTML = days.map(d => {
        const slots = generateSlots(d as InterviewDay);
        const missingMeet = !d.meet_url || d.meet_url.trim() === '';
        return `
          <article class="admin-day-card ${missingMeet ? 'admin-day-card-warning' : ''}">
            <div class="admin-day-card-main">
              <div class="admin-day-card-date">${escapeHtml(formatDayShort(d.date))}</div>
              <div class="admin-day-card-meta">
                ${escapeHtml(d.start_time.slice(0,5))} – ${escapeHtml(d.end_time.slice(0,5))}
                · ${d.duration_minutes} min · <strong>${slots.length} slots</strong>
              </div>
              <div class="admin-day-card-meet">
                ${missingMeet
                  ? `<span class="admin-day-meet-missing"><i class="bi bi-exclamation-triangle"></i> Falta URL de Meet</span>`
                  : `<a href="${escapeAttr(d.meet_url!)}" target="_blank" rel="noopener noreferrer" class="admin-day-meet-link"><i class="bi bi-camera-video"></i> ${escapeHtml(d.meet_url!)}</a>`
                }
              </div>
            </div>
            <button type="button" class="admin-day-delete-btn" data-day-id="${d.id}" aria-label="Borrar día">
              <i class="bi bi-trash"></i>
            </button>
          </article>
        `;
      }).join('');

      list.querySelectorAll<HTMLButtonElement>('.admin-day-delete-btn').forEach(btn => {
        btn.addEventListener('click', () => deleteDay(btn.dataset.dayId!));
      });
    }

    await refreshInterviewStats(days || []);
  }

  async function refreshInterviewStats(days: { duration_minutes: number; start_time: string; end_time: string; date: string; id: string; }[]) {
    let totalSlots = 0;
    for (const d of days) {
      totalSlots += generateSlots(d as InterviewDay).length;
    }

    // Aceptados de la season activa
    let accepted = 0;
    if (activeSeasonGlobal) {
      const { count } = await supabase
        .from('solicitudes')
        .select('*', { count: 'exact', head: true })
        .eq('season', activeSeasonGlobal)
        .eq('status', 'accepted');
      accepted = count || 0;
    }

    document.getElementById('stat-slots')!.textContent = String(totalSlots);
    document.getElementById('stat-accepted')!.textContent = String(accepted);

    const warningPill = document.getElementById('stat-warning-pill')!;
    const missingEl = document.getElementById('stat-missing')!;
    const missing = accepted - totalSlots;
    if (missing > 0) {
      warningPill.style.display = 'inline-flex';
      missingEl.textContent = String(missing);
    } else {
      warningPill.style.display = 'none';
    }
  }

  async function addDay(e: Event) {
    e.preventDefault();
    const dateInput     = document.getElementById('day-date')     as HTMLInputElement;
    const startInput    = document.getElementById('day-start')    as HTMLInputElement;
    const endInput      = document.getElementById('day-end')      as HTMLInputElement;
    const durationInput = document.getElementById('day-duration') as HTMLSelectElement;
    const meetInput     = document.getElementById('day-meet')     as HTMLInputElement;
    const btn           = document.getElementById('day-add-btn')  as HTMLButtonElement;
    const fb            = document.getElementById('day-feedback') as HTMLElement;

    const date     = dateInput.value;
    const start    = startInput.value;
    const end      = endInput.value;
    const duration = parseInt(durationInput.value, 10);
    const meet     = meetInput.value.trim();

    if (!interviewDeadlineGlobal || interviewDeadlineGlobal.getTime() <= Date.now()) {
      showFeedback(fb, 'Configura primero la fecha límite para agendar entrevista.', 'error');
      return;
    }
    const deadlineDateStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format(interviewDeadlineGlobal);
    if (date <= deadlineDateStr) {
      const deadlineFormatted = interviewDeadlineGlobal.toLocaleDateString('es-MX', {
        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Mexico_City',
      });
      showFeedback(fb, `La fecha de entrevista debe ser posterior a la fecha límite de agendado (${deadlineFormatted}).`, 'error');
      return;
    }

    if (!date || !start || !end || !meet) {
      showFeedback(fb, 'Llena todos los campos.', 'error');
      return;
    }
    if (start >= end) {
      showFeedback(fb, 'La hora de fin debe ser después de la hora de inicio.', 'error');
      return;
    }
    if (!/^https:\/\/(meet\.google\.com|.*zoom\.us|.*teams\.microsoft\.com)\//i.test(meet)) {
      const ok = confirm('La URL no parece de Meet/Zoom/Teams. ¿Continuar de todos modos?');
      if (!ok) return;
    }

    btn.disabled = true;
    btn.textContent = 'Agregando…';

    const { error } = await supabase
      .from('interview_days')
      .insert({
        season: activeSeasonGlobal!,
        date,
        start_time: start + ':00',
        end_time:   end + ':00',
        duration_minutes: duration,
        meet_url: meet,
        created_by: userEmail,
      });

    if (error) {
      if (error.code === '23505') {
        showFeedback(fb, 'Ya tienes un día configurado para esa fecha.', 'error');
      } else {
        showFeedback(fb, `Error: ${error.message}`, 'error');
      }
    } else {
      showFeedback(fb, '✓ Día agregado.', 'success');
      (document.getElementById('day-form') as HTMLFormElement).reset();
      document.getElementById('day-slots-preview')!.style.display = 'none';
      await refreshInterviewDays();
      // Cerrar el details
      const details = document.querySelector<HTMLDetailsElement>('.admin-add-day-details');
      if (details) details.open = false;
    }
    btn.disabled = false;
    btn.textContent = 'Agregar día';
  }

  async function deleteDay(id: string) {
    const ok = confirm('¿Borrar este día de entrevista?\n\nSi ya hay entrevistas agendadas para este día, no se podrán cancelar desde aquí — esto solo borra el día del listado.');
    if (!ok) return;

    const { error } = await supabase
      .from('interview_days')
      .delete()
      .eq('id', id);

    if (error) {
      alert(`Error: ${error.message}`);
      return;
    }
    await refreshInterviewDays();
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function escapeAttr(s: string): string { return escapeHtml(s); }
</script>
