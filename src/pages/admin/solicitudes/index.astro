---
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Solicitudes · Panel Hello World" activeNav="solicitudes">
  <section class="admin-list">
    <!-- Auth guard placeholder — se evalúa en JS -->
    <div id="admin-list-loading" class="admin-redirect">
      <i class="bi bi-arrow-clockwise admin-redirect-spin"></i>
      <p>Cargando…</p>
    </div>

    <div id="admin-list-content" style="display:none;">

      <!-- Header -->
      <div class="admin-list-header">
        <div>
            <h1>Solicitudes</h1>
            <p class="admin-list-subtitle">
            Temporada <strong id="active-season">—</strong>
            <span id="historical-badge" class="admin-historical-badge" style="display:none;">
              <i class="bi bi-archive-fill"></i> Histórico · sólo lectura
            </span>
          </p>
        </div>
        <div class="admin-list-header-actions">
          <select id="season-filter" class="admin-select"></select>
          <a href="/admin/seleccion-config" class="admin-action-btn">
            <i class="bi bi-gear-fill"></i> Configurar
          </a>
          <a href="/admin/entrevistas" class="admin-action-btn">
            <i class="bi bi-calendar-week"></i> Entrevistas
          </a>
          <button id="btn-export" type="button" class="admin-action-btn">
            <i class="bi bi-download"></i> CSV
          </button>
          <div id="progressive-header-actions" class="admin-batch-header-actions" style="display:none;">
            <button id="progressive-select-all" type="button" class="admin-action-btn admin-select-all-btn" aria-pressed="false" disabled>
              <i class="bi bi-check2-square"></i> Seleccionar todos
            </button>
            <button id="progressive-preview" type="button" class="admin-action-btn admin-action-btn-primary" disabled>
              <i class="bi bi-envelope-check"></i> Previsualizar lote
            </button>
          </div>
          <button id="btn-cierre" type="button" class="admin-action-btn admin-action-btn-primary" disabled>
            <i class="bi bi-send-fill"></i> Cierre de inscripciones
          </button>
        </div>
      </div>

      <!-- Status counters -->
      <div class="admin-stats" id="admin-stats">
        <button data-status="all" class="admin-stat admin-stat-active">
          <span class="admin-stat-num" id="count-all">0</span>
          <span class="admin-stat-label">Total</span>
        </button>
        <button data-status="pending" class="admin-stat">
          <span class="admin-stat-num" id="count-pending">0</span>
          <span class="admin-stat-label">Pendientes</span>
        </button>
        <button data-status="reviewing" class="admin-stat">
          <span class="admin-stat-num" id="count-reviewing">0</span>
          <span class="admin-stat-label">En revisión</span>
        </button>
        <button data-status="accepted" class="admin-stat">
          <span class="admin-stat-num" id="count-accepted">0</span>
          <span class="admin-stat-label">Aceptados</span>
        </button>
        <button data-status="rejected" class="admin-stat">
          <span class="admin-stat-num" id="count-rejected">0</span>
          <span class="admin-stat-label">Rechazados</span>
        </button>
      </div>

      <!-- Search -->
      <div class="admin-search-wrap">
        <i class="bi bi-search admin-search-icon"></i>
        <input
          type="search"
          id="admin-search"
          class="admin-search"
          placeholder="Buscar por nombre, correo o carrera…"
          autocomplete="off"
        >
      </div>

      <!-- Table -->
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th class="progressive-check-column"><span class="visually-hidden">Seleccionar</span></th>
              <th>Nombre</th>
              <th>Carrera</th>
              <th class="admin-th-num">Sem.</th>
              <th>Estado</th>
              <th>Recibida</th>
              <th class="admin-th-actions"></th>
            </tr>
          </thead>
          <tbody id="admin-tbody">
            <tr><td colspan="7" class="admin-empty">Cargando…</td></tr>
          </tbody>
        </table>
      </div>

      <p class="admin-list-foot" id="admin-list-foot"></p>
    </div>

  </section>
</AdminLayout>

<script>
  import { supabase } from '@lib/supabase';
  import {
    confirmSelectionCommunication,
    commsOccupancyLabel,
    getSelectionFeatureMode,
    getSelectionState,
    previewSelectionCommunication,
    selectionErrorMessage,
    stageCommsOccupancy,
    type SelectionMessage,
    type SelectionSolicitud,
  } from '@lib/selection-client';

  type Status = 'pending' | 'reviewing' | 'accepted' | 'rejected';
  type Row = {
    id: string;
    nombre: string;
    correo: string;
    carrera: string;
    semestre: number;
    status: Status;
    season: string;
    created_at: string;
    email_notification_sent: boolean;
    final_decision: 'accepted' | 'rejected' | null;
    final_email_sent: boolean;
    selection_revision: number;
  };

  const STATUS_LABELS: Record<Status, string> = {
    pending: 'Pendiente',
    reviewing: 'En revisión',
    accepted: 'Aceptado',
    rejected: 'Rechazado',
  };

  let allRows: Row[] = [];
  let activeFilter: Status | 'all' = 'all';
  let searchQuery = '';
  let activeSeason: string | null = null;
  let viewingActiveSeason = false;
  let interviewDeadline: Date | null = null;
  let interviewSlots = { total: 0, withMissingMeet: 0, daysCount: 0 };
  let progressiveEnabled = false;
  let defaultBookingHours = 168;
  const selectedRows = new Set<string>();
  let stateMessages: SelectionMessage[] = [];

  document.addEventListener('DOMContentLoaded', async () => {
    // ── Auth guard ──────────────────────────────────────────────────────
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user?.email) {
      window.location.replace('/admin/login');
      return;
    }
    const { data: directiva } = await supabase
      .from('directiva')
      .select('email')
      .eq('email', session.user.email.toLowerCase())
      .maybeSingle();
    if (!directiva) {
      await supabase.auth.signOut();
      window.location.replace('/admin/login');
      return;
    }

    const feature = await getSelectionFeatureMode();
    if (feature.mode === 'unavailable') {
      document.getElementById('admin-list-loading')!.innerHTML =
        '<p class="admin-empty admin-empty-error">No se pudo verificar el backend de selecciones. Recarga antes de operar.</p>';
      return;
    }
    progressiveEnabled = feature.mode === 'progressive';
    if (progressiveEnabled) {
      const oldBulk = document.getElementById('btn-cierre') as HTMLButtonElement;
      oldBulk.style.display = 'none';
      document.getElementById('progressive-header-actions')!.style.display = 'flex';
      document.getElementById('progressive-select-all')!.addEventListener('click', toggleSelectAll);
      const preview = document.getElementById('progressive-preview') as HTMLButtonElement;
      preview.addEventListener('click', communicateSelected);
    }

    // ── Temporada activa + deadline entrevista ─────────────────────────
    const { data: config } = await supabase
      .from('seleccion_config')
      .select('is_open, active_season, interview_deadline_at, applications_closed, default_booking_hours')
      .eq('id', true)
      .maybeSingle();
    activeSeason = (config?.is_open && config.active_season) ? config.active_season : null;
    interviewDeadline = config?.interview_deadline_at ? new Date(config.interview_deadline_at) : null;
    if (Number.isInteger(config?.default_booking_hours) && Number(config?.default_booking_hours) >= 1) {
      defaultBookingHours = Number(config?.default_booking_hours);
    }

    // En fase de entrevistas: entrevistas es el panel principal (bypass con ?view=1)
    if (config?.is_open && config?.applications_closed && new URLSearchParams(window.location.search).get('view') !== '1') {
      window.location.replace('/admin/entrevistas');
      return;
    }

    // ── Slots de entrevistas configurados ──────────────────────────────
    if (activeSeason) {
      const { data: days } = await supabase
        .from('interview_days')
        .select('id, start_time, end_time, duration_minutes, meet_url, date')
        .eq('season', activeSeason);
      if (days) {
        interviewSlots.daysCount = days.length;
        interviewSlots.total = 0;
        interviewSlots.withMissingMeet = 0;
        for (const d of days) {
          const [sh, sm] = d.start_time.split(':').map(Number);
          const [eh, em] = d.end_time.split(':').map(Number);
          const startMin = sh * 60 + sm;
          const endMin   = eh * 60 + em;
          const step = d.duration_minutes;
          interviewSlots.total += Math.max(0, Math.floor((endMin - startMin) / step));
          if (!d.meet_url || d.meet_url.trim() === '') interviewSlots.withMissingMeet++;
        }
      }
    }

    // ── Seasons con solicitudes (histórico) ─────────────────────────────
    const { data: seasonRows } = await supabase
      .from('solicitudes')
      .select('season')
      .order('season', { ascending: false });
    const uniqueSeasons = seasonRows ? [...new Set(seasonRows.map(r => r.season))] : [];

    // Si no hay temporada activa Y no hay solicitudes históricas → onboarding
    if (!activeSeason && uniqueSeasons.length === 0) {
      window.location.replace('/admin/seleccion-config');
      return;
    }

    document.getElementById('admin-list-loading')!.style.display = 'none';
    document.getElementById('admin-list-content')!.style.display = 'block';

    // ── Poblar selector ────────────────────────────────────────────────
    // Combinar season activa + seasons históricas. Activa primero si existe.
    const allSeasons = [...new Set([
      ...(activeSeason ? [activeSeason] : []),
      ...uniqueSeasons,
    ])];
    const seasonSelect = document.getElementById('season-filter') as HTMLSelectElement;
    seasonSelect.innerHTML = allSeasons.map(s => {
      const isActive = s === activeSeason;
      return `<option value="${s}">${s}${isActive ? ' (activa)' : ''}</option>`;
    }).join('');
    seasonSelect.value = activeSeason || allSeasons[0];

    seasonSelect.addEventListener('change', () => {
      loadRows();
    });

    await loadRows();

    // ── Status filter buttons ───────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('#admin-stats .admin-stat').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#admin-stats .admin-stat').forEach(b => b.classList.remove('admin-stat-active'));
        btn.classList.add('admin-stat-active');
        activeFilter = (btn.dataset.status as Status | 'all') || 'all';
        renderTable();
      });
    });

    // ── Search ──────────────────────────────────────────────────────────
    const search = document.getElementById('admin-search') as HTMLInputElement;
    search.addEventListener('input', () => {
      searchQuery = search.value.trim().toLowerCase();
      renderTable();
    });

    // ── Export CSV ──────────────────────────────────────────────────────
    document.getElementById('btn-export')!.addEventListener('click', exportCsv);

    // ── Cierre de inscripciones (placeholder, se conecta a edge function bulk) ──
    document.getElementById('btn-cierre')!.addEventListener('click', triggerBulkSend);
  });

  async function loadRows() {
    const seasonSelect = document.getElementById('season-filter') as HTMLSelectElement;
    const tbody = document.getElementById('admin-tbody')!;
    tbody.innerHTML = '<tr><td colspan="7" class="admin-empty">Cargando…</td></tr>';

    // Update header
    const activeSeasonEl = document.getElementById('active-season')!;
    const histBadge = document.getElementById('historical-badge')!;
    activeSeasonEl.textContent = seasonSelect.value;
    viewingActiveSeason = seasonSelect.value === activeSeason;
    histBadge.style.display = viewingActiveSeason ? 'none' : 'inline-flex';

    selectedRows.clear();
    let data: unknown[] | null = null;
    let error: { message: string } | null = null;
    stateMessages = [];
    if (progressiveEnabled && viewingActiveSeason) {
      try {
        const state = await getSelectionState(seasonSelect.value);
        data = state.solicitudes;
        stateMessages = state.messages ?? [];
      } catch (cause) {
        error = { message: selectionErrorMessage(cause) };
      }
    } else {
      const response = await supabase
        .from('solicitudes')
        .select('id, nombre, correo, carrera, semestre, status, season, created_at, email_notification_sent, final_decision, final_email_sent, selection_revision')
        .eq('season', seasonSelect.value)
        .order('created_at', { ascending: false });
      data = response.data;
      error = response.error;
    }

    if (error) {
      tbody.innerHTML = `<tr><td colspan="7" class="admin-empty admin-empty-error">Error: ${escapeHtml(error.message)}</td></tr>`;
      return;
    }

    allRows = (data || []) as Row[];
    updateCounts();
    renderTable();
    updateBulkButton();
  }

  function updateCounts() {
    const counts = { all: allRows.length, pending: 0, reviewing: 0, accepted: 0, rejected: 0 };
    allRows.forEach(r => { counts[r.status] = (counts[r.status] || 0) + 1; });
    (Object.keys(counts) as Array<keyof typeof counts>).forEach(k => {
      const el = document.getElementById(`count-${k}`);
      if (el) el.textContent = String(counts[k]);
    });
  }

  function updateBulkButton() {
    const cierreBtn = document.getElementById('btn-cierre') as HTMLButtonElement;
    if (progressiveEnabled) {
      updateProgressiveSelection();
      return;
    }
    const pendingNotifications = allRows.filter(
      r => (r.status === 'accepted' || r.status === 'rejected') && !r.email_notification_sent
    ).length;

    // En histórico: deshabilitar siempre (no se envían emails de seasons pasadas)
    if (!viewingActiveSeason) {
      cierreBtn.disabled = true;
      cierreBtn.title = 'Solo disponible en la temporada activa';
      cierreBtn.innerHTML = `<i class="bi bi-archive"></i> Cierre (no aplica en histórico)`;
      return;
    }

    // Hay aceptados pendientes — validaciones críticas
    const acceptedPending = allRows.filter(r => r.status === 'accepted' && !r.email_notification_sent).length;
    const acceptedTotal = allRows.filter(r => r.status === 'accepted').length;

    if (acceptedPending > 0) {
      // 1. Deadline configurada y futura
      if (!interviewDeadline || interviewDeadline.getTime() <= Date.now()) {
        cierreBtn.disabled = true;
        cierreBtn.title = !interviewDeadline
          ? 'Configura la fecha límite de entrevista antes de mandar'
          : 'La fecha límite ya pasó. Actualízala antes de mandar.';
        cierreBtn.innerHTML = `<i class="bi bi-exclamation-triangle"></i> Falta fecha de entrevista`;
        return;
      }
      // 2. Días de entrevista configurados
      if (interviewSlots.daysCount === 0) {
        cierreBtn.disabled = true;
        cierreBtn.title = 'Configura al menos un día de entrevista antes de mandar';
        cierreBtn.innerHTML = `<i class="bi bi-exclamation-triangle"></i> Faltan días de entrevista`;
        return;
      }
      // 3. Capacidad suficiente para todos los aceptados (no solo pendientes)
      if (acceptedTotal > interviewSlots.total) {
        cierreBtn.disabled = true;
        cierreBtn.title = `Tienes ${acceptedTotal} aceptados y solo ${interviewSlots.total} slots disponibles. Agrega más días.`;
        cierreBtn.innerHTML = `<i class="bi bi-exclamation-triangle"></i> Faltan slots (${acceptedTotal - interviewSlots.total})`;
        return;
      }
      // 4. Todos los días con Meet URL
      if (interviewSlots.withMissingMeet > 0) {
        cierreBtn.disabled = true;
        cierreBtn.title = `${interviewSlots.withMissingMeet} día(s) sin Meet URL. Configúralos antes de mandar.`;
        cierreBtn.innerHTML = `<i class="bi bi-exclamation-triangle"></i> Falta Meet URL`;
        return;
      }
    }

    cierreBtn.disabled = pendingNotifications === 0;
    cierreBtn.title = pendingNotifications === 0
      ? 'No hay decisiones pendientes de notificar'
      : `Enviar ${pendingNotifications} email(s) de decisión`;
    if (pendingNotifications > 0) {
      cierreBtn.innerHTML = `<i class="bi bi-send-fill"></i> Cierre de inscripciones (${pendingNotifications})`;
    } else {
      cierreBtn.innerHTML = `<i class="bi bi-send-fill"></i> Cierre de inscripciones`;
    }
  }

  function renderTable() {
    const tbody = document.getElementById('admin-tbody')!;
    const foot  = document.getElementById('admin-list-foot')!;

    let filtered = allRows;
    if (activeFilter !== 'all') {
      filtered = filtered.filter(r => r.status === activeFilter);
    }
    if (searchQuery) {
      filtered = filtered.filter(r =>
        r.nombre.toLowerCase().includes(searchQuery) ||
        r.correo.toLowerCase().includes(searchQuery) ||
        r.carrera.toLowerCase().includes(searchQuery)
      );
    }

    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="admin-empty">Sin solicitudes que mostrar.</td></tr>';
      foot.textContent = '';
      return;
    }

    tbody.innerHTML = filtered.map(r => `
      <tr>
        <td class="progressive-check-column">
          ${progressiveEnabled && viewingActiveSeason ? `<input type="checkbox" data-progressive-row="${r.id}" ${selectedRows.has(r.id) ? 'checked' : ''} ${isEligible(r) ? '' : 'disabled'} aria-label="Seleccionar ${escapeHtml(r.nombre)}">` : ''}
        </td>
        <td>
          <div class="admin-row-name">${escapeHtml(r.nombre)}</div>
          <div class="admin-row-sub">${escapeHtml(r.correo)}</div>
        </td>
        <td>${escapeHtml(r.carrera)}</td>
        <td class="admin-th-num">${r.semestre}°</td>
        <td><div class="admin-status-stack"><span class="admin-status admin-status-${r.status}">${STATUS_LABELS[r.status]}</span>${commsBadge(r)}</div></td>
        <td>${formatDate(r.created_at)}</td>
        <td class="admin-th-actions">
          <a href="/admin/solicitudes/detalle?id=${r.id}" class="admin-row-link" title="Ver detalle">
            <i class="bi bi-arrow-right"></i>
          </a>
        </td>
      </tr>
    `).join('');
    tbody.querySelectorAll<HTMLInputElement>('[data-progressive-row]').forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        const id = checkbox.dataset.progressiveRow!;
        if (checkbox.checked) selectedRows.add(id);
        else selectedRows.delete(id);
        updateProgressiveSelection();
      });
    });
    foot.textContent = `Mostrando ${filtered.length} de ${allRows.length} solicitud(es).`;
    updateProgressiveSelection();
  }

  function initialOccupancy(row: Row) {
    return stageCommsOccupancy(stateMessages, row.id, 'initial', row.email_notification_sent);
  }

  function isEligible(row: Row): boolean {
    if (!(row.status === 'accepted' || row.status === 'rejected')) return false;
    return initialOccupancy(row) === 'free';
  }

  function commsBadge(row: Row): string {
    if (!progressiveEnabled || !viewingActiveSeason) return '';
    const occupancy = initialOccupancy(row);
    if (occupancy === 'free') return '';
    const text = occupancy === 'failed' ? 'Falló envío'
      : occupancy === 'uncertain' ? 'Envío incierto'
      : occupancy === 'sent' ? 'Enviado'
      : 'En cola';
    return `<span class="admin-comms-badge admin-comms-badge-${occupancy}" title="${commsOccupancyLabel(occupancy)}"><i class="bi ${occupancy === 'sent' ? 'bi-envelope-check-fill' : 'bi-envelope'}"></i>${text}</span>`;
  }

  function updateProgressiveSelection() {
    if (!progressiveEnabled) return;
    for (const id of [...selectedRows]) {
      const row = allRows.find((candidate) => candidate.id === id);
      if (!row || !isEligible(row)) selectedRows.delete(id);
    }
    const count = selectedRows.size;
    const eligibleRows = viewingActiveSeason ? allRows.filter(isEligible) : [];
    const allSelected = eligibleRows.length > 0 && eligibleRows.every((row) => selectedRows.has(row.id));
    const selectAll = document.getElementById('progressive-select-all') as HTMLButtonElement;
    selectAll.disabled = eligibleRows.length === 0 || !viewingActiveSeason;
    selectAll.setAttribute('aria-pressed', String(allSelected));
    selectAll.innerHTML = allSelected
      ? '<i class="bi bi-square"></i> Deseleccionar todos'
      : '<i class="bi bi-check2-square"></i> Seleccionar todos';
    selectAll.title = !viewingActiveSeason
      ? 'La selección masiva sólo está disponible en la temporada activa.'
      : eligibleRows.length === 0
        ? 'No hay decisiones pendientes de comunicar.'
        : `${allSelected ? 'Quitar' : 'Marcar'} las ${eligibleRows.length} decisiones pendientes de comunicar.`;
    const preview = document.getElementById('progressive-preview') as HTMLButtonElement;
    preview.disabled = count === 0 || !viewingActiveSeason;
    preview.innerHTML = `<i class="bi bi-envelope-check"></i> Previsualizar lote${count > 0 ? ` (${count})` : ''}`;
    const bookingDays = Math.max(1, Math.round(defaultBookingHours / 24));
    preview.title = !viewingActiveSeason
      ? 'Los lotes sólo se pueden comunicar desde la temporada activa.'
      : count === 0
        ? 'Selecciona al menos una solicitud aceptada o rechazada pendiente de comunicar.'
        : `Revisar ${count} comunicación(es). Los aceptados tendrán ${bookingDays} día${bookingDays === 1 ? '' : 's'} para agendar.`;
  }

  function toggleSelectAll() {
    if (!progressiveEnabled || !viewingActiveSeason) return;
    const eligibleRows = allRows.filter(isEligible);
    const allSelected = eligibleRows.length > 0 && eligibleRows.every((row) => selectedRows.has(row.id));
    for (const row of eligibleRows) {
      if (allSelected) selectedRows.delete(row.id);
      else selectedRows.add(row.id);
    }
    renderTable();
  }

  async function communicateSelected() {
    const rows = allRows.filter((row) => selectedRows.has(row.id));
    if (rows.length === 0) return;
    const kind = 'initial' as const;
    // Revalidar contra el estado fresco: otra persona pudo encolar mientras tanto.
    try {
      stateMessages = (await getSelectionState((document.getElementById('season-filter') as HTMLSelectElement).value)).messages ?? [];
    } catch { /* si falla, el preview del backend es la última palabra */ }
    const busy = rows.filter((row) => initialOccupancy(row) !== 'free');
    if (busy.length > 0) {
      alert(`Ya hay una comunicación en curso para: ${busy.map((row) => row.nombre).join(', ')}. Actualizando la lista.`);
      await loadRows();
      return;
    }
    const button = document.getElementById('progressive-preview') as HTMLButtonElement;
    const original = button.innerHTML;
    button.disabled = true;
    button.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Preparando…';
    try {
      const draft = await previewSelectionCommunication(
        kind,
        rows as unknown as SelectionSolicitud[],
        defaultBookingHours,
      );
      const summary = draft.preview.items
        .map((item) => `• ${item.nombre} <${item.correo}>\n  ${item.subject}`)
        .join('\n\n');
      if (!confirm(
        `PREVISUALIZACIÓN DEL LOTE (${draft.preview.items.length})\n\n${summary}\n\n` +
        'Confirmar sólo encola estos mensajes. No cierra inscripciones y no afecta a otras solicitudes.'
      )) return;

      const result = await confirmSelectionCommunication(draft);
      alert(`${result.queued} comunicación(es) encolada(s). El envío se procesa por separado.`);
      await loadRows();
    } catch (error) {
      alert(selectionErrorMessage(error));
    } finally {
      button.disabled = false;
      button.innerHTML = original;
      updateProgressiveSelection();
    }
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function formatDate(iso: string): string {
    const d = new Date(iso);
    return d.toLocaleString('es-MX', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  function exportCsv() {
    const headers = ['id','season','nombre','correo','carrera','semestre','status','created_at','email_notification_sent'];
    const csvRows = [headers.join(',')];
    allRows.forEach(r => {
      const vals = headers.map(h => {
        const v = (r as Record<string, unknown>)[h];
        const s = v == null ? '' : String(v);
        return /[,"\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
      });
      csvRows.push(vals.join(','));
    });
    const blob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    const seasonSelect = document.getElementById('season-filter') as HTMLSelectElement;
    link.download = `solicitudes-${seasonSelect.value}.csv`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  }

  async function triggerBulkSend() {
    const cierreBtn = document.getElementById('btn-cierre') as HTMLButtonElement;
    const seasonSelect = document.getElementById('season-filter') as HTMLSelectElement;
    const pending = allRows.filter(
      r => (r.status === 'accepted' || r.status === 'rejected') && !r.email_notification_sent
    ).length;
    if (pending === 0) return;

    const ok = confirm(
      `Vas a enviar ${pending} correo(s) de decisión a los solicitantes de la temporada ${seasonSelect.value}.\n\n` +
      `IMPORTANTE: Al confirmar:\n` +
      `  · Los aceptados reciben link para agendar entrevista\n` +
      `  · Los rechazados reciben mensaje final\n` +
      `  · EL FORMULARIO DE INSCRIPCIONES SE CERRARÁ automáticamente.\n` +
      `    Los visitantes nuevos verán "En fase de entrevistas".\n\n` +
      `Esta acción NO se puede deshacer (puedes reabrir el form manualmente\n` +
      `desde /admin/seleccion-config si fuera necesario).\n\n` +
      `¿Continuar?`
    );
    if (!ok) return;

    cierreBtn.disabled = true;
    cierreBtn.innerHTML = `<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Enviando…`;

    const { data, error } = await supabase.functions.invoke('send-decisions-bulk', {
      body: { season: seasonSelect.value },
    });

    if (error) {
      alert(`Error al enviar: ${error.message}`);
      cierreBtn.disabled = false;
      return;
    }

    const sent   = data?.sent ?? 0;
    const failed = data?.failed ?? 0;
    await loadRows();

    if (failed > 0) {
      type BulkError = { id: string; correo: string; error: string };
      const failedLines = ((data?.errors || []) as BulkError[]).map(e => {
        const row = allRows.find(r => r.id === e.id || r.correo === e.correo);
        const label = row ? `${row.nombre} — ${e.correo} (${row.status === 'accepted' ? 'Aceptado' : 'Rechazado'})` : e.correo;
        return `  · ${label}`;
      }).join('\n');

      if (sent > 0) {
        // Parcial: algunos enviados, el form ya se cerró automáticamente
        alert(
          `⚠ Se enviaron ${sent} de ${sent + failed} correo(s).\n\n` +
          `No llegaron (${failed}):\n${failedLines}\n\n` +
          `Contacta manualmente a quien aparece arriba antes de continuar.\n` +
          `El formulario de inscripciones ya se cerró automáticamente.`
        );
        window.location.replace('/admin/entrevistas');
      } else {
        // Todos fallaron: el form NO se cerró (edge fn solo lo cierra si sent > 0)
        cierreBtn.disabled = false;
        alert(
          `✗ Ningún correo pudo enviarse (${failed} fallidos).\n\n` +
          `Fallidos:\n${failedLines}\n\n` +
          `El formulario de inscripciones NO se cerró. Revisa la configuración de Resend e inténtalo de nuevo.`
        );
      }
    } else {
      window.location.replace('/admin/entrevistas');
      return;
    }
  }
</script>
