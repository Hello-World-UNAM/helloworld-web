---
import MiCuentaLayout from '@layouts/MiCuentaLayout.astro';
import { getSafeSupabaseServerClient } from '@lib/supabaseServer';

const supabase = getSafeSupabaseServerClient(Astro.cookies);
const { data: { session } } = await supabase.auth.getSession();

let isAuthorized = false;
if (session?.user?.email) {
  const { data: member } = await supabase
    .from('miembros_activos')
    .select('id')
    .eq('correo', session.user.email)
    .maybeSingle();
    
  if (member) isAuthorized = true;
}
---

<MiCuentaLayout title="Mi Cuenta | Leaderboard" showHeader={isAuthorized}>
  
  <style>
    .member-dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 2rem;
      align-items: start;
    }
    .upload-card {
      position: sticky;
      top: 2rem;
      min-height: 280px;
      display: flex;
      flex-direction: column;
    }
    .upload-card p {
      flex-grow: 1;
    }
    @media (max-width: 800px) {
      .member-dashboard-grid {
        grid-template-columns: 1fr;
      }
      .upload-card {
        position: static !important;
        min-height: auto;
      }
    }
    .history-card summary::-webkit-details-marker {
      display: none;
    }
    .history-card[open] .details-icon {
      transform: rotate(180deg);
    }
    .history-card:hover {
      border-color: #6225e6 !important;
    }
  </style>

  {!isAuthorized ? (
    <div id="unauthorized-state" style="text-align: center; padding: 3rem 1.5rem; background: #fff; border: 4px solid #000; border-radius: 12px; max-width: 500px; margin: 3rem auto; box-shadow: 8px 8px 0 #ef4444; width: calc(100% - 2rem); box-sizing: border-box;">
      <i class="bi bi-shield-lock-fill" style="font-size: 3.5rem; color: #ef4444;"></i>
      <h2 style="margin-top: 1rem; color: #000; font-weight: 900; font-size: 1.8rem; text-transform: uppercase;">Acceso Denegado</h2>
      <p style="margin-top: 1rem; color: #444; font-weight: 500; font-size: 1.1rem; line-height: 1.5;">Tu correo institucional no está registrado en la base de datos de miembros del club.</p>
      <button id="re-login-btn" class="hw-btn" style="margin-top: 2rem; width: 100%; background: #ef4444; color: #fff; font-size: 1rem; padding: 1rem; border-radius: 8px;">Intentar con otra cuenta</button>
    </div>
  ) : (
    <>
      <div id="loading-state" style="text-align: center; padding: 4rem 0;">
        <i class="bi bi-arrow-clockwise admin-redirect-spin" style="font-size: 2rem;"></i>
        <p style="margin-top: 1rem; color: var(--color-text-muted);">Cargando tu perfil...</p>
      </div>

      <div id="dashboard-state" style="display: none; font-family: 'DM Sans', sans-serif;">
        <!-- Account Number Modal -->
        <div id="account-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 9999; align-items: center; justify-content: center; padding: 1rem; backdrop-filter: blur(4px);">
          <div style="background: #fff; padding: 2.5rem; max-width: 400px; width: 100%; border: 4px solid #000; box-shadow: 8px 8px 0 #6225e6; text-align: center; border-radius: 12px;">
            <h2 style="font-size: 1.5rem; font-weight: 900; text-transform: uppercase; margin-bottom: 1rem;"><i class="bi bi-exclamation-triangle-fill" style="color: #ef4444;"></i> Aviso Importante</h2>
            <p style="font-weight: 500; color: #444; margin-bottom: 1.5rem; line-height: 1.5;">Escribe tu número de cuenta ya que se necesitará para la asignación de horas complementarias con jefatura.</p>
            <form id="account-form" style="display: flex; flex-direction: column; gap: 1rem;">
              <input type="text" id="account-input" placeholder="Ej. 321987654" style="padding: 0.8rem; border: 2px solid #000; font-size: 1.2rem; font-weight: 800; text-align: center; letter-spacing: 2px; outline: none; border-radius: 8px;" required autocomplete="off">
              <button type="submit" class="hw-btn hw-btn-primary" style="width: 100%; font-size: 1rem; padding: 1rem; border-radius: 8px;">Guardar Número</button>
            </form>
          </div>
        </div>

        <!-- Profile Header -->
        <div style="background: #fff; padding: 2rem; border: 2px solid #000; box-shadow: 4px 4px 0 #6225e6; display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem; flex-wrap: wrap; gap: 2rem; border-radius: 8px;">
          <div>
            <span class="hw-badge" style="margin-bottom: 0.8rem; font-size: 0.75rem; padding: 6px 12px; border-width: 2px; box-shadow: 2px 2px 0 #000; border-radius: 4px;">✦ MIEMBRO ACTIVO</span>
            <h1 style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 800; margin-bottom: 0.3rem; letter-spacing: -0.5px; line-height: 1.1;" id="profile-name">Cargando...</h1>
            <p style="font-size: 1rem; font-weight: 500; color: #555;"><i class="bi bi-person-badge"></i> Cuenta: <span id="profile-cuenta"></span></p>
          </div>
          <div style="text-align: right; background: #fdfdfd; padding: 1.2rem 2rem; border: 2px solid #000; border-radius: 8px;">
            <p style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #6225e6; margin-bottom: 0.2rem;">Puntaje Total</p>
            <p style="font-size: 3.5rem; font-weight: 900; color: #000; line-height: 1;" id="profile-points">0</p>
          </div>
        </div>

        <!-- Actions & History -->
        <div class="member-dashboard-grid">
      
      <!-- Upload Card (dinámica según estado del período) -->
      <div id="upload-card-slot"></div>

      <!-- History List -->
      <div>
        <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 1.5rem; letter-spacing: -0.5px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <i class="bi bi-journal-text" style="color: #6225e6;"></i> Historial de Registros
          </div>
          <div>
            <select id="member-period-selector" style="padding: 0.5rem 1rem; border: 2px solid #000; border-radius: 6px; font-weight: 700; font-family: inherit; font-size: 0.9rem; background: #fff; cursor: pointer; box-shadow: 2px 2px 0 #000; outline: none;">
              <option value="">Cargando...</option>
            </select>
          </div>
        </h2>
        <div id="history-list" style="display: flex; flex-direction: column; gap: 1rem;">
          <!-- Fetched via JS -->
          <p id="history-empty" style="font-weight: 500; font-style: italic; color: #666; display: none;">Aún no has registrado puntos. ¡Sube tu primera evidencia y empieza a rankear!</p>
        </div>
      </div>
      
      
    </div>

    <!-- Global Leaderboard -->
    <div style="margin-top: 4rem;">
      <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 1.5rem; letter-spacing: -0.5px; display: flex; align-items: center; gap: 0.5rem;">
        <i class="bi bi-trophy-fill" style="color: #6225e6;"></i> Ranking General
      </h2>
      <div style="background: #fff; border: 2px solid #000; box-shadow: 4px 4px 0 #000; border-radius: 8px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
          <thead style="background: #f1ecff; border-bottom: 2px solid #000;">
            <tr>
              <th style="padding: 1rem; font-weight: 800; font-size: 0.9rem; text-transform: uppercase; width: 60px; text-align: center;">#</th>
              <th style="padding: 1rem; font-weight: 800; font-size: 0.9rem; text-transform: uppercase;">Participante</th>
              <th style="padding: 1rem; font-weight: 800; font-size: 0.9rem; text-transform: uppercase; text-align: right;">Puntos</th>
            </tr>
          </thead>
          <tbody id="member-leaderboard-tbody">
            <tr>
              <td colspan="3" style="padding: 2rem; text-align: center; color: #666; font-weight: 500;">
                Cargando ranking...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    </div>
    </>
  )}

</MiCuentaLayout>

<script>
  import { supabase } from '@lib/supabase';

  document.addEventListener('DOMContentLoaded', async () => {
    const loadingState = document.getElementById('loading-state');
    const unauthState = document.getElementById('unauthorized-state');
    const dashboardState = document.getElementById('dashboard-state');
    const reLoginBtn = document.getElementById('re-login-btn');

    if (reLoginBtn) {
      reLoginBtn.addEventListener('click', async () => {
        reLoginBtn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Redirigiendo...';
        reLoginBtn.setAttribute('disabled', 'true');
        await supabase.auth.signOut();
        window.location.href = '/mi-cuenta/login';
      });
    }

    const { data: { session } } = await supabase.auth.getSession();
    
    if (!session || !session.user?.email) {
      window.location.replace('/mi-cuenta/login');
      return;
    }

    const email = session.user.email;

    // Check if user is an active member
    const { data: member, error: memberErr } = await supabase
      .from('miembros_activos')
      .select('*')
      .eq('correo', email)
      .maybeSingle();

    if (loadingState) loadingState.style.display = 'none';

    if (memberErr || !member) {
      console.error('No es miembro activo', memberErr);
      if (unauthState) unauthState.style.display = 'block';
      await supabase.auth.signOut();
      return;
    }

    // Is active member! Show dashboard.
    if (dashboardState) dashboardState.style.display = 'block';

    const nameEl = document.getElementById('profile-name');
    const cuentaEl = document.getElementById('profile-cuenta');
    if (nameEl) nameEl.textContent = `Hola, ${member.nombre.split(' ')[0]}`;
    if (cuentaEl) cuentaEl.textContent = member.numero_cuenta || 'N/A';

    const accountModal = document.getElementById('account-modal');
    const accountForm = document.getElementById('account-form') as HTMLFormElement;
    const accountInput = document.getElementById('account-input') as HTMLInputElement;

    if (!member.numero_cuenta || member.numero_cuenta.trim() === '' || member.numero_cuenta === 'N/A') {
      if (accountModal) accountModal.style.display = 'flex';
    }

    if (accountInput) {
      accountInput.addEventListener('input', (e) => {
        let val = accountInput.value;
        val = val.replace(/\D/g, ''); // Remove non-digits
        if (val.length > 9) val = val.slice(0, 9);
        accountInput.value = val;
      });
    }

    if (accountForm) {
      accountForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const num = accountInput.value;
        if (num.length < 8 || num.length > 9) {
          alert('El número de cuenta debe tener 8 o 9 dígitos.');
          return;
        }
        if (confirm(`¿Confirmas que tu número de cuenta es correcto: ${num}?`)) {
          const btn = accountForm.querySelector('button');
          if (btn) {
            btn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Guardando...';
            btn.disabled = true;
          }
          
          const { error } = await supabase
            .from('miembros_activos')
            .update({ numero_cuenta: num })
            .eq('id', member.id);
            
          if (error) {
            alert('Error al guardar el número de cuenta. Intenta de nuevo.');
            if (btn) {
              btn.innerHTML = 'Guardar Número';
              btn.disabled = false;
            }
          } else {
            if (cuentaEl) cuentaEl.textContent = num;
            member.numero_cuenta = num;
            if (accountModal) accountModal.style.display = 'none';
          }
        }
      });
    }

    // Fetch periods (incluye estado de formularios)
    const { data: periodosList } = await supabase.from('periodos').select('id, nombre, es_activo, formularios_cerrados').order('created_at', { ascending: false });

    // Estado del período activo → renderiza tarjeta de subida o mensaje de cierre
    const activePeriod = periodosList?.find(p => p.es_activo);
    updateUploadCard(!!activePeriod?.formularios_cerrados);
    const periodSelector = document.getElementById('member-period-selector') as HTMLSelectElement;
    
    let selectedPeriodId = '';
    
    if (periodosList && periodSelector) {
      periodSelector.innerHTML = periodosList.map(p => 
        `<option value="${p.id}">${p.nombre} ${p.es_activo ? '(Actual)' : ''}</option>`
      ).join('');
      
      const active = periodosList.find(p => p.es_activo) || periodosList[0];
      if (active) selectedPeriodId = active.id;
      periodSelector.value = selectedPeriodId;
      
      periodSelector.addEventListener('change', () => {
        selectedPeriodId = periodSelector.value;
        loadDashboardData();
      });
    }

    function updateUploadCard(cerrado: boolean) {
      const slot = document.getElementById('upload-card-slot');
      if (!slot) return;

      if (cerrado) {
        slot.innerHTML = `
          <div class="upload-card" style="background: #f9f3ff; padding: 1.8rem; border: 2px solid #000; box-shadow: 4px 4px 0 #6225e6; border-radius: 8px;">
            <h2 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 0.8rem; color: #6225e6; text-transform: uppercase; letter-spacing: 0.5px;">
              <i class="bi bi-mortarboard-fill"></i> Semestre cerrado
            </h2>
            <p style="font-weight: 500; font-size: 0.95rem; margin-bottom: 0; color: #333; line-height: 1.6;">
              ¡Hiciste un gran trabajo este semestre! El periodo de registro de evidencias cerró oficialmente. Todo lo que enviaste será entregado a la Jefatura de la Facultad para la asignación de tus horas de formación complementaria.
            </p>
            <p style="font-weight: 700; font-size: 0.95rem; margin-top: 1rem; margin-bottom: 0; color: #6225e6;">
              <i class="bi bi-stars"></i> Gracias por tu esfuerzo y compromiso.
            </p>
          </div>
        `;
      } else {
        slot.innerHTML = `
          <div class="upload-card" style="background: #f1ecff; padding: 1.8rem; border: 2px solid #000; box-shadow: 4px 4px 0 #000; border-radius: 8px;">
            <h2 style="font-size: 1.3rem; font-weight: 800; margin-bottom: 0.8rem;"><i class="bi bi-cloud-arrow-up-fill" style="color: #6225e6;"></i> Registrar Puntos</h2>
            <p style="font-weight: 400; font-size: 0.95rem; margin-bottom: 1.5rem; color: #333; line-height: 1.5;">Sube evidencia de tus eventos, charlas o proyectos para sumar puntos al Leaderboard.</p>
            <a href="/mi-cuenta/registrar" class="hw-btn hw-btn-primary" style="display: block; text-align: center; width: 100%; border-width: 2px; box-shadow: 3px 3px 0 #000 !important; font-size: 0.95rem; padding: 10px 20px; border-radius: 6px;">Subir Evidencia →</a>
          </div>
        `;
      }
    }

    async function loadDashboardData() {
      if (!selectedPeriodId) return;

      const historyList = document.getElementById('history-list');
      const emptyMsg = document.getElementById('history-empty');
      const pointsEl = document.getElementById('profile-points');

      if (pointsEl) pointsEl.innerHTML = '<i class="bi bi-three-dots"></i>';
      if (historyList) historyList.innerHTML = '';
      if (emptyMsg) emptyMsg.style.display = 'none';

      // Fetch history for selected period (incluye anulados para trazabilidad)
      const { data: history, error: histErr } = await supabase
        .from('puntos_registros')
        .select('id, puntos_solicitados, puntos_aprobados, estado_aprobacion, created_at, url_evidencia, horas_reportadas, es_evento_externo, notas_admin, leaderboard_config(accion)')
        .eq('miembro_id', member!.id)
        .eq('periodo_id', selectedPeriodId)
        .order('created_at', { ascending: false });

      let semesterPoints = 0;
      if (!histErr && history) {
        history.forEach(row => {
          if (row.estado_aprobacion === 'approved') {
            semesterPoints += row.puntos_aprobados;
          }
        });
      }

      if (pointsEl) pointsEl.textContent = semesterPoints.toString();

      if (!histErr && history && history.length > 0) {
        if (historyList) {
          // Limpia emails de admin de las notas históricas.
          // Elimina " por email@dominio" dentro de brackets y normaliza
          // "[REVOCADO ...]" (formato viejo) a "[ANULADO ...]".
          const sanitizeNota = (s: string) => s
            .replace(/\s+por\s+[^\s\]]+@[^\s\]]+/gi, '')
            .replace(/\[REVOCADO/gi, '[ANULADO');

          const renderHistoryItem = (row: any) => {
            const isManual = !(row.leaderboard_config as any);
            const manualIsAdd = row.puntos_solicitados >= 0;
            const accion = (row.leaderboard_config as any)?.accion
              || (isManual ? (manualIsAdd ? 'Ajuste manual (suma)' : 'Ajuste manual (resta)') : 'Acción desconocida');

            const fmtPts = (n: number) => `${n > 0 ? '+' : ''}${n} pts`;
            let statusBadge = '';
            let pointsDisplay = `${row.puntos_solicitados} pts solicitados`;

            if (row.estado_aprobacion === 'approved') {
              const val = row.puntos_aprobados ?? 0;
              const isSuma = val >= 0;
              const color = isManual && !isSuma ? '#dc2626' : '#6225e6';
              statusBadge = `<span style="background: rgba(98, 37, 230, 0.15); color: ${color}; padding: 0.2rem 0.6rem; border: 1.5px solid ${color}; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; border-radius: 4px;">${isManual && !isSuma ? 'Ajuste aplicado' : 'Aprobado'}</span>`;
              pointsDisplay = `<span style="color: ${color}; font-weight: 800; font-size: 1.1rem;">${fmtPts(val)}</span>`;
            } else if (row.estado_aprobacion === 'rejected') {
              statusBadge = `<span style="background: rgba(239, 68, 68, 0.1); color: #dc2626; padding: 0.2rem 0.6rem; border: 1.5px solid #dc2626; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; border-radius: 4px;">Rechazado</span>`;
              pointsDisplay = `<span style="text-decoration: line-through; color: #888; font-weight: 500;">${row.puntos_solicitados} pts</span>`;
            } else if (row.estado_aprobacion === 'deleted') {
              statusBadge = `<span style="background: rgba(107, 114, 128, 0.15); color: #4b5563; padding: 0.2rem 0.6rem; border: 1.5px solid #6b7280; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; border-radius: 4px;"><i class="bi bi-arrow-counterclockwise"></i> Anulado</span>`;
              pointsDisplay = `<span style="text-decoration: line-through; color: #888; font-weight: 500;">${fmtPts(row.puntos_solicitados)}</span>`;
            } else {
              statusBadge = `<span style="background: rgba(234, 179, 8, 0.15); color: #ca8a04; padding: 0.2rem 0.6rem; border: 1.5px solid #ca8a04; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; border-radius: 4px;">Pendiente</span>`;
            }

            const date = new Date(row.created_at).toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: 'numeric' });
            
            const isImage = row.url_evidencia && row.url_evidencia.match(/\.(jpeg|jpg|gif|png|webp|heic|heif)(\?.*)?$/i) != null;
            const isPdf = row.url_evidencia && row.url_evidencia.match(/\.(pdf)(\?.*)?$/i) != null;
            let iconOrThumb = '';
            
            if (isImage) {
              iconOrThumb = `<img src="${row.url_evidencia}" alt="Evidencia" style="width: 48px; height: 48px; object-fit: cover; border-radius: 6px; border: 1px solid #ddd; background: #fafafa; flex-shrink: 0; box-shadow: 2px 2px 0 rgba(0,0,0,0.1);">`;
            } else if (isPdf) {
              iconOrThumb = `<div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #fef2f2; color: #ef4444; border-radius: 6px; border: 1px solid #fecaca; font-size: 1.5rem; flex-shrink: 0;"><i class="bi bi-file-earmark-pdf-fill"></i></div>`;
            } else if (row.url_evidencia) {
              iconOrThumb = `<div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #f1ecff; color: #6225e6; border-radius: 6px; border: 1px solid #d9ccfa; font-size: 1.5rem; flex-shrink: 0;"><i class="bi bi-link-45deg"></i></div>`;
            } else {
              iconOrThumb = `<div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #f3f4f6; color: #9ca3af; border-radius: 6px; border: 1px solid #e5e7eb; font-size: 1.5rem; flex-shrink: 0;"><i class="bi bi-question-lg"></i></div>`;
            }

            return `
              <details class="history-card" style="background: #fff; border: 2px solid #e5e5e5; border-radius: 8px; transition: border-color 0.2s; overflow: hidden; cursor: pointer;">
                <summary style="padding: 1.2rem; display: flex; justify-content: space-between; align-items: center; list-style: none; outline: none; user-select: none;">
                  <div style="display: flex; gap: 1rem; align-items: center;">
                    ${iconOrThumb}
                    <div>
                      <p style="font-weight: 700; font-size: 1rem; margin-bottom: 0.4rem;">${accion}</p>
                      <div style="display: flex; gap: 0.8rem; align-items: center;">
                        <small style="color: #666; font-weight: 500;"><i class="bi bi-clock"></i> ${date}</small>
                        ${statusBadge}
                      </div>
                    </div>
                  </div>
                  <div style="display: flex; align-items: center; gap: 1rem;">
                    <div style="text-align: right; background: #fcfcfc; padding: 0.5rem 1rem; border-radius: 6px;">
                      ${pointsDisplay}
                    </div>
                    <i class="bi bi-chevron-down details-icon" style="transition: transform 0.3s; color: #aaa; font-size: 1.2rem;"></i>
                  </div>
                </summary>
                <div style="padding: 0 1.2rem 1.2rem 1.2rem; border-top: 1px dashed #e5e5e5;">
                  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1.2rem; font-size: 0.9rem; color: #444;">
                    ${row.url_evidencia ? `<div><strong><i class="bi bi-link-45deg"></i> Evidencia:</strong> <a href="${row.url_evidencia}" target="_blank" style="color: #6225e6; text-decoration: none; font-weight: 600;">Abrir archivo completo</a></div>` : `<div><strong><i class="bi bi-link-45deg"></i> Evidencia:</strong> N/A</div>`}
                    ${row.horas_reportadas ? `<div><strong><i class="bi bi-stopwatch"></i> Horas Reportadas:</strong> ${row.horas_reportadas}h</div>` : ''}
                    <div><strong><i class="bi bi-building"></i> Evento Externo:</strong> ${row.es_evento_externo ? 'Sí' : 'No'}</div>
                    ${row.notas_admin ? `<div style="grid-column: 1 / -1; background: #fff8e6; padding: 0.8rem 1rem; border-left: 4px solid #eab308; border-radius: 4px; margin-top: 0.5rem;"><strong style="color: #a16207;"><i class="bi bi-chat-left-text"></i> Nota:</strong> <span style="color: #854d0e; white-space: pre-line;">${sanitizeNota(row.notas_admin)}</span></div>` : ''}
                    
                    ${row.estado_aprobacion === 'pending' || row.estado_aprobacion === 'rejected' ? `
                      <div style="grid-column: 1 / -1; margin-top: 1rem; padding-top: 1.5rem; border-top: 2px dashed #eee;">
                        <button type="button" class="hw-btn delete-record-btn" data-id="${row.id}" style="background: #fff; border: 2px solid #000; color: #ef4444; padding: 0.8rem; font-size: 0.9rem; font-weight: 900; text-transform: uppercase; box-shadow: 4px 4px 0 #000; border-radius: 8px; transition: transform 0.1s; cursor: pointer; width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; letter-spacing: 0.5px;">
                          <i class="bi bi-trash-fill"></i> Eliminar Solicitud
                        </button>
                      </div>
                    ` : ''}
                  </div>
                  ${isImage ? `<div style="margin-top: 1.2rem; text-align: center; background: #fafafa; padding: 0.5rem; border-radius: 6px; border: 1px dashed #ccc;"><a href="${row.url_evidencia}" target="_blank"><img src="${row.url_evidencia}" alt="Previsualización de Evidencia" style="max-height: 250px; max-width: 100%; border-radius: 4px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); object-fit: contain;"></a></div>` : ''}
                </div>
              </details>
            `;
          };

          const attachDeleteListeners = () => {
            document.querySelectorAll('.delete-record-btn').forEach(btn => {
              // Clone the button to remove old event listeners
              const newBtn = btn.cloneNode(true) as HTMLButtonElement;
              btn.parentNode?.replaceChild(newBtn, btn);

              newBtn.addEventListener('click', async (e) => {
                e.preventDefault();
                e.stopPropagation();
                const id = newBtn.getAttribute('data-id');
                
                if (confirm('¿Estás seguro de que deseas eliminar esta solicitud? Esta acción no se puede deshacer.')) {
                  newBtn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Eliminando...';
                  newBtn.setAttribute('disabled', 'true');
                  
                  // Extra security: ensure we only delete if it belongs to this member AND is still pending or rejected
                  const { error } = await supabase
                    .from('puntos_registros')
                    .delete()
                    .eq('id', id)
                    .eq('miembro_id', member!.id)
                    .in('estado_aprobacion', ['pending', 'rejected']);
                    
                  if (error) {
                    alert('Ocurrió un error al intentar eliminar la solicitud. Por favor intenta de nuevo.');
                    newBtn.innerHTML = '<i class="bi bi-trash-fill"></i> Eliminar Solicitud';
                    newBtn.removeAttribute('disabled');
                  } else {
                    loadDashboardData(); // Refresh history list and points
                  }
                }
              });
            });
          };

          let visibleCount = 5;
          const updateHistoryView = () => {
            const visibleItems = history.slice(0, visibleCount);
            historyList.innerHTML = visibleItems.map(renderHistoryItem).join('');
            
            const btnContainer = document.createElement('div');
            btnContainer.style.textAlign = 'center';
            btnContainer.style.marginTop = '1rem';
            btnContainer.style.display = 'flex';
            btnContainer.style.gap = '1rem';
            btnContainer.style.justifyContent = 'center';

            let showBtns = false;

            if (history.length > visibleCount) {
              btnContainer.innerHTML += `<button class="hw-btn hw-btn-secondary" id="btn-ver-mas" style="font-size: 0.9rem; padding: 0.6rem 1.2rem;"><i class="bi bi-chevron-down"></i> Ver más</button>`;
              showBtns = true;
            }
            if (visibleCount > 5) {
              btnContainer.innerHTML += `<button class="hw-btn hw-btn-secondary" id="btn-ver-menos" style="font-size: 0.9rem; padding: 0.6rem 1.2rem;"><i class="bi bi-chevron-up"></i> Ver menos</button>`;
              showBtns = true;
            }

            if (showBtns) {
              historyList.appendChild(btnContainer);

              const btnMas = btnContainer.querySelector('#btn-ver-mas');
              if (btnMas) {
                btnMas.addEventListener('click', () => {
                  visibleCount += 5;
                  updateHistoryView();
                });
              }

              const btnMenos = btnContainer.querySelector('#btn-ver-menos');
              if (btnMenos) {
                btnMenos.addEventListener('click', () => {
                  visibleCount = Math.max(5, visibleCount - 5);
                  updateHistoryView();
                });
              }
            }
            attachDeleteListeners();
          };

          updateHistoryView();
        }
      } else {
        if (emptyMsg) {
          emptyMsg.style.display = 'block';
          emptyMsg.textContent = 'No hay registros en este semestre.';
        }
      }

      // --- LEADERBOARD LOGIC ---
      const leaderboardTbody = document.getElementById('member-leaderboard-tbody');
      if (leaderboardTbody) {
        leaderboardTbody.innerHTML = `<tr><td colspan="3" style="padding: 2rem; text-align: center; color: #666; font-weight: 500;">Cargando ranking...</td></tr>`;
        
        const { data: rankingData, error: rankingErr } = await supabase
          .from('ranking_por_periodo')
          .select('miembro_id, nombre, puntos_totales')
          .eq('periodo_id', selectedPeriodId)
          .gt('puntos_totales', 0)
          .order('puntos_totales', { ascending: false });

        if (rankingErr || !rankingData || rankingData.length === 0) {
          leaderboardTbody.innerHTML = `<tr><td colspan="3" style="padding: 2rem; text-align: center; color: #666;">Aún no hay puntos registrados en esta temporada.</td></tr>`;
        } else {
          const formatName = (fullName: string) => {
            if (fullName === 'Jesús Sebastián Vázquez Zarco') return 'Sebastián Vázquez';
            const parts = fullName.trim().split(/\\s+/);
            if (parts.length <= 2) return fullName;
            if (parts.length === 3) return `${parts[0]} ${parts[1]}`; 
            return `${parts[0]} ${parts[2]}`;
          };

          const participants = rankingData.map(m => ({ 
            id: m.miembro_id,
            name: formatName(m.nombre), 
            pts: m.puntos_totales 
          }));

          const groupedByPts = new Map<number, typeof participants>();
          participants.forEach(p => {
            if (!groupedByPts.has(p.pts)) groupedByPts.set(p.pts, []);
            groupedByPts.get(p.pts)!.push(p);
          });

          const uniquePts = Array.from(groupedByPts.keys()).sort((a, b) => b - a);
          let rowsHtml = '';

          for (let i = 0; i < uniquePts.length; i++) {
            const pts = uniquePts[i];
            const group = groupedByPts.get(pts)!;
            const rank = i + 1;

            group.forEach(p => {
              const isCurrentUser = p.id === member!.id;
              const highlightStyle = isCurrentUser ? 'background: #6225e6; color: #fff;' : 'background: #fff; border-bottom: 1px solid #e5e5e5;';
              const textHighlight = isCurrentUser ? 'color: #fff;' : 'color: #000;';
              const nameHighlight = isCurrentUser ? 'font-weight: 900;' : 'font-weight: 600;';
              const badge = isCurrentUser ? ' <span style="background:#c4b5fd; color:#000; font-size:0.7rem; padding: 2px 6px; border-radius: 4px; margin-left: 8px; font-weight:900; border: 1.5px solid #000;">TÚ</span>' : '';
              
              let rankColor = textHighlight;
              if (!isCurrentUser) {
                if (rank === 1) rankColor = 'color: #c8a96e;';
                else if (rank === 2) rankColor = 'color: #6eb5c8;';
                else if (rank === 3) rankColor = 'color: #c86e9a;';
              }

              rowsHtml += `
                <tr style="${highlightStyle} transition: background 0.2s;">
                  <td style="padding: 1rem; text-align: center; font-weight: 900; ${rankColor}">#${rank}</td>
                  <td style="padding: 1rem; ${nameHighlight} ${textHighlight}">${p.name}${badge}</td>
                  <td style="padding: 1rem; text-align: right; font-weight: 800; ${textHighlight}">${p.pts} pts</td>
                </tr>
              `;
            });
          }
          
          leaderboardTbody.innerHTML = rowsHtml;
        }
      }
    }

    loadDashboardData();

    reLoginBtn?.addEventListener('click', () => {
      window.location.href = '/mi-cuenta/login';
    });
  });
</script>
