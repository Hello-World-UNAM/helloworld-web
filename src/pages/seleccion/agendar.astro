---
import Layout from '@layouts/Layout.astro';
---

<Layout
  title="Agendar entrevista | Club Hello World"
  description="Reserva tu entrevista con el Club Hello World."
  activeNav="seleccion"
>

  <section class="sel-page-header agendar-hero">
    <div class="sel-page-header-inner">
      <div class="sel-page-header-left">
        <h1>Agenda tu entrevista.</h1>
        <p id="agendar-hero-sub">Elige el día y la hora que mejor te quede.</p>
      </div>
      <div class="sel-page-header-right">
        <span class="hw-badge sel-badge-open sel-season-badge" style="transform: rotate(-1.5deg);">
          ✦ ENTREVISTA
        </span>
      </div>
    </div>
  </section>

  <section class="seleccion-main">
    <div class="container" style="max-width: 880px;">

      <a href="/seleccion" class="sel-back-link">
        <i class="bi bi-arrow-left"></i> Volver a Selección
      </a>

      <!-- Loading inicial -->
      <div id="agendar-loading" class="sel-aplicar-loading">
        <i class="bi bi-arrow-clockwise admin-redirect-spin"></i>
        <p>Validando tu invitación…</p>
      </div>

      <!-- Estado: token inválido -->
      <div id="state-invalid" class="agendar-state-card" style="display:none;">
        <i class="bi bi-shield-exclamation agendar-state-icon"></i>
        <h2>Invitación no válida</h2>
        <p id="invalid-msg">El enlace que usaste no es válido o ya expiró.</p>
        <p>Si crees que es un error, escríbenos a <a href="mailto:contacto@helloworld-unam.tech">contacto@helloworld-unam.tech</a>.</p>
        <a href="/seleccion" class="hw-btn hw-btn-secondary">Volver al inicio</a>
      </div>

      <!-- Estado: ya tiene entrevista agendada -->
      <div id="state-booked" class="agendar-state-card" style="display:none;">
        <i class="bi bi-check-circle-fill agendar-state-icon agendar-state-icon-success"></i>
        <h2>Tu entrevista está agendada.</h2>
        <p>Te esperamos el <strong id="booked-when">—</strong>.</p>

        <div class="agendar-meet-row">
          <span class="agendar-meet-label">Tu enlace de Meet:</span>
          <a id="booked-meet-link" href="#" target="_blank" rel="noopener noreferrer" class="agendar-meet-link">—</a>
        </div>

        <p class="agendar-reschedule-note" id="reschedule-note">
          Si necesitas cambiar de horario, puedes hacerlo abajo.
        </p>

        <div class="agendar-booked-actions">
          <button type="button" id="btn-reschedule" class="hw-btn hw-btn-secondary">
            Reagendar →
          </button>
        </div>
        <a class="agendar-withdraw-link" href="mailto:contacto@helloworld-unam.tech?subject=Proceso%20de%20selecci%C3%B3n">
          ¿Tuviste algún problema? Escríbenos
        </a>
      </div>

      <!-- Confirmación cuidada antes de liberar una reserva existente -->
      <dialog
        id="reschedule-dialog"
        class="agendar-reschedule-dialog"
        aria-labelledby="reschedule-dialog-title"
        aria-describedby="reschedule-dialog-description"
      >
        <div class="agendar-reschedule-dialog-inner">
          <div class="agendar-reschedule-dialog-heading">
            <span class="agendar-reschedule-dialog-icon" aria-hidden="true">
              <i class="bi bi-calendar2-plus"></i>
            </span>
            <div>
              <span class="agendar-reschedule-dialog-eyebrow">Cambio de horario</span>
              <h2 id="reschedule-dialog-title">¿Buscamos otro momento?</h2>
            </div>
          </div>

          <p id="reschedule-dialog-description" class="agendar-reschedule-dialog-lead">
            Tu entrevista está apartada. Si quieres revisar otras opciones, primero tendremos que liberar tu lugar actual.
          </p>
          <p id="reschedule-dialog-current" class="agendar-reschedule-dialog-current">Tu cita actual: —</p>

          <div class="agendar-reschedule-dialog-points">
            <div class="agendar-reschedule-dialog-point">
              <i class="bi bi-unlock-fill" aria-hidden="true"></i>
              <div>
                <strong>Tu horario actual se libera</strong>
                <span>Dejará de estar reservado en cuanto continúes.</span>
              </div>
            </div>
            <div class="agendar-reschedule-dialog-point">
              <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
              <div>
                <strong>Podrás elegir de nuevo</strong>
                <span>Incluso podrás tomar el horario anterior si sigue disponible.</span>
              </div>
            </div>
          </div>

          <p class="agendar-reschedule-dialog-warning">
            <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
            <span>Este cambio cuenta como uno de tus reagendamientos. Si continúas y después cierras la página sin elegir otra hora, tu cita actual ya no quedará apartada.</span>
          </p>
          <p id="reschedule-dialog-feedback" class="agendar-reschedule-dialog-feedback" role="alert" style="display:none;"></p>

          <div class="agendar-reschedule-dialog-actions">
            <button type="button" id="btn-reschedule-back" class="hw-btn hw-btn-secondary">
              Conservar mi horario
            </button>
            <button type="button" id="btn-reschedule-confirm" class="hw-btn hw-btn-primary">
              <i class="bi bi-calendar2-plus"></i> Liberar y reagendar
            </button>
          </div>
        </div>
      </dialog>

      <!-- Estado: sin slots disponibles -->
      <div id="state-no-slots" class="agendar-state-card" style="display:none;">
        <i class="bi bi-calendar-x agendar-state-icon"></i>
        <h2>Sin horarios disponibles</h2>
        <p>Todos los espacios están ocupados o aún no se han abierto. Escríbenos para resolver esto:</p>
        <a href="mailto:contacto@helloworld-unam.tech" class="hw-btn hw-btn-primary">
          Escribir al equipo
        </a>
      </div>

      <!-- Estado: selector activo -->
      <div id="state-picker" style="display:none;">

        <!-- Banner de bienvenida -->
        <div class="agendar-welcome" id="agendar-welcome">
          <span class="agendar-welcome-eyebrow">✓ Avanzaste a la siguiente fase</span>
          <h2 id="welcome-name">Hola.</h2>
          <p>Elige el día que mejor te quede y luego un horario disponible.</p>
        </div>

        <!-- Selector de día -->
        <div class="section-card agendar-step">
          <h3 class="agendar-step-title">
            <span class="agendar-step-num">1</span>
            ¿Qué día?
          </h3>
          <div id="day-cards" class="agendar-day-cards"></div>
        </div>

        <!-- Selector de hora -->
        <div class="section-card agendar-step" id="hour-section" style="display:none;">
          <h3 class="agendar-step-title">
            <span class="agendar-step-num">2</span>
            ¿A qué hora?
          </h3>
          <p class="agendar-step-sub" id="hour-section-sub">—</p>
          <div id="hour-grid" class="agendar-hour-grid"></div>
        </div>

        <!-- Confirmación -->
        <div class="section-card agendar-step agendar-confirm-card" id="confirm-section" style="display:none;">
          <h3 class="agendar-step-title">
            <span class="agendar-step-num">3</span>
            Confirma
          </h3>
          <div class="agendar-confirm-summary">
            <div class="agendar-confirm-line">
              <i class="bi bi-calendar-event"></i>
              <span id="confirm-when">—</span>
            </div>
            <div class="agendar-confirm-line">
              <i class="bi bi-clock"></i>
              <span id="confirm-duration">—</span>
            </div>
            <div class="agendar-confirm-line">
              <i class="bi bi-camera-video"></i>
              <span>Por Google Meet (recibirás el enlace por correo)</span>
            </div>
          </div>
          <div class="agendar-confirm-actions">
            <button type="button" id="btn-confirm-cancel" class="hw-btn hw-btn-secondary">
              Cambiar
            </button>
            <button type="button" id="btn-confirm" class="hw-btn hw-btn-primary">
              Confirmar entrevista →
            </button>
          </div>
          <div id="confirm-feedback" class="admin-save-feedback" style="display:none;"></div>
        </div>

      </div>

      <!-- Estado: éxito final -->
      <div id="state-success" class="agendar-success-screen" style="display:none;">
        <div class="agendar-success-inner">
          <span class="agendar-success-eyebrow">
            <span class="sel-success-check">✓</span> Listo
          </span>
          <h2>Te esperamos.</h2>
          <p class="agendar-success-when" id="success-when">—</p>
          <p class="agendar-success-msg">
            Te enviamos un correo con tu enlace de Google Meet y los detalles. Si surge algo, escríbenos con al menos 12 h de anticipación.
          </p>
        </div>
      </div>

      <canvas id="confetti-canvas" class="sel-confetti-canvas" aria-hidden="true"></canvas>

    </div>
  </section>

</Layout>

<script>
  import { supabase } from '@lib/supabase';
  import {
    generateSlots, formatSlotTime, formatDayShort, formatDayLong,
    type InterviewDay,
  } from '@lib/interview-slots';

  type State = {
    solicitud: { nombre: string; season: string };
    current_interview: { id: string; slot_datetime: string; duration_minutes: number; meet_url: string | null } | null;
    days: InterviewDay[];
    taken_slots: string[];
    slots?: Array<{ slot_datetime: string; duration_minutes: number; meet_url: string | null }>;
    progressive?: boolean;
    reschedule_count: number;
    max_reschedules: number;
    can_reschedule: boolean;
  };

  type BookingMutationResult = { ok?: boolean; error?: string };

  let token = '';
  let state: State | null = null;
  let chosenSlot: Date | null = null;
  let chosenDay: InterviewDay | null = null;
  let rescheduling = false;

  document.addEventListener('DOMContentLoaded', init);

  async function init() {
    const params = new URLSearchParams(window.location.search);
    token = params.get('t') || '';
    if (!token) {
      showInvalid('Falta el token en la URL.');
      return;
    }
    await loadState();
  }

  async function loadState() {
    const { data, error } = await supabase.rpc('get_booking_state', { p_token: token });

    document.getElementById('agendar-loading')!.style.display = 'none';

    if (error || !data || !(data as any).ok) {
      const err = (data as any)?.error || error?.message;
      if (err === 'NOT_ACCEPTED') {
        showInvalid('Esta invitación ya no está activa.');
      } else {
        showInvalid('Tu invitación no es válida o expiró.');
      }
      return;
    }

    state = normalizeBookingState(data as State);
    document.getElementById('welcome-name')!.textContent = `Hola, ${state.solicitud.nombre.split(' ')[0]}.`;

    if (state.current_interview && !rescheduling) {
      renderBookedState();
    } else if (state.days.length === 0 || allDaysFull()) {
      document.getElementById('state-no-slots')!.style.display = 'block';
    } else {
      document.getElementById('state-picker')!.style.display = 'block';
      renderDayCards();
    }
  }

  function showInvalid(msg: string) {
    document.getElementById('agendar-loading')!.style.display = 'none';
    const el = document.getElementById('state-invalid')!;
    el.style.display = 'block';
    document.getElementById('invalid-msg')!.textContent = msg;
  }

  function allDaysFull(): boolean {
    if (!state) return true;
    if (state.progressive) return (state.slots?.length ?? 0) === 0;
    const takenSet = new Set(state.taken_slots);
    for (const d of state.days) {
      const slots = generateSlots(d);
      for (const s of slots) {
        if (!takenSet.has(s.toISOString())) return false;
      }
    }
    return true;
  }

  function normalizeBookingState(raw: State): State {
    if (!raw.progressive) return raw;

    const slots = Array.isArray(raw.slots) ? raw.slots : [];
    const grouped = new Map<string, typeof slots>();
    for (const slot of slots) {
      const date = mexicoDateKey(slot.slot_datetime);
      const group = grouped.get(date) || [];
      group.push(slot);
      grouped.set(date, group);
    }

    const days = [...grouped.entries()]
      .sort(([left], [right]) => left.localeCompare(right))
      .map(([date, daySlots]) => ({
        id: `progressive-${date}`,
        date,
        start_time: '00:00:00',
        end_time: '23:59:59',
        duration_minutes: daySlots[0]?.duration_minutes ?? 30,
      }));

    return { ...raw, slots, days, taken_slots: [] };
  }

  function mexicoDateKey(value: string | Date): string {
    const date = value instanceof Date ? value : new Date(value);
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Mexico_City', year: 'numeric', month: '2-digit', day: '2-digit',
    }).formatToParts(date);
    const part = (type: Intl.DateTimeFormatPartTypes) => parts.find(item => item.type === type)?.value || '';
    return `${part('year')}-${part('month')}-${part('day')}`;
  }

  function renderBookedState() {
    if (!state?.current_interview) return;
    document.getElementById('state-picker')!.style.display = 'none';
    document.getElementById('state-booked')!.style.display = 'block';
    const ci = state.current_interview;
    const when = new Date(ci.slot_datetime);
    document.getElementById('booked-when')!.textContent = `${formatDayLong(when)} a las ${formatSlotTime(when)} hrs`;
    const meetLink = document.getElementById('booked-meet-link') as HTMLAnchorElement;
    meetLink.href = ci.meet_url || '#';
    meetLink.textContent = ci.meet_url || 'Pendiente — revisa tu correo';

    const rescheduleNote = document.getElementById('reschedule-note')!;
    const rescheduleBtn = document.getElementById('btn-reschedule') as HTMLButtonElement;
    if (!state.can_reschedule) {
      rescheduleBtn.disabled = true;
      rescheduleNote.textContent = `Ya usaste tus ${state.max_reschedules} reagendamientos disponibles. Si surge una urgencia, escríbenos.`;
    } else {
      const left = state.max_reschedules - state.reschedule_count;
      rescheduleNote.textContent = `Si necesitas cambiar de horario, puedes hacerlo abajo (te quedan ${left} cambios).`;
    }

    rescheduleBtn.onclick = openRescheduleDialog;
  }

  function openRescheduleDialog() {
    if (!state?.current_interview || !state.can_reschedule) return;
    const dialog = document.getElementById('reschedule-dialog') as HTMLDialogElement;
    const current = document.getElementById('reschedule-dialog-current')!;
    const feedback = document.getElementById('reschedule-dialog-feedback')!;
    const confirmBtn = document.getElementById('btn-reschedule-confirm') as HTMLButtonElement;
    const backBtn = document.getElementById('btn-reschedule-back') as HTMLButtonElement;
    const left = state.max_reschedules - state.reschedule_count;

    current.textContent = `Tu cita actual: ${formatDayLong(new Date(state.current_interview.slot_datetime))} a las ${formatSlotTime(new Date(state.current_interview.slot_datetime))} hrs.`;
    feedback.style.display = 'none';
    feedback.textContent = '';
    confirmBtn.disabled = false;
    confirmBtn.innerHTML = `<i class="bi bi-calendar2-plus"></i> Liberar y reagendar`;
    backBtn.disabled = false;
    confirmBtn.title = `Te queda${left === 1 ? '' : 'n'} ${left} reagendamiento${left === 1 ? '' : 's'}.`;
    backBtn.onclick = () => dialog.close();
    confirmBtn.onclick = releaseAndStartReschedule;

    if (!dialog.open) {
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
    }
  }

  async function releaseAndStartReschedule() {
    if (!state?.current_interview) return;
    const dialog = document.getElementById('reschedule-dialog') as HTMLDialogElement;
    const feedback = document.getElementById('reschedule-dialog-feedback')!;
    const confirmBtn = document.getElementById('btn-reschedule-confirm') as HTMLButtonElement;
    const backBtn = document.getElementById('btn-reschedule-back') as HTMLButtonElement;

    confirmBtn.disabled = true;
    backBtn.disabled = true;
    confirmBtn.innerHTML = '<i class="bi bi-arrow-clockwise admin-redirect-spin"></i> Liberando tu horario…';
    feedback.style.display = 'none';

    const { data, error } = await supabase.rpc('cancel_interview', { p_token: token });
    const result = data as BookingMutationResult | null;
    if (error || !result?.ok) {
      const code = result?.error || error?.message || 'UNKNOWN';
      const messages: Record<string, string> = {
        INVITATION_REVOKED: 'Esta invitación ya no permite cambios. Actualiza la página o contacta al equipo.',
        NO_ACTIVE_INTERVIEW: 'La reserva cambió antes de confirmar. Actualiza la página para consultar el estado real.',
        MAX_RESCHEDULES: 'Ya utilizaste tus reagendamientos disponibles. Contacta al equipo si necesitas ayuda.',
        INTERVIEW_IN_PAST: 'La entrevista ya comenzó y ya no se puede reagendar desde este enlace.',
      };
      feedback.textContent = messages[code] || 'No pudimos liberar tu horario. Tu cita actual se conserva; actualiza la página e inténtalo de nuevo.';
      feedback.style.display = 'block';
      confirmBtn.disabled = false;
      backBtn.disabled = false;
      confirmBtn.innerHTML = '<i class="bi bi-calendar2-plus"></i> Liberar y reagendar';
      return;
    }

    dialog.close();
    rescheduling = true;
    chosenSlot = null;
    chosenDay = null;
    document.getElementById('state-booked')!.style.display = 'none';
    document.getElementById('state-picker')!.style.display = 'block';
    await loadState();
  }

  function renderDayCards() {
    if (!state) return;
    const container = document.getElementById('day-cards')!;
    const takenSet = new Set(state.taken_slots);

    const cards = state.days.map(d => {
      const slots = state!.progressive
        ? (state!.slots || []).filter(slot => mexicoDateKey(slot.slot_datetime) === d.date).map(slot => new Date(slot.slot_datetime))
        : generateSlots(d);
      const free = slots.filter(s => !takenSet.has(s.toISOString())).length;
      const isFull = free === 0;

      // Si estás reagendando, tu propio slot actual cuenta como ocupado, pero
      // el día sigue siendo seleccionable (libera al cancelar).
      const dateStr = d.date;
      return `
        <button type="button"
          class="agendar-day-card ${isFull ? 'agendar-day-card-full' : ''}"
          data-day-id="${d.id}"
          ${isFull ? 'disabled' : ''}>
          <span class="agendar-day-weekday">${formatDayShort(dateStr).split(' ')[0]}</span>
          <span class="agendar-day-date">${formatDayShort(dateStr).split(' ').slice(1).join(' ')}</span>
          <span class="agendar-day-count">${isFull ? 'Completo' : `${free} ${free === 1 ? 'libre' : 'libres'}`}</span>
        </button>
      `;
    }).join('');
    container.innerHTML = cards;

    container.querySelectorAll<HTMLButtonElement>('.agendar-day-card').forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        container.querySelectorAll('.agendar-day-card').forEach(b => b.classList.remove('agendar-day-card-active'));
        btn.classList.add('agendar-day-card-active');
        const dayId = btn.dataset.dayId!;
        chosenDay = state!.days.find(d => d.id === dayId) || null;
        renderHourGrid();
      });
    });
  }

  function renderHourGrid() {
    if (!state || !chosenDay) return;
    document.getElementById('hour-section')!.style.display = 'block';
    document.getElementById('hour-section-sub')!.textContent = formatDayLong(chosenDay.date);
    const grid = document.getElementById('hour-grid')!;
    const takenSet = new Set(state.taken_slots);
    const slots = state.progressive
      ? (state.slots || [])
          .filter(slot => mexicoDateKey(slot.slot_datetime) === chosenDay!.date)
          .map(slot => new Date(slot.slot_datetime))
      : generateSlots(chosenDay);

    grid.innerHTML = slots.map(s => {
      const taken = takenSet.has(s.toISOString());
      const inPast = s.getTime() < Date.now();
      const disabled = taken || inPast;
      return `
        <button type="button"
          class="agendar-hour-btn ${disabled ? 'agendar-hour-btn-disabled' : ''}"
          data-slot="${s.toISOString()}"
          ${disabled ? 'disabled' : ''}>
          ${formatSlotTime(s)}
        </button>
      `;
    }).join('');

    grid.querySelectorAll<HTMLButtonElement>('.agendar-hour-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        grid.querySelectorAll('.agendar-hour-btn').forEach(b => b.classList.remove('agendar-hour-btn-active'));
        btn.classList.add('agendar-hour-btn-active');
        chosenSlot = new Date(btn.dataset.slot!);
        renderConfirm();
      });
    });

    // Scroll a la sección de hora
    document.getElementById('hour-section')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderConfirm() {
    if (!chosenSlot || !chosenDay) return;
    document.getElementById('confirm-section')!.style.display = 'block';
    document.getElementById('confirm-when')!.textContent =
      `${formatDayLong(chosenSlot)} a las ${formatSlotTime(chosenSlot)} hrs`;
    document.getElementById('confirm-duration')!.textContent = `${chosenDay.duration_minutes} minutos`;

    (document.getElementById('btn-confirm-cancel') as HTMLButtonElement).onclick = () => {
      document.getElementById('confirm-section')!.style.display = 'none';
      chosenSlot = null;
    };
    (document.getElementById('btn-confirm') as HTMLButtonElement).onclick = bookSlot;

    document.getElementById('confirm-section')!.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  async function bookSlot() {
    if (!chosenSlot) return;
    const btn = document.getElementById('btn-confirm') as HTMLButtonElement;
    const fb  = document.getElementById('confirm-feedback') as HTMLElement;
    btn.disabled = true;
    btn.textContent = 'Agendando…';
    fb.style.display = 'none';

    const { data, error } = await supabase.rpc('book_interview', {
      p_token: token,
      p_slot:  chosenSlot.toISOString(),
    });

    const result = data as BookingMutationResult | null;
    if (error || !result?.ok) {
      const code = result?.error || error?.message || 'UNKNOWN';
      const msgs: Record<string, string> = {
        TOKEN_INVALID: 'Tu invitación ya no es válida.',
        NOT_ACCEPTED: 'Esta invitación ya no está activa.',
        SLOT_TAKEN: 'Lo siento, alguien acaba de tomar ese horario. Elige otro.',
        SAME_SLOT: 'Ya tienes ese mismo horario agendado.',
        MAX_RESCHEDULES: `Ya usaste tus reagendamientos disponibles.`,
        SLOT_IN_PAST: 'Ese horario ya pasó.',
        INVALID_SLOT_DAY: 'Ese día no está disponible.',
        SLOT_OUT_OF_RANGE: 'Ese horario está fuera del rango disponible.',
        MISSING_MEET_URL: 'Falta configurar Meet para ese día. Escríbenos al equipo.',
      };
      fb.style.display = 'block';
      fb.className = 'admin-save-feedback admin-save-feedback-error';
      fb.textContent = msgs[code] || `Error: ${code}`;
      btn.disabled = false;
      btn.textContent = 'Confirmar entrevista →';

      // Si fue SLOT_TAKEN, recargar para refrescar slots ocupados
      if (code === 'SLOT_TAKEN') {
        setTimeout(() => { rescheduling = false; loadState(); }, 1500);
      }
      return;
    }

    // Éxito
    showSuccess(chosenSlot);
  }

  function showSuccess(slot: Date) {
    document.getElementById('state-picker')!.style.display = 'none';
    document.getElementById('state-booked')!.style.display = 'none';
    const successEl = document.getElementById('state-success')!;
    successEl.style.display = 'block';
    document.getElementById('success-when')!.textContent =
      `${formatDayLong(slot)} a las ${formatSlotTime(slot)} hrs`;
    window.scrollTo({ top: 0, behavior: 'smooth' });
    setTimeout(() => fireConfetti(), 600);
  }

// ── Confetti (reutilizado) ────────────────────────────────────────────
function fireConfetti() {
  const canvas = document.getElementById('confetti-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;
  const dpr = window.devicePixelRatio || 1;
  canvas.width = window.innerWidth * dpr;
  canvas.height = window.innerHeight * dpr;
  canvas.style.width = window.innerWidth + 'px';
  canvas.style.height = window.innerHeight + 'px';
  ctx.scale(dpr, dpr);
  const W = window.innerWidth, H = window.innerHeight;
  const colors = ['#6225e6', '#c4b5fd', '#a78bfa', '#fbbf24', '#4ade80', '#000', '#fff'];
  type P = { x:number; y:number; vx:number; vy:number; size:number; color:string; rot:number; rotSpeed:number; shape:'rect'|'star'|'circle'; life:number };
  const particles: P[] = [];
  function spawn(fromLeft: boolean, count: number) {
    for (let i = 0; i < count; i++) {
      const speed = 16 + Math.random() * 14;
      const angleDeg = fromLeft ? -50 - Math.random() * 35 : -95 - Math.random() * 35;
      const a = (angleDeg * Math.PI) / 180;
      const r = Math.random();
      particles.push({
        x: fromLeft ? -10 : W + 10, y: H + Math.random() * 30,
        vx: Math.cos(a) * speed, vy: Math.sin(a) * speed,
        size: 7 + Math.random() * 11,
        color: colors[Math.floor(Math.random() * colors.length)],
        rot: Math.random() * Math.PI * 2, rotSpeed: (Math.random() - 0.5) * 0.4,
        shape: r < 0.28 ? 'star' : (r < 0.5 ? 'circle' : 'rect'),
        life: 1,
      });
    }
  }
  spawn(true, 140); spawn(false, 140);
  setTimeout(() => { spawn(true, 70); spawn(false, 70); }, 350);
  const gravity = 0.36, drag = 0.994;
  function drawStar(g: CanvasRenderingContext2D, r: number) {
    g.beginPath();
    for (let i = 0; i < 8; i++) {
      const ang = (i * Math.PI) / 4;
      const rd = i % 2 === 0 ? r : r * 0.42;
      const x = Math.cos(ang) * rd, y = Math.sin(ang) * rd;
      if (i === 0) g.moveTo(x, y); else g.lineTo(x, y);
    }
    g.closePath(); g.fill();
  }
  function tick() {
    ctx!.clearRect(0, 0, W, H);
    let alive = 0;
    particles.forEach(p => {
      if (p.life <= 0) return;
      alive++;
      p.x += p.vx; p.y += p.vy;
      p.vx *= drag; p.vy = p.vy * drag + gravity;
      p.rot += p.rotSpeed; p.life -= 0.0032;
      ctx!.save();
      ctx!.translate(p.x, p.y); ctx!.rotate(p.rot);
      ctx!.globalAlpha = Math.max(0, Math.min(1, p.life * 1.3));
      ctx!.fillStyle = p.color;
      if (p.shape === 'rect') ctx!.fillRect(-p.size/2, -p.size*0.3, p.size, p.size*0.6);
      else if (p.shape === 'star') drawStar(ctx!, p.size);
      else { ctx!.beginPath(); ctx!.arc(0, 0, p.size*0.45, 0, Math.PI*2); ctx!.fill(); }
      ctx!.restore();
    });
    if (alive > 0) requestAnimationFrame(tick);
    else ctx!.clearRect(0, 0, W, H);
  }
  tick();
}
</script>
