---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Ranking | Club Hello World" activeNav="ranking">
  <div class="ranking-section">
    <h1 class="ranking-title">Leaderboard</h1>
    <p class="ranking-subtitle">Nuestros miembros acumulan puntos al completar cursos, certificaciones y eventos. Los más destacados obtienen reconocimientos e incentivos cada semestre.</p>

    <div id="loading-ranking" style="text-align: center; padding: 4rem 0;">
      <i class="bi bi-arrow-clockwise admin-redirect-spin" style="font-size: 2rem;"></i>
      <p style="margin-top: 1rem; color: var(--color-text-muted);">Cargando posiciones...</p>
    </div>

    <!-- Podio -->
    <div class="podium" id="podium" style="display: none;">
      <!-- Inyectado por JS -->
    </div>

    <!-- Tabla -->
    <div id="ranking-list-section" style="display: none;">
      <div id="table-wrap" class="table-collapsed">
        <table class="ranking-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Participante</th>
              <th>Progreso</th>
              <th>Puntos</th>
            </tr>
          </thead>
          <tbody id="ranking-tbody">
            <!-- Inyectado por JS -->
          </tbody>
        </table>
      </div>
      
      <div class="btn-wrap" id="show-more-wrap" style="display: none;">
        <button id="show-more-btn" class="hw-btn hw-btn-secondary">Ver más miembros ▼</button>
      </div>
    </div>
  </div>
</Layout>

<style>
  #table-wrap {
    overflow: hidden;
    transition: max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: max-height;
  }
  .table-collapsed {
    max-height: 250px; 
  }
  .btn-wrap {
    text-align: center;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
</style>

<script>
import { supabase } from '@lib/supabase';

const medalColors = ["#c8a96e", "#6eb5c8", "#c86e9a"];

// Orden visual del podio: 2º — 1º — 3º
const podiumOrder = [1, 0, 2];

async function loadRanking() {
  const loading = document.getElementById('loading-ranking')!;
  const podiumContainer = document.getElementById('podium')!;
  const listSection = document.getElementById('ranking-list-section')!;
  const tbody = document.getElementById('ranking-tbody')!;

  const { data: activePeriod } = await supabase.from('periodos').select('nombre').eq('es_activo', true).maybeSingle();
  const periodName = activePeriod?.nombre || 'Actual';

  const titleEl = document.querySelector('.ranking-title');
  if (titleEl) titleEl.textContent = `Leaderboard`;

  const { data: members, error } = await supabase
    .from('ranking_por_periodo')
    .select('nombre, puntos_totales')
    .eq('es_activo', true)
    .gt('puntos_totales', 0)
    .order('puntos_totales', { ascending: false });

  loading.style.display = 'none';

  if (error || !members || members.length === 0) {
    podiumContainer.style.display = 'flex';
    podiumContainer.innerHTML = '<p style="text-align:center; width:100%; color:var(--color-text-muted); font-weight: 600; font-size: 1.1rem; padding: 2rem 0;">No hay puntos registrados en esta temporada.</p>';
    return;
  }

  // Lógica de agrupación por empates
  function formatLeaderboardName(fullName: string) {
    // Excepción especial a petición
    if (fullName === 'Jesús Sebastián Vázquez Zarco') return 'Sebastián Vázquez';

    const parts = fullName.trim().split(/\s+/);
    if (parts.length <= 2) return fullName;
    if (parts.length === 3) return `${parts[0]} ${parts[1]}`; // Ej: Juan Perez Garcia -> Juan Perez
    return `${parts[0]} ${parts[2]}`; // Resto de casos largos: Primer nombre y Primer apellido
  }

  const participants = members.map(m => ({ 
    name: formatLeaderboardName(m.nombre), 
    pts: m.puntos_totales 
  }));
  const maxPts = participants[0].pts;
  const pct = (pts: number) => Math.round((pts / maxPts) * 100);

  const groupedByPts = new Map<number, typeof participants>();
  participants.forEach(p => {
    if (!groupedByPts.has(p.pts)) groupedByPts.set(p.pts, []);
    groupedByPts.get(p.pts)!.push(p);
  });

  const uniquePts = Array.from(groupedByPts.keys()).sort((a, b) => b - a);

  // Top 3 (Podio)
  const top3Ranks = [0, 1, 2].map(i => {
    const pts = uniquePts[i];
    if (pts === undefined) return null;
    return { rank: i + 1, pts, participants: groupedByPts.get(pts)! };
  });

  podiumContainer.style.display = 'flex';
  podiumContainer.innerHTML = podiumOrder.map(i => {
    const group = top3Ranks[i];
    if (!group) return '';
    const color = medalColors[i];
    return `
      <div class="podium-card rank-${group.rank}">
        <div class="podium-medal">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" fill="${color}" opacity="0.2"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
          </svg>
        </div>
        <div class="podium-pos">#${group.rank}</div>
        <div class="podium-name">${group.participants.map(p => p.name).join(' & ')}</div>
        <div class="podium-pts">${group.pts} <span>pts</span></div>
        <div class="pts-bar-wrap">
          <div class="pts-bar" style="width: 0%; background-color: #22c55e;" data-pct="${pct(group.pts)}"></div>
        </div>
      </div>
    `;
  }).join('');

  // Resto de la tabla (Lugares 4 en adelante)
  const restRanks = [];
  for (let i = 3; i < uniquePts.length; i++) {
    const pts = uniquePts[i];
    groupedByPts.get(pts)!.forEach(p => restRanks.push({ rank: i + 1, ...p }));
  }

  if (restRanks.length > 0) {
    listSection.style.display = 'block';
    tbody.innerHTML = restRanks.map((p, i) => `
      <tr class="${i >= 2 ? "extra-row" : ""}">
        <td class="rank-num">#${p.rank}</td>
        <td class="player-name">${p.name}</td>
        <td class="bar-cell">
          <div class="table-bar-wrap">
            <div class="table-bar" style="width: 0%; background-color: #22c55e;" data-pct="${pct(p.pts)}"></div>
          </div>
        </td>
        <td class="pts-value">${p.pts} pts</td>
      </tr>
    `).join('');

    if (restRanks.length > 2) {
      document.getElementById('show-more-wrap')!.style.display = 'block';
      setupShowMore();
    }
  }

  // Animar barras
  setTimeout(() => {
    document.querySelectorAll('.pts-bar, .table-bar').forEach(bar => {
      const hBar = bar as HTMLElement;
      hBar.style.width = hBar.dataset.pct + '%';
    });
  }, 100);
}

function setupShowMore() {
  const showMoreBtn = document.getElementById('show-more-btn');
  const tableWrap = document.getElementById('table-wrap');
  const table = document.querySelector('.ranking-table') as HTMLElement;
  const tbody = document.querySelector('#ranking-tbody');
  
  if (showMoreBtn && tableWrap && tbody && tbody.children.length > 2) {
    const theadHeight = table.querySelector('thead')!.offsetHeight;
    const row1Height = (tbody.children[0] as HTMLElement).offsetHeight;
    const row2Height = (tbody.children[1] as HTMLElement).offsetHeight;
    
    const exactCollapsedHeight = theadHeight + row1Height + row2Height + 2;
    tableWrap.style.maxHeight = `${exactCollapsedHeight}px`;
    
    showMoreBtn.addEventListener('click', () => {
      const isCollapsed = tableWrap.classList.contains('table-collapsed');
      if (isCollapsed) {
        tableWrap.style.maxHeight = `${table.offsetHeight}px`;
        tableWrap.classList.remove('table-collapsed');
        showMoreBtn.textContent = 'Ocultar miembros ▲';
      } else {
        tableWrap.style.maxHeight = `${exactCollapsedHeight}px`;
        tableWrap.classList.add('table-collapsed');
        showMoreBtn.textContent = 'Ver más miembros ▼';
      }
    });

    window.addEventListener('resize', () => {
      if (!tableWrap.classList.contains('table-collapsed')) {
        tableWrap.style.maxHeight = `${table.offsetHeight}px`;
      }
    });
  }
}

document.addEventListener('DOMContentLoaded', loadRanking);
