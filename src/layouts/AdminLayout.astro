---
import '@/styles/global.css';
import { getSafeSupabaseServerClient } from '../lib/supabaseServer';
import SelectionLabBanner from '@components/SelectionLabBanner.astro';
import { isSelectionLab } from '@lib/selection-lab';

interface Props {
  title: string;
  description?: string;
  showHeader?: boolean;
  activeNav?: string;
}

const {
  title,
  description = 'Panel interno del Club Hello World',
  showHeader = true,
  activeNav = '',
} = Astro.props;

// --- SERVER-SIDE SECURITY GUARD ---
// La validación de permisos se realiza de forma centralizada y segura
// en `src/middleware.ts`. Esto previene el error 'ResponseSentError' en SSR.
let userEmail = Astro.locals.userEmail || '';

if (!userEmail) {
  const safeSupabase = getSafeSupabaseServerClient(Astro.cookies);
  const { data: { session } } = await safeSupabase.auth.getSession();
  userEmail = session?.user?.email || '';
}

const NAV_ITEMS = [
  { id: 'inicio',      href: '/admin',                  icon: 'bi-grid-fill',          label: 'Inicio' },
  { id: 'leaderboard', href: '/admin/leaderboard',      icon: 'bi-award-fill',         label: 'Puntos' },
  { id: 'periodos',    href: '/admin/periodos',         icon: 'bi-calendar-range',     label: 'Periodos' },
  { id: 'miembros',    href: '/admin/miembros',         icon: 'bi-people-fill',        label: 'Miembros' },
  { id: 'solicitudes', href: '/admin/solicitudes?view=1', icon: 'bi-person-lines-fill', label: 'Solicitudes' },
  { id: 'entrevistas', href: '/admin/entrevistas',      icon: 'bi-calendar-week',      label: 'Entrevistas' },
  { id: 'config',      href: '/admin/seleccion-config', icon: 'bi-gear-fill',          label: 'Temporada' },
  ...(isSelectionLab
    ? [{ id: 'lab-inbox', href: '/admin/selection-lab', icon: 'bi-inbox-fill', label: 'Buzón de pruebas' }]
    : []),
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#6225e6">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <title>{title}</title>
</head>
<body class="admin-body" id="admin-body">
  <SelectionLabBanner />
  {showHeader && (
    <div class="admin-top">
      <header class="admin-header">
        <div class="admin-header-inner">
          <a href="/admin" class="admin-brand">
            <span class="admin-brand-logobox">
              <img src="/img/logo.png" alt="Club Hello World">
            </span>
            <span class="admin-brand-text">
              <strong>Mesa Directiva</strong>
              <small>Club Hello World</small>
            </span>
          </a>
          <div class="admin-header-right">
            <span id="admin-user-email" class="admin-user-email">
              <i class="bi bi-person-fill"></i> {userEmail}
            </span>
            <button id="admin-logout-btn" class="admin-logout-btn" type="button" aria-label="Cerrar sesión">
              <i class="bi bi-box-arrow-right"></i><span class="admin-logout-label">Salir</span>
            </button>
          </div>
        </div>
      </header>
      <nav class="admin-nav" aria-label="Módulos del panel">
        <div class="admin-nav-inner">
          {NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              class:list={['admin-nav-link', { 'admin-nav-link-active': activeNav === item.id }]}
              aria-current={activeNav === item.id ? 'page' : undefined}
            >
              <i class={`bi ${item.icon}`}></i> {item.label}
            </a>
          ))}
        </div>
      </nav>
    </div>
  )}

  <main class="admin-main" aria-label="Panel de administración">
    <slot />
  </main>

  {showHeader && (
    <script>
      import { supabase } from '@lib/supabase';

      document.addEventListener('DOMContentLoaded', () => {
        const logoutBtn = document.getElementById('admin-logout-btn') as HTMLButtonElement | null;
        logoutBtn?.addEventListener('click', async () => {
          logoutBtn.disabled = true;
          await supabase.auth.signOut();
          window.location.href = '/admin/login';
        });

        // Centra el link activo del nav en pantallas angostas
        const activeLink = document.querySelector<HTMLElement>('.admin-nav-link-active');
        activeLink?.scrollIntoView({ block: 'nearest', inline: 'center' });
      });
    </script>
  )}
</body>
</html>
