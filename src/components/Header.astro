---
interface Props {
  activeNav?: string;
}

const { activeNav = "" } = Astro.props;

// Orden por defecto = "selecciones cerradas" (Selección al final).
// JS reordena al inicio si el estado real es "abierto" (vía caché o fetch).
const navItems = [
  { href: "/", label: "Inicio", key: "inicio" },
  { href: "/nuestro-club", label: "Sobre nosotros", key: "nuestro-club" },
  { href: "/ranking", label: "Leaderboard", key: "ranking" },
  { href: "/contacto", label: "Contacto", key: "contacto" },
  { href: "/seleccion", label: "Selección", key: "seleccion" },
];
---

<header>
  <div class="content">
    <div class="menu container">
      <a href="/" class="logo">
        <img src="/img/favicon.png" alt="Logo Club Hello World" width="28" height="28">
        Hello <span>World</span>
      </a>
      <input type="checkbox" id="menu" hidden />
      <label for="menu" class="hamburger" aria-label="Abrir menú de navegación" hidden>
        <svg viewBox="0 0 32 32" width="45" height="45">
          <path class="line line-top-bottom" d="M27 10 13 10C10.8 10 9 8.2 9 6 9 3.5 10.8 2 13 2 15.2 2 17 3.8 17 6L17 26C17 28.2 18.8 30 21 30 23.2 30 25 28.2 25 26 25 23.8 23.2 22 21 22L7 22"></path>
          <path class="line" d="M7 16 27 16"></path>
        </svg>
      </label>
      <nav class="navbar" aria-label="Menú principal">
        <!--
          Script inline síncrono: lee caché localStorage ANTES del paint.
          Si última visita = abierto → reordena Selección a posición 2 + muestra dot.
          Esto evita parpadeo en visitas repetidas (el caso más común).
        -->
        <script is:inline>
          (function () {
            try {
              if (localStorage.getItem('hw-sel-open') !== 'true') return;
              // Marker que el async script lee para saber que ya hicimos reorder optimista
              document.documentElement.dataset.hwSelOpenCached = '1';
            } catch (_) {}
          })();
        </script>
        <ul id="nav-list">
          {navItems.map((item) => (
            <li data-nav-key={item.key}>
              <a
                href={item.href}
                class={activeNav === item.key ? "nav-active" : ""}
              >
                {item.label}
                {item.key === "seleccion" && (
                  <span class="nav-seleccion-dot" aria-label="Convocatoria abierta" style="display:none;"></span>
                )}
              </a>
            </li>
          ))}
        </ul>
        <!-- Aplicar reorder optimista ANTES del paint si cache dice abierto -->
        <script is:inline>
          (function () {
            if (document.documentElement.dataset.hwSelOpenCached !== '1') return;
            var list = document.getElementById('nav-list');
            if (!list) return;
            var seleccionLi = list.querySelector('li[data-nav-key="seleccion"]');
            var inicioLi    = list.querySelector('li[data-nav-key="inicio"]');
            if (!seleccionLi || !inicioLi) return;
            inicioLi.insertAdjacentElement('afterend', seleccionLi);
            var dot = seleccionLi.querySelector('.nav-seleccion-dot');
            if (dot) dot.style.display = '';
          })();
        </script>
      </nav>
    </div>
  </div>
</header>

<script>
  // Async: confirma estado real con Supabase y actualiza caché + DOM si difiere.
  import { supabase } from '@lib/supabase';

  (async () => {
    const { data } = await supabase
      .from('seleccion_config')
      .select('is_open, applications_closed')
      .eq('id', true)
      .maybeSingle();

    const isOpen = !!data?.is_open;
    const interviewing = isOpen && !!data?.applications_closed;

    // Update cache
    try {
      localStorage.setItem('hw-sel-open', isOpen ? 'true' : 'false');
    } catch {}

    const list = document.getElementById('nav-list');
    if (!list) return;
    const seleccionLi = list.querySelector<HTMLLIElement>('li[data-nav-key="seleccion"]');
    const inicioLi    = list.querySelector<HTMLLIElement>('li[data-nav-key="inicio"]');
    if (!seleccionLi || !inicioLi) return;
    const dot = seleccionLi.querySelector<HTMLElement>('.nav-seleccion-dot');

    // Determinar posición actual real
    const currentlySecond = inicioLi.nextElementSibling === seleccionLi;

    if (isOpen) {
      if (!currentlySecond) {
        inicioLi.insertAdjacentElement('afterend', seleccionLi);
      }
      if (dot) {
        dot.style.display = '';
        dot.classList.toggle('nav-seleccion-dot-interviewing', interviewing);
      }
    } else {
      if (currentlySecond) {
        list.appendChild(seleccionLi);
      }
      if (dot) dot.style.display = 'none';
    }
  })();
</script>
